<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>../../../src/MiaDock.App/app.manifest</ApplicationManifest>
    <AnimationSourceRoot Condition="'$(AnimationSourceRoot)' == ''">../../../src/MiaDock.App/Animations</AnimationSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" />
    <ProjectReference Include="../../../src/MiaDock.Core/MiaDock.Core.csproj" />
    <ProjectReference Include="../../../src/MiaDock.UI/MiaDock.UI.csproj" />
    <ProjectReference Include="../../../src/MiaDock.Platform.Windows/MiaDock.Platform.Windows.csproj" />
    <Compile Include="$(AnimationSourceRoot)/IslandAnimationCoordinator.cs;$(AnimationSourceRoot)/IslandBoundsAnimator.cs;$(AnimationSourceRoot)/ToolkitAnimationFactory.cs;$(AnimationSourceRoot)/IslandAnimationProfile.cs;$(AnimationSourceRoot)/IslandVisualMetrics.cs;$(AnimationSourceRoot)/BoundsEasingProfile.cs;$(AnimationSourceRoot)/MotionSemantics.cs;$(AnimationSourceRoot)/IIslandAnimationCoordinator.cs" Link="Animations/%(Filename)%(Extension)" />
    <Compile Include="../../../src/MiaDock.App/Animations/AnimationPerformanceMonitor.cs" Link="Animations/AnimationPerformanceMonitor.cs" />
    <Compile Include="../../../src/MiaDock.App/Services/IAnimationPreferenceService.cs" Link="Services/IAnimationPreferenceService.cs" />
  </ItemGroup>
</Project>
