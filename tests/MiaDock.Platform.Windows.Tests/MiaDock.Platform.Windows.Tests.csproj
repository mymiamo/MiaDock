<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MiaDock.Core\MiaDock.Core.csproj" />
    <ProjectReference Include="..\..\src\MiaDock.Modules.Media\MiaDock.Modules.Media.csproj" />
    <ProjectReference Include="..\..\src\MiaDock.Modules.DeviceStatus\MiaDock.Modules.DeviceStatus.csproj" />
    <ProjectReference Include="..\..\src\MiaDock.Modules.Transfers\MiaDock.Modules.Transfers.csproj" />
    <ProjectReference Include="..\..\src\MiaDock.Platform.Windows\MiaDock.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\MiaDock.App\Services\ISettingsService.cs"
             Link="App\ISettingsService.cs" />
    <Compile Include="..\..\src\MiaDock.App\Services\SettingsChangedEventArgs.cs"
             Link="App\SettingsChangedEventArgs.cs" />
    <Compile Include="..\..\src\MiaDock.App\Services\StartupTaskCoordinator.cs"
             Link="App\StartupTaskCoordinator.cs" />
    <Compile Include="..\..\src\MiaDock.App\Services\FocusAutomationService.cs"
             Link="App\FocusAutomationService.cs" />
    <Compile Include="..\..\src\MiaDock.App\Modules\UsbDeviceModule.cs"
             Link="App\UsbDeviceModule.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\MiaDock.Platform.Windows\Tray\WindowsTrayIconService.cs"
             Link="Tray\WindowsTrayIconService.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\MiaDock.Platform.Windows\Tray\FluentTrayIconResolver.cs"
             Link="Tray\FluentTrayIconResolver.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\MiaDock.Platform.Windows\Applications\WindowsFocusSettingsLauncher.cs"
             Link="Applications\WindowsFocusSettingsLauncher.cs"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
