<UserControl
    x:Class="MiaDock.App.Controls.MusicCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiaDock.App.Controls"
    xmlns:animations="using:MiaDock.App.Animations"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <Grid x:Name="LayoutRoot"
        Style="{StaticResource DockCompactModuleLayoutStyle}"
        Padding="10,0"
        ColumnSpacing="8"
        FlowDirection="LeftToRight"
        AutomationProperties.Name="{Binding Current.Track.Title}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="32" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="22" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="ArtworkHost"
          Width="30"
          Height="30"
          VerticalAlignment="Center">
      <local:AlbumArtwork x:Name="CompactArtwork"
                          ArtworkCornerRadius="7" />
      <Grid x:Name="ArtworkStateOverlay"
            Visibility="Collapsed"
            animations:MicroMotion.StateKey="{Binding PlaybackGlyph}">
        <Border Background="{ThemeResource MediaArtworkScrimBrush}"
                CornerRadius="7" />
        <FontIcon x:Name="PausedGlyph"
                  Glyph="&#xE769;"
                  FontSize="16"
                  Foreground="{ThemeResource IslandTextPrimaryBrush}"
                  Visibility="Collapsed"
                  AutomationProperties.AccessibilityView="Raw" />
        <FontIcon x:Name="TrackChangeGlyph"
                  Glyph="&#xE893;"
                  FontSize="16"
                  Foreground="{ThemeResource IslandTextPrimaryBrush}"
                  Visibility="Collapsed"
                  AutomationProperties.AccessibilityView="Raw" />
      </Grid>
    </Grid>

    <TextBlock x:Name="TrackTitleText"
               Grid.Column="1"
               VerticalAlignment="Center"
               MaxLines="1"
               TextTrimming="CharacterEllipsis"
               Style="{StaticResource DockBodyTextStyle}"
               FontSize="12"
               Text="{Binding Current.Track.Title}"
               ToolTipService.ToolTip="{Binding Current.Track.Title}"
               animations:MicroMotion.StateKey="{Binding Current.Track.Title}" />

    <Grid x:Name="TrailingStateHost"
          Grid.Column="2"
          Width="22"
          Height="18"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <local:AudioActivityIndicator x:Name="MusicActivity"
                                    Width="10"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource IslandStyleAccentBrush}"
                                    TrebleLevel="{Binding TrebleAudioLevel}"
                                    BassLevel="{Binding BassAudioLevel}"
                                    VocalLevel="{Binding VocalAudioLevel}"
                                    AudioLevelSource="{Binding AudioLevelSource}"
                                    AmplitudeLevel="{Binding AudioAmplitude}"
                                    IsPlaying="{Binding IsPlaying}"
                                    IsAudioAvailable="{Binding IsAudioLevelAvailable}" />
      <FontIcon x:Name="TrailingMoreGlyph"
                Glyph="&#xE712;"
                FontSize="16"
                Foreground="{ThemeResource IslandTextPrimaryBrush}"
                Visibility="Collapsed"
                AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </Grid>
</UserControl>
