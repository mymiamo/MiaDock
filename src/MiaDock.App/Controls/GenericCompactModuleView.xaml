<UserControl
    x:Class="MiaDock.App.Controls.GenericCompactModuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DataContextChanged="OnDataContextChanged">
  <Grid>
    <Grid x:Name="ContentRow"
          Style="{StaticResource DockCompactModuleLayoutStyle}"
          Visibility="Collapsed"
          AutomationProperties.Name="{Binding PrimaryText}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon Glyph="{Binding LeadingGlyph}"
                Style="{StaticResource DockModuleIconStyle}"
                AutomationProperties.AccessibilityView="Raw" />
      <TextBlock Grid.Column="1"
                 Text="{Binding PrimaryText}"
                 VerticalAlignment="Center"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockBodyTextStyle}"
                 ToolTipService.ToolTip="{Binding PrimaryText}" />
      <TextBlock Grid.Column="2"
                 MaxWidth="86"
                 Text="{Binding ValueText}"
                 VerticalAlignment="Center"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockStatusTextStyle}"
                 ToolTipService.ToolTip="{Binding ValueText}" />
    </Grid>

    <Grid x:Name="EmptyState"
          Style="{StaticResource DockCompactModuleLayoutStyle}"
          AutomationProperties.Name="Etkin olay yok">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE946;"
                Style="{StaticResource DockModuleIconStyle}"
                AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="EmptyStateText"
                 Grid.Column="1"
                 Text="Etkin olay yok"
                 VerticalAlignment="Center"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockBodyTextStyle}" />
    </Grid>
  </Grid>
</UserControl>
