<UserControl x:Class="MiaDock.App.Controls.BatteryThresholdSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="10">
    <TextBlock Text="Pil uyarıları" Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
    <TextBlock Text="Düşük, kritik ve acil pil bildirimlerinin gösterileceği yüzdeleri belirleyin."
               Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
    <Grid ColumnSpacing="12" RowSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="CriticalColumn" Width="0" /><ColumnDefinition x:Name="EmergencyColumn" Width="0" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="NarrowThresholds" />
          <VisualState x:Name="WideThresholds">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="640" /></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="CriticalColumn.Width" Value="*" />
              <Setter Target="EmergencyColumn.Width" Value="*" />
              <Setter Target="CriticalThreshold.(Grid.Row)" Value="0" />
              <Setter Target="CriticalThreshold.(Grid.Column)" Value="1" />
              <Setter Target="EmergencyThreshold.(Grid.Row)" Value="0" />
              <Setter Target="EmergencyThreshold.(Grid.Column)" Value="2" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <StackPanel Spacing="4"><TextBlock Text="Düşük" /><NumberBox Minimum="3" Maximum="50" Value="{Binding BatteryLowThreshold, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Düşük pil eşiği" /></StackPanel>
      <StackPanel x:Name="CriticalThreshold" Grid.Row="1" Spacing="4"><TextBlock Text="Kritik" /><NumberBox Minimum="2" Maximum="35" Value="{Binding BatteryCriticalThreshold, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Kritik pil eşiği" /></StackPanel>
      <StackPanel x:Name="EmergencyThreshold" Grid.Row="2" Spacing="4"><TextBlock Text="Acil" /><NumberBox Minimum="1" Maximum="20" Value="{Binding BatteryEmergencyThreshold, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Acil pil eşiği" /></StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
