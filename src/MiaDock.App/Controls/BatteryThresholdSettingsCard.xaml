<UserControl x:Class="MiaDock.App.Controls.BatteryThresholdSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="10">
    <TextBlock Text="Pil uyarıları" Style="{ThemeResource SubtitleTextBlockStyle}" />
    <TextBlock Text="Düşük, kritik ve acil pil bildirimlerinin gösterileceği yüzdeleri belirleyin."
               TextWrapping="Wrap" Opacity="0.68" />
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="4"><TextBlock Text="Düşük" /><NumberBox Minimum="3" Maximum="50" Value="{Binding BatteryLowThreshold, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Düşük pil eşiği" /></StackPanel>
      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Kritik" /><NumberBox Minimum="2" Maximum="35" Value="{Binding BatteryCriticalThreshold, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Kritik pil eşiği" /></StackPanel>
      <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Acil" /><NumberBox Minimum="1" Maximum="20" Value="{Binding BatteryEmergencyThreshold, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Acil pil eşiği" /></StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
