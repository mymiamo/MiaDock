<UserControl x:Class="MiaDock.App.Controls.ClipboardPeekExpandedView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:MiaDock.App.Animations"
             xmlns:controls="using:MiaDock.App.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <Style x:Key="ClipboardFormatButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DockInlineButtonStyle}">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,5,8,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Resources>

  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding TitleText}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ClipboardLayoutStates">
        <VisualState x:Name="NarrowClipboardLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="HeroPreviewColumn.Width" Value="*" />
            <Setter Target="HeroDetailsColumn.Width" Value="0" />
            <Setter Target="HeroDetails.(Grid.Column)" Value="0" />
            <Setter Target="HeroDetails.(Grid.Row)" Value="1" />
            <Setter Target="HeroDetails.Margin" Value="0,12,0,0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="WideClipboardLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="520" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="HeroPreviewColumn.Width" Value="168" />
            <Setter Target="HeroDetailsColumn.Width" Value="*" />
            <Setter Target="HeroDetails.(Grid.Column)" Value="1" />
            <Setter Target="HeroDetails.(Grid.Row)" Value="0" />
            <Setter Target="HeroDetails.Margin" Value="14,0,0,0" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Padding="0,4,0,4">
        <StackPanel Spacing="7">
          <TextBlock Text="{Binding CurrentClipboardText}"
                     Style="{StaticResource DockModuleHeaderTextStyle}" />

          <Border x:Name="HeroSurface"
                  Style="{StaticResource DockSectionStyle}"
                  Padding="14"
                  animations:MicroMotion.StateKey="{Binding PresentationVisualKey}"
                  AutomationProperties.Name="{Binding SafeCurrentAutomationText}">
            <Grid RowSpacing="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid x:Name="HeroContent"
                    Visibility="{Binding HasCurrentItem, Converter={StaticResource BooleanToVisibility}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="HeroPreviewColumn" Width="168" />
                  <ColumnDefinition x:Name="HeroDetailsColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="HeroPreview"
                        MinHeight="132"
                        MaxHeight="188"
                        CornerRadius="12"
                        Background="{ThemeResource DockStatusNeutralFillBrush}"
                        BorderBrush="{ThemeResource DockSurfaceStrokeBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasPrimaryVisualPreview, Converter={StaticResource BooleanToVisibility}}"
                        animations:MicroMotion.StateKey="{Binding PrimaryPreviewVisualKey}"
                        AutomationProperties.AccessibilityView="Raw">
                  <Grid>
                    <Border Background="{Binding ColorPreviewBrush}"
                            Visibility="{Binding HasColorPreview, Converter={StaticResource BooleanToVisibility}}" />
                    <Image Source="{Binding Thumbnail}"
                           MaxHeight="188"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibility}}" />
                  </Grid>
                </Border>

                <StackPanel x:Name="HeroDetails"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="9">
                  <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42"
                            CornerRadius="11"
                            Background="{ThemeResource DockStatusNeutralFillBrush}">
                      <FontIcon Glyph="{Binding CurrentTypeGlyph}"
                                Style="{StaticResource DockModuleIconStyle}"
                                AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <Border Grid.Column="1"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DockStatusBadgeStyle}">
                      <TextBlock Text="{Binding CurrentTypeText}"
                                 Style="{StaticResource DockStatusTextStyle}" />
                    </Border>
                  </Grid>

                  <TextBlock Text="{Binding CurrentDisplayText}"
                             MaxLines="6"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             ToolTipService.ToolTip="{Binding CurrentSafeToolTipText}"
                             Style="{StaticResource DockBodyTextStyle}" />
                  <TextBlock Text="{Binding TextStatsText}"
                             TextWrapping="Wrap"
                             Style="{StaticResource DockCaptionTextStyle}"
                             Visibility="{Binding HasTextStats, Converter={StaticResource BooleanToVisibility}}" />
                  <TextBlock Text="{Binding SensitiveDescriptionText}"
                             TextWrapping="Wrap"
                             Style="{StaticResource DockCaptionTextStyle}"
                             Visibility="{Binding IsSensitiveHidden, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
              </Grid>

              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="7"
                          Padding="12,18"
                          Visibility="{Binding HasCurrentItem, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}"
                          AutomationProperties.Name="{Binding EmptyText}">
                <Border Width="48" Height="48"
                        CornerRadius="14"
                        Background="{ThemeResource DockStatusNeutralFillBrush}">
                  <FontIcon Glyph="&#xE8C8;"
                            FontSize="20"
                            Foreground="{ThemeResource IslandStyleAccentBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <TextBlock Text="{Binding EmptyText}"
                           MaxWidth="330"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource DockBodyTextStyle}" />
              </StackPanel>

              <StackPanel Grid.Row="1"
                          Spacing="6"
                          Visibility="{Binding HasColorFormats, Converter={StaticResource BooleanToVisibility}}">
                <Button Command="{Binding CopyColorFormatCommand}"
                        CommandParameter="Hex"
                        Style="{StaticResource ClipboardFormatButtonStyle}"
                        animations:MicroMotion.IsInteractive="True"
                        AutomationProperties.Name="{Binding ColorHexText}">
                  <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ColorHexLabel}" Style="{StaticResource DockStatusTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding ColorHexValue}"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource DockBodyTextStyle}" />
                    <FontIcon Grid.Column="2" Glyph="&#xE8C8;" FontSize="14"
                              AutomationProperties.AccessibilityView="Raw" />
                  </Grid>
                </Button>
                <Button Command="{Binding CopyColorFormatCommand}"
                        CommandParameter="Rgb"
                        Style="{StaticResource ClipboardFormatButtonStyle}"
                        animations:MicroMotion.IsInteractive="True"
                        AutomationProperties.Name="{Binding ColorRgbText}">
                  <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ColorRgbLabel}" Style="{StaticResource DockStatusTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding ColorRgbValue}"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource DockBodyTextStyle}" />
                    <FontIcon Grid.Column="2" Glyph="&#xE8C8;" FontSize="14"
                              AutomationProperties.AccessibilityView="Raw" />
                  </Grid>
                </Button>
                <Button Command="{Binding CopyColorFormatCommand}"
                        CommandParameter="Hsl"
                        Style="{StaticResource ClipboardFormatButtonStyle}"
                        animations:MicroMotion.IsInteractive="True"
                        AutomationProperties.Name="{Binding ColorHslText}">
                  <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ColorHslLabel}" Style="{StaticResource DockStatusTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding ColorHslValue}"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource DockBodyTextStyle}" />
                    <FontIcon Grid.Column="2" Glyph="&#xE8C8;" FontSize="14"
                              AutomationProperties.AccessibilityView="Raw" />
                  </Grid>
                </Button>
              </StackPanel>

              <StackPanel Grid.Row="2" Spacing="8">
                <CommandBar Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            HorizontalAlignment="Stretch"
                            Visibility="{Binding HasCurrentItem, Converter={StaticResource BooleanToVisibility}}"
                            animations:MicroMotion.StateKey="{Binding SuccessFeedbackVersion}"
                            AutomationProperties.Name="{Binding CurrentTypeText}">
                  <AppBarButton Label="{Binding OpenText}"
                                Command="{Binding OpenCommand}"
                                MinHeight="44"
                                Visibility="{Binding CanOpen, Converter={StaticResource BooleanToVisibility}}"
                                animations:MicroMotion.IsInteractive="True"
                                AutomationProperties.Name="{Binding OpenText}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8A7;" /></AppBarButton.Icon>
                  </AppBarButton>
                  <AppBarButton Label="{Binding OpenFolderText}"
                                Command="{Binding OpenFolderCommand}"
                                MinHeight="44"
                                Visibility="{Binding CanOpenFolder, Converter={StaticResource BooleanToVisibility}}"
                                animations:MicroMotion.IsInteractive="True"
                                AutomationProperties.Name="{Binding OpenFolderText}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
                  </AppBarButton>
                  <AppBarButton Label="{Binding SaveImageText}"
                                Command="{Binding SaveImageCommand}"
                                MinHeight="44"
                                Visibility="{Binding CanSaveImage, Converter={StaticResource BooleanToVisibility}}"
                                animations:MicroMotion.IsInteractive="True"
                                AutomationProperties.Name="{Binding SaveImageText}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                  </AppBarButton>
                  <AppBarButton Label="{Binding RevealText}"
                                Command="{Binding RevealCommand}"
                                MinHeight="44"
                                Visibility="{Binding CanReveal, Converter={StaticResource BooleanToVisibility}}"
                                animations:MicroMotion.IsInteractive="True"
                                AutomationProperties.Name="{Binding RevealText}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE890;" /></AppBarButton.Icon>
                  </AppBarButton>
                  <AppBarButton Label="{Binding CopyText}"
                                Command="{Binding CopyCommand}"
                                MinHeight="44"
                                Visibility="{Binding CanCopy, Converter={StaticResource BooleanToVisibility}}"
                                animations:MicroMotion.IsInteractive="True"
                                AutomationProperties.Name="{Binding CopyText}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
                  </AppBarButton>
                </CommandBar>

                <InfoBar IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                         Message="{Binding StatusMessage}"
                         Severity="{Binding StatusSeverity}"
                         IsClosable="True"
                         AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <Grid Visibility="{Binding HasHistory, Converter={StaticResource BooleanToVisibility}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding HistoryText}"
                       VerticalAlignment="Center"
                       Style="{StaticResource DockModuleHeaderTextStyle}" />
            <Button Grid.Column="1"
                    Content="{Binding ClearHistoryText}"
                    Command="{Binding ClearHistoryCommand}"
                    Style="{StaticResource DockInlineButtonStyle}"
                    MinHeight="40"
                    Padding="10,6"
                    animations:MicroMotion.IsInteractive="True"
                    AutomationProperties.Name="{Binding ClearHistoryText}" />
          </Grid>

          <ItemsControl Grid.Row="1"
                        ItemsSource="{Binding HistoryEntries}"
                        AutomationProperties.Name="{Binding HistoryText}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button HorizontalContentAlignment="Stretch"
                        MinHeight="54"
                        Margin="0,2"
                        Padding="0"
                        Style="{StaticResource DockInlineButtonStyle}"
                        Command="{Binding DataContext.SelectItemCommand, ElementName=Root}"
                        CommandParameter="{Binding Item}"
                        ToolTipService.ToolTip="{Binding DisplayText}"
                        animations:MicroMotion.IsInteractive="True"
                        AutomationProperties.Name="{Binding DisplayText}">
                  <Grid Padding="8,6" ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3" />
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3"
                            CornerRadius="2"
                            Background="{ThemeResource IslandStyleAccentBrush}"
                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.AccessibilityView="Raw" />
                    <Grid Grid.Column="1" Width="32" Height="32">
                      <Border CornerRadius="8"
                              Background="{ThemeResource DockStatusNeutralFillBrush}"
                              Visibility="{Binding HasColorPreview, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}">
                        <FontIcon Glyph="{Binding TypeGlyph}"
                                  FontSize="14"
                                  Foreground="{ThemeResource IslandStyleAccentBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                      </Border>
                      <Border CornerRadius="8"
                              Background="{Binding ColorPreviewBrush}"
                              BorderBrush="{ThemeResource DockSurfaceStrokeBrush}"
                              BorderThickness="1"
                              Visibility="{Binding HasColorPreview, Converter={StaticResource BooleanToVisibility}}"
                              AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayText}"
                                 MaxLines="1"
                                 TextTrimming="CharacterEllipsis"
                                 Style="{StaticResource DockBodyTextStyle}" />
                      <TextBlock Text="{Binding TypeText}"
                                 MaxLines="1"
                                 Style="{StaticResource DockCaptionTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Text="{Binding RelativeTime}"
                               MaxWidth="86"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Style="{StaticResource DockCaptionTextStyle}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
