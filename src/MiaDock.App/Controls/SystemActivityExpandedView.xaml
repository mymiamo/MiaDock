<UserControl x:Class="MiaDock.App.Controls.SystemActivityExpandedView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:MiaDock.App.Animations"
             xmlns:controls="using:MiaDock.App.Controls"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <Style x:Key="CallHeroIconContainerStyle" TargetType="Border">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="72" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CallGroupedSurfaceStyle" TargetType="Border"
           BasedOn="{StaticResource DockSectionStyle}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
  </UserControl.Resources>

  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding CallAutomationText}"
        animations:MicroMotion.StateKey="{Binding PresentationVisualKey}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
      <StackPanel Padding="0,4,0,8" Spacing="18">
        <StackPanel x:Name="IdleSection"
                    Visibility="{Binding IsCallIdle, Converter={StaticResource BooleanToVisibility}}"
                    Spacing="18">
          <Border Style="{StaticResource DockSectionStyle}" Padding="18,22">
            <StackPanel Spacing="9" HorizontalAlignment="Center">
              <Border Style="{StaticResource CallHeroIconContainerStyle}">
                <FontIcon Glyph="&#xE717;" FontSize="30"
                          Foreground="{ThemeResource IslandStyleAccentBrush}" />
              </Border>
              <TextBlock Text="{Binding CallText}" Style="{StaticResource DockTitleTextStyle}"
                         FontSize="18" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding IdleDescriptionText}"
                         Style="{StaticResource DockCaptionTextStyle}"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
              <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock Text="{Binding LocalDetectionText}"
                           Style="{StaticResource DockStatusTextStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PrivacyText}"
                           Style="{StaticResource DockCaptionTextStyle}" HorizontalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Spacing="7">
            <TextBlock Text="{Binding SupportedAppsText}"
                       Style="{StaticResource DockModuleHeaderTextStyle}" />
            <Border Style="{StaticResource CallGroupedSurfaceStyle}">
              <StackPanel>
                <Grid MinHeight="58" Padding="14,7" ColumnSpacing="11">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE8BD;" FontSize="17" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding DiscordName}" Style="{StaticResource DockBodyTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding SupportedText}" Style="{StaticResource DockStatusTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <Border Height="1" Margin="48,0,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid MinHeight="58" Padding="14,7" ColumnSpacing="11">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE714;" FontSize="17" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding SkypeName}" Style="{StaticResource DockBodyTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding SupportedText}" Style="{StaticResource DockStatusTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <Border Height="1" Margin="48,0,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid MinHeight="58" Padding="14,7" ColumnSpacing="11">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE717;" FontSize="17" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding WhatsAppName}" Style="{StaticResource DockBodyTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding SupportedText}" Style="{StaticResource DockStatusTextStyle}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="PossibleSection"
                    Visibility="{Binding IsCallPossible, Converter={StaticResource BooleanToVisibility}}">
          <Border Style="{StaticResource DockSectionStyle}" Padding="18,24">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <Border Style="{StaticResource CallHeroIconContainerStyle}">
                <FontIcon Glyph="&#xE717;" FontSize="30"
                          Foreground="{ThemeResource IslandStyleAccentBrush}" />
              </Border>
              <TextBlock Text="{Binding CallText}" Style="{StaticResource DockTitleTextStyle}"
                         FontSize="18" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PossibleDetail}" Style="{StaticResource DockCaptionTextStyle}"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
              <Border Style="{StaticResource DockStatusBadgeStyle}" Margin="0,5,0,0">
                <TextBlock Text="{Binding LocalDetectionText}" Style="{StaticResource DockStatusTextStyle}" />
              </Border>
              <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource DockCaptionTextStyle}"
                         TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="DetectedSection"
                    Visibility="{Binding IsCallDetected, Converter={StaticResource BooleanToVisibility}}"
                    Spacing="18">
          <Border x:Name="DetectedHero" Style="{StaticResource DockSectionStyle}" Padding="18,22">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <Border x:Name="DetectedIconContainer" Style="{StaticResource CallHeroIconContainerStyle}">
                <controls:CallAppIconView Width="72" Height="72" />
              </Border>
              <TextBlock Text="{Binding CallAppName}" Style="{StaticResource DockTitleTextStyle}"
                         FontSize="19" HorizontalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{ThemeResource IslandStyleAccentBrush}"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding CallText}" Style="{StaticResource DockStatusTextStyle}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="DurationText" Text="00:00" FontSize="27" FontWeight="SemiBold"
                         FontFamily="Consolas" HorizontalAlignment="Center"
                         AutomationProperties.Name="{Binding CallText}" />
              <Grid ColumnSpacing="8" Margin="0,7,0,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource DockSectionStyle}" Padding="10,9">
                  <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE720;" FontSize="15" />
                    <TextBlock Text="{Binding MicrophoneLabelText}" Style="{StaticResource DockStatusTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DockSectionStyle}" Padding="10,9">
                  <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE767;" FontSize="15" />
                    <TextBlock Text="{Binding AudioSessionLabelText}" Style="{StaticResource DockStatusTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Spacing="7">
            <TextBlock Text="{Binding CallInformationText}" Style="{StaticResource DockModuleHeaderTextStyle}" />
            <Border Style="{StaticResource CallGroupedSurfaceStyle}">
              <StackPanel>
                <Grid MinHeight="54" Padding="14,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ApplicationText}" Style="{StaticResource DockCaptionTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding CallAppName}" Style="{StaticResource DockBodyTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <Border Height="1" Margin="14,0,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid MinHeight="54" Padding="14,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding MicrophoneLabelText}" Style="{StaticResource DockCaptionTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ActiveText}" Style="{StaticResource DockStatusTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <Border Height="1" Margin="14,0,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid MinHeight="54" Padding="14,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding AudioSessionLabelText}" Style="{StaticResource DockCaptionTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ActiveText}" Style="{StaticResource DockStatusTextStyle}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding LocalDetectionText}" Style="{StaticResource DockStatusTextStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource DockCaptionTextStyle}"
                       TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
