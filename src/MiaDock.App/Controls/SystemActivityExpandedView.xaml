<UserControl x:Class="MiaDock.App.Controls.SystemActivityExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="Gizlilik ve etkinlik">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
    <Border Style="{StaticResource DockSectionStyle}" Padding="12,10">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE720;" FontSize="18" Foreground="{ThemeResource IslandStyleAccentBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Mikrofon" Style="{StaticResource DockModuleHeaderTextStyle}" />
          <TextBlock Text="{Binding MicrophoneText}" Style="{StaticResource DockCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Width="44" Height="44" Style="{StaticResource DockIconButtonStyle}"
                Command="{Binding OpenMicrophonePrivacySettingsCommand}"
                ToolTipService.ToolTip="Mikrofon gizlilik ayarlarını aç"
                AutomationProperties.Name="Mikrofon gizlilik ayarlarını aç">
          <FontIcon Glyph="&#xE713;" FontSize="13" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource DockSectionStyle}" Padding="12,10">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE714;" FontSize="18" Foreground="{ThemeResource IslandStyleAccentBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Kamera" Style="{StaticResource DockModuleHeaderTextStyle}" />
          <TextBlock Text="{Binding CameraText}" Style="{StaticResource DockCaptionTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding CameraText}" />
        </StackPanel>
        <Button Grid.Column="2" Width="44" Height="44" Style="{StaticResource DockIconButtonStyle}"
                Command="{Binding OpenCameraPrivacySettingsCommand}"
                ToolTipService.ToolTip="Kamera gizlilik ayarlarını aç"
                AutomationProperties.Name="Kamera gizlilik ayarlarını aç">
          <FontIcon Glyph="&#xE713;" FontSize="13" />
        </Button>
      </Grid>
    </Border>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource DockSectionStyle}" Padding="12,10">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE717;" FontSize="18" Foreground="{ThemeResource IslandStyleAccentBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Arama durumu" Style="{StaticResource DockModuleHeaderTextStyle}" />
          <TextBlock Text="{Binding CallText}" Style="{StaticResource DockCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource DockStatusBadgeStyle}" VerticalAlignment="Center">
          <TextBlock Text="Yerel çıkarım" Style="{StaticResource DockStatusTextStyle}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
