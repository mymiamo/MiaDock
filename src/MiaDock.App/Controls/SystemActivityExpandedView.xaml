<UserControl x:Class="MiaDock.App.Controls.SystemActivityExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="Arama etkinliği">
    <Border Style="{StaticResource DockSectionStyle}" Padding="12,10">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE717;"
                  FontSize="18"
                  Foreground="{ThemeResource IslandStyleAccentBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Arama durumu" Style="{StaticResource DockModuleHeaderTextStyle}" />
          <TextBlock Text="{Binding CallText}"
                     Style="{StaticResource DockCaptionTextStyle}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource DockStatusBadgeStyle}" VerticalAlignment="Center">
          <TextBlock Text="Yerel çıkarım" Style="{StaticResource DockStatusTextStyle}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
