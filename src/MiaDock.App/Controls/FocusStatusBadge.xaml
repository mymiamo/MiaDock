<UserControl
    x:Class="MiaDock.App.Controls.FocusStatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <Border x:Name="BadgeBorder"
          MinWidth="18"
          Height="24"
          Padding="4,0"
          Background="Transparent"
          BorderThickness="1"
          CornerRadius="12">
    <Grid ColumnSpacing="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <icons:DockIcon x:Name="ProfileIcon" IsFilled="True"
                VerticalAlignment="Center"
                FontSize="12" />

      <StackPanel x:Name="DetailsPanel"
                  Grid.Column="1"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Spacing="-1"
                  Visibility="Collapsed">
        <TextBlock Text="{Binding ActiveProfileName}"
                   MaxWidth="96"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockStatusTextStyle}"
                   ToolTipService.ToolTip="{Binding ActiveProfileName}" />
        <TextBlock Text="{Binding RemainingText}"
                   MaxWidth="96"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockCaptionTextStyle}"
                   ToolTipService.ToolTip="{Binding RemainingText}" />
      </StackPanel>

      <Button x:Name="DeactivateButton"
              Grid.Column="2"
              Width="24"
              Height="24"
              Style="{StaticResource IslandCompactIconButtonStyle}"
              Command="{Binding DeactivateCommand}"
              Visibility="Collapsed">
        <icons:DockIcon Glyph="&#xE711;" FontSize="9" />
      </Button>
    </Grid>
  </Border>
</UserControl>
