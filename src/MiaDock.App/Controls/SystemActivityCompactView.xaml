<UserControl x:Class="MiaDock.App.Controls.SystemActivityCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons"
             xmlns:animations="using:MiaDock.App.Animations">
  <Grid Style="{StaticResource DockCompactModuleLayoutStyle}"
        AutomationProperties.Name="{Binding ActivityTitle}"
        animations:MicroMotion.StateKey="{Binding PresentationVisualKey}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border Width="30" Height="30" CornerRadius="9"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
      <icons:DockIcon IsFilled="{Binding IsCallDetected}" Glyph="{Binding ActivityGlyph}" FontSize="15" />
    </Border>
    <TextBlock Grid.Column="1" Text="{Binding ActivityTitle}" VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis" MaxLines="1"
               Style="{StaticResource DockBodyTextStyle}"
               ToolTipService.ToolTip="{Binding ActivityDetail}" />
    <TextBlock Grid.Column="2" Text="{Binding CompactTrailingText}" VerticalAlignment="Center"
               Style="{StaticResource DockStatusTextStyle}" />
  </Grid>
</UserControl>
