<UserControl x:Class="MiaDock.App.Controls.SystemActivityCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="14,0" ColumnSpacing="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <FontIcon Glyph="{Binding MasterVolumeGlyph}" FontSize="15" />
    <TextBlock Grid.Column="1" Text="Sistem sesi" VerticalAlignment="Center"
               Style="{StaticResource IslandBodyTextStyle}" />
    <TextBlock Grid.Column="2" Text="{Binding MasterVolumeText}" VerticalAlignment="Center"
               Style="{StaticResource IslandBodyTextStyle}" />
  </Grid>
</UserControl>
