<UserControl x:Class="MiaDock.App.Controls.BatteryStatusIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="26" Height="14" IsHitTestVisible="False"
             Foreground="{ThemeResource IslandTextSecondaryBrush}">
  <Viewbox Stretch="Uniform" AutomationProperties.AccessibilityView="Raw">
    <Grid x:Name="BatteryCanvas" Width="32" Height="16">
      <Border x:Name="BatteryBody" Width="28" Height="14" HorizontalAlignment="Left"
              BorderThickness="1.4" CornerRadius="3.5" BorderBrush="{ThemeResource IslandTextSecondaryBrush}">
        <Grid Margin="2">
          <Border x:Name="ChargeFill" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                  CornerRadius="1.5" Background="{ThemeResource IslandTextSecondaryBrush}" />
        </Grid>
      </Border>
      <Border x:Name="BatteryTip" Width="2" Height="6" Margin="29,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
              CornerRadius="1" Background="{ThemeResource IslandTextSecondaryBrush}" />
      <Grid x:Name="PercentageOverlay" Width="28" Height="14"
            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="PercentageText" FontSize="8.5" FontWeight="Bold"
                   HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" />
        <Grid x:Name="FilledLabelLayer">
          <Grid.Clip><RectangleGeometry x:Name="PercentageFillClip" /></Grid.Clip>
          <TextBlock x:Name="FilledPercentageText" FontSize="8.5" FontWeight="Bold"
                     HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Grid>
      <Polygon x:Name="ChargingBolt" Points="18,0 10,9 15,9 12,16 23,6 17,6 20,0"
               StrokeThickness="1" StrokeLineJoin="Round" Fill="White" Stroke="#666666" Visibility="Collapsed" />
      <TextBlock x:Name="UnknownMark" Text="?" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                 Foreground="{ThemeResource IslandTextPrimaryBrush}" />
    </Grid>
  </Viewbox>
</UserControl>
