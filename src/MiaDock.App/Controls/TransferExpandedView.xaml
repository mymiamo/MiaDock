<UserControl x:Class="MiaDock.App.Controls.TransferExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons"
             xmlns:animations="using:MiaDock.App.Animations">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding Title}"
        animations:MicroMotion.StateKey="{Binding StatusText}">
    <StackPanel Spacing="12">
      <Border Style="{StaticResource DockHeroSectionStyle}">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource DockHeroIconContainerStyle}">
              <icons:DockIcon Glyph="&#xE896;" FontSize="22"
                        Foreground="{ThemeResource IslandStyleAccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Title}" MaxLines="1"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockTitleTextStyle}"
                         ToolTipService.ToolTip="{Binding Title}" />
              <TextBlock Text="{Binding StatusText}" MaxLines="1"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockCaptionTextStyle}"
                         ToolTipService.ToolTip="{Binding StatusText}" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource DockStatusBadgeStyle}">
              <TextBlock Text="{Binding ValueText}"
                         Style="{StaticResource DockStatusTextStyle}" />
            </Border>
          </Grid>
          <ProgressBar Value="{Binding Progress}" Maximum="1"
                       Style="{StaticResource DockProgressBarStyle}"
                       AutomationProperties.Name="Aktarım ilerlemesi" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource DockGroupedSectionStyle}">
        <Border Style="{StaticResource DockMiniGroupedRowStyle}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <icons:DockIcon Glyph="&#xE896;" FontSize="14"
                      Foreground="{ThemeResource IslandStyleAccentBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding ActiveCountText}"
                       VerticalAlignment="Center" Style="{StaticResource DockBodyTextStyle}" />
          </Grid>
        </Border>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
