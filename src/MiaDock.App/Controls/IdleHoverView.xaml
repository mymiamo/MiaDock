<UserControl
    x:Class="MiaDock.App.Controls.IdleHoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiaDock.App.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <Grid x:Name="LayoutRoot" Padding="12,1" RowSpacing="1"
        AutomationProperties.LiveSetting="Polite">
    <Grid.RowDefinitions>
      <RowDefinition Height="22" />
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Ellipse Width="5" Height="5" VerticalAlignment="Center"
               Fill="{ThemeResource IslandStyleAccentBrush}"
               AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center"
                 Style="{StaticResource DockBodyTextStyle}"
                 FontWeight="SemiBold" />
      <Border x:Name="DateSeparator"
              Grid.Column="2" Width="1" Height="12" VerticalAlignment="Center"
              Background="{ThemeResource DockDividerBrush}" />
      <TextBlock x:Name="DateText" Grid.Column="3" VerticalAlignment="Center"
                 MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockCaptionTextStyle}" />
      <local:FocusStatusBadge x:Name="FocusStatus"
                              Grid.Column="4"
                              ShowDetails="True"
                              ShowDeactivateButton="True"
                              VerticalAlignment="Center" />
      <FontIcon Grid.Column="5" Glyph="{Binding NetworkGlyph}"
                FontFamily="Segoe Fluent Icons"
                FontSize="13"
                Foreground="{Binding NetworkStatusBrush}"
                ToolTipService.ToolTip="{Binding NetworkStatus}"
                AutomationProperties.Name="{Binding NetworkStatus}" />
    </Grid>

    <Border Grid.Row="1" Background="{ThemeResource DockDividerBrush}" />

    <Grid x:Name="MusicRow" Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <FontIcon Glyph="&#xE8D6;"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{ThemeResource IslandStyleAccentBrush}"
                AutomationProperties.AccessibilityView="Raw" />

      <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Spacing="0">
        <TextBlock x:Name="TrackTitleText"
                   Text="{Binding Current.Track.Title}"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockBodyTextStyle}"
                   FontWeight="SemiBold"
                   ToolTipService.ToolTip="{Binding Current.Track.Title}" />
        <TextBlock x:Name="TrackArtistText"
                   Text="{Binding Current.Track.Artist}"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockCaptionTextStyle}"
                   ToolTipService.ToolTip="{Binding Current.Track.Artist}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Width="44"
                Height="44"
                Style="{StaticResource DockIconButtonStyle}"
                IsTabStop="True"
                Command="{Binding PreviousCommand}"
                ToolTipService.ToolTip="Önceki parça"
                AutomationProperties.Name="Önceki parça"
                AutomationProperties.HelpText="Önceki parçaya geçer">
          <FontIcon Glyph="&#xE892;" FontSize="14" />
        </Button>
        <Button Width="44"
                Height="44"
                Style="{StaticResource DockIconButtonStyle}"
                IsTabStop="True"
                Command="{Binding PlayPauseCommand}"
                ToolTipService.ToolTip="Oynat veya duraklat"
                AutomationProperties.Name="Oynat veya duraklat"
                AutomationProperties.HelpText="Geçerli parçayı oynatır veya duraklatır">
          <FontIcon Glyph="{Binding PlaybackGlyph}" FontSize="14" />
        </Button>
        <Button Width="44"
                Height="44"
                Style="{StaticResource DockIconButtonStyle}"
                IsTabStop="True"
                Command="{Binding NextCommand}"
                ToolTipService.ToolTip="Sonraki parça"
                AutomationProperties.Name="Sonraki parça"
                AutomationProperties.HelpText="Sonraki parçaya geçer">
          <FontIcon Glyph="&#xE893;" FontSize="14" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid x:Name="IdleRow" Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE80F;"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{ThemeResource IslandStyleAccentBrush}"
                AutomationProperties.AccessibilityView="Raw" />
      <TextBlock Grid.Column="1"
                 Text="{Binding StatusSummary}"
                 VerticalAlignment="Center"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockCaptionTextStyle}"
                 ToolTipService.ToolTip="{Binding StatusSummary}" />
    </Grid>
  </Grid>
</UserControl>
