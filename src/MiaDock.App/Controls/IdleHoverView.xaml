<UserControl
    x:Class="MiaDock.App.Controls.IdleHoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiaDock.App.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <Grid x:Name="LayoutRoot" Padding="12,5,12,6" RowSpacing="2"
        AutomationProperties.LiveSetting="Polite">
    <Grid.RowDefinitions>
      <RowDefinition Height="22" />
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Ellipse Width="5" Height="5" VerticalAlignment="Center"
               Fill="{ThemeResource IslandStyleAccentBrush}"
               AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center"
                 FontFamily="Segoe UI Variable Display" FontSize="13" FontWeight="SemiBold"
                 Foreground="{ThemeResource IslandTextPrimaryBrush}" />
      <Border Grid.Column="2" Width="1" Height="12" VerticalAlignment="Center"
              Background="{ThemeResource IslandTextSecondaryBrush}" Opacity="0.3" />
      <TextBlock x:Name="DateText" Grid.Column="3" VerticalAlignment="Center"
                 MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource IslandCaptionTextStyle}" FontSize="10" />
      <FontIcon Grid.Column="4" Glyph="{Binding NetworkGlyph}"
                FontFamily="Segoe Fluent Icons" FontSize="12"
                Foreground="{Binding NetworkStatusBrush}"
                ToolTipService.ToolTip="{Binding NetworkStatus}"
                AutomationProperties.Name="{Binding NetworkStatus}" />
    </Grid>

    <Border Grid.Row="1" Background="{ThemeResource IslandTextSecondaryBrush}" Opacity="0.16" />

    <Grid x:Name="MusicRow" Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel MinWidth="0" VerticalAlignment="Center" Spacing="0">
        <TextBlock x:Name="TrackTitleText"
                   Text="{Binding Current.Track.Title}"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource IslandTextPrimaryBrush}"
                   ToolTipService.ToolTip="{Binding Current.Track.Title}" />
        <TextBlock x:Name="TrackArtistText"
                   Text="{Binding Current.Track.Artist}"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   FontSize="9"
                   Foreground="{ThemeResource IslandTextSecondaryBrush}"
                   ToolTipService.ToolTip="{Binding Current.Track.Artist}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
        <Button Width="26" Height="26"
                Style="{StaticResource IslandCompactIconButtonStyle}"
                IsTabStop="True"
                Command="{Binding PreviousCommand}"
                ToolTipService.ToolTip="Önceki parça"
                AutomationProperties.Name="Önceki parça"
                AutomationProperties.HelpText="Önceki parçaya geçer">
          <FontIcon Glyph="&#xE892;" FontSize="10" />
        </Button>
        <Button Width="28" Height="28"
                Style="{StaticResource IslandCompactIconButtonStyle}"
                IsTabStop="True"
                Command="{Binding PlayPauseCommand}"
                ToolTipService.ToolTip="Oynat veya duraklat"
                AutomationProperties.Name="Oynat veya duraklat"
                AutomationProperties.HelpText="Geçerli parçayı oynatır veya duraklatır">
          <FontIcon Glyph="{Binding PlaybackGlyph}" FontSize="11" />
        </Button>
        <Button Width="26" Height="26"
                Style="{StaticResource IslandCompactIconButtonStyle}"
                IsTabStop="True"
                Command="{Binding NextCommand}"
                ToolTipService.ToolTip="Sonraki parça"
                AutomationProperties.Name="Sonraki parça"
                AutomationProperties.HelpText="Sonraki parçaya geçer">
          <FontIcon Glyph="&#xE893;" FontSize="10" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid x:Name="IdleRow" Grid.Row="2">
      <TextBlock Text="{Binding StatusSummary}"
                 VerticalAlignment="Center"
                 MaxLines="1"
                 FontSize="10"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource IslandTextSecondaryBrush}"
                 ToolTipService.ToolTip="{Binding StatusSummary}" />
    </Grid>
  </Grid>
</UserControl>
