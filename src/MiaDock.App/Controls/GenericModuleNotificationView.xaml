<UserControl x:Class="MiaDock.App.Controls.GenericModuleNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="18" ColumnSpacing="14"
        AutomationProperties.Name="{Binding PrimaryText}"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <FontIcon FontSize="20" Glyph="{Binding LeadingGlyph}" Foreground="{ThemeResource IslandStyleAccentBrush}" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
      <TextBlock Text="{Binding PrimaryText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource IslandTitleTextStyle}" />
      <TextBlock Text="{Binding SecondaryText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource IslandBodyTextStyle}" />
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"
               Style="{StaticResource IslandBodyTextStyle}" />
  </Grid>
</UserControl>
