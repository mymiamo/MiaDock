<UserControl x:Class="MiaDock.App.Controls.GenericModuleNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockNotificationLayoutStyle}"
        AutomationProperties.Name="{Binding PrimaryText}"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border Style="{StaticResource DockNotificationIconContainerStyle}">
      <FontIcon Glyph="{Binding LeadingGlyph}" Style="{StaticResource DockModuleIconStyle}" />
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
      <TextBlock Text="{Binding PrimaryText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockTitleTextStyle}"
                 ToolTipService.ToolTip="{Binding PrimaryText}" />
      <TextBlock Text="{Binding SecondaryText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockBodyTextStyle}"
                 ToolTipService.ToolTip="{Binding SecondaryText}" />
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"
               MaxLines="1" TextTrimming="CharacterEllipsis"
               Style="{StaticResource DockStatusTextStyle}"
               ToolTipService.ToolTip="{Binding ValueText}" />
  </Grid>
</UserControl>
