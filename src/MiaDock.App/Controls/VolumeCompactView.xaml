<UserControl x:Class="MiaDock.App.Controls.VolumeCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockCompactModuleLayoutStyle}"
        AutomationProperties.Name="{Binding TitleText}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <FontIcon Glyph="{Binding VolumeGlyph}"
              Style="{StaticResource DockModuleIconStyle}" />
    <TextBlock Grid.Column="1"
               Text="{Binding TitleText}"
               VerticalAlignment="Center"
               MaxLines="1"
               TextTrimming="CharacterEllipsis"
               Style="{StaticResource DockBodyTextStyle}"
               ToolTipService.ToolTip="{Binding TitleText}" />
    <TextBlock Grid.Column="2"
               Text="{Binding VolumeText}"
               VerticalAlignment="Center"
               Style="{StaticResource DockStatusTextStyle}" />
  </Grid>
</UserControl>
