<UserControl
    x:Class="MiaDock.App.Controls.SourceAppBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiaDock.App.Controls">

  <Border Padding="8,4"
          Background="{ThemeResource IslandControlFillBrush}"
          CornerRadius="12">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Grid Width="16" Height="16">
        <FontIcon Glyph="&#xE8A5;"
                  FontSize="12"
                  Foreground="{ThemeResource IslandTextSecondaryBrush}"
                  AutomationProperties.AccessibilityView="Raw" />
        <controls:MediaImagePresenter Media="{Binding Current.Source.Icon}"
                                      AutomationProperties.AccessibilityView="Raw" />
      </Grid>
      <TextBlock MaxWidth="120"
                 Style="{StaticResource DockCaptionTextStyle}"
                 Text="{Binding Current.Source.DisplayName}" />
    </StackPanel>
  </Border>
</UserControl>
