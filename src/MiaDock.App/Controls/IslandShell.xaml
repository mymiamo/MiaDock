<UserControl
    x:Class="MiaDock.App.Controls.IslandShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

  <Grid x:Name="LayoutRoot"
        Width="292"
        Height="46"
        Background="Transparent">
    <SystemBackdropElement x:Name="BackdropSurface"
                           CornerRadius="23" />
    <Border x:Name="Surface"
            Style="{StaticResource DockSurfaceStyle}">
      <Grid x:Name="ContentHost" Background="Transparent" />
    </Border>
    <Border x:Name="EdgeRevealSurface"
            Visibility="Collapsed"
            CornerRadius="23"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw">
      <Grid>
        <ContentControl x:Name="EdgeRevealStatusHost"
                        Height="15"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed" />
        <Border x:Name="EdgeRevealGrip"
                Width="42"
                Height="3"
                Margin="0,0,0,4"
                Background="#F2FFFFFF"
                CornerRadius="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
