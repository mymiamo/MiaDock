<UserControl
    x:Class="MiaDock.App.Controls.IslandShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="LayoutRoot"
        Width="292"
        Height="46">
    <SystemBackdropElement x:Name="BackdropSurface"
                           CornerRadius="23" />
    <Border x:Name="Surface"
            Background="#FF000000"
            BorderBrush="#FF252525"
            BorderThickness="1"
            CornerRadius="23">
      <Grid x:Name="ContentHost" />
    </Border>
  </Grid>
</UserControl>
