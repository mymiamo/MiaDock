<UserControl
    x:Class="MiaDock.App.Controls.IslandShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="LayoutRoot"
        Width="292"
        Height="46"
        Background="Transparent">
    <SystemBackdropElement x:Name="BackdropSurface"
                           CornerRadius="23" />
    <Border x:Name="Surface"
            Style="{StaticResource DockSurfaceStyle}">
      <Grid x:Name="ContentHost" Background="Transparent" />
    </Border>
  </Grid>
</UserControl>
