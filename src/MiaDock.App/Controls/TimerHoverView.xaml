<UserControl x:Class="MiaDock.App.Controls.TimerHoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="16,0" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{ThemeResource IslandStyleAccentBrush}" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="{Binding CompactTimeText}" FontWeight="SemiBold" Foreground="{ThemeResource IslandTextPrimaryBrush}" />
      <TextBlock Text="{Binding CompactStatusText}" Style="{StaticResource IslandCaptionTextStyle}" />
    </StackPanel>
    <Button Grid.Column="2" Width="34" Height="34"
            Style="{StaticResource IslandCompactIconButtonStyle}"
            Command="{Binding CompactPrimaryCommand}"
            ToolTipService.ToolTip="{Binding CompactPrimaryText}" AutomationProperties.Name="{Binding CompactPrimaryText}">
      <FontIcon Glyph="{Binding CompactPrimaryGlyph}" FontSize="14" />
    </Button>
    <Button Grid.Column="3" Width="32" Height="32"
            Style="{StaticResource IslandCompactIconButtonStyle}"
            Command="{Binding CompactSecondaryCommand}"
            ToolTipService.ToolTip="{Binding CompactSecondaryText}" AutomationProperties.Name="{Binding CompactSecondaryText}">
      <FontIcon Glyph="&#xE711;" FontSize="12" />
    </Button>
  </Grid>
</UserControl>
