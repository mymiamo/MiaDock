<UserControl x:Class="MiaDock.App.Controls.TimerHoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockCompactModuleLayoutStyle}"
        AutomationProperties.Name="{Binding CompactStatusText}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE823;" Style="{StaticResource DockModuleIconStyle}" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="{Binding CompactTimeText}"
                 Style="{StaticResource DockBodyTextStyle}"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding CompactStatusText}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockCaptionTextStyle}"
                 ToolTipService.ToolTip="{Binding CompactStatusText}" />
    </StackPanel>
    <StackPanel x:Name="NormalActions"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
      <Button Width="44" Height="44"
              Style="{StaticResource DockIconButtonStyle}"
              Command="{Binding CompactPrimaryCommand}"
              ToolTipService.ToolTip="{Binding CompactPrimaryText}"
              AutomationProperties.Name="{Binding CompactPrimaryText}">
        <FontIcon Glyph="{Binding CompactPrimaryGlyph}" FontSize="14" />
      </Button>
      <Button Width="44" Height="44"
              Style="{StaticResource DockIconButtonStyle}"
              Command="{Binding CompactSecondaryCommand}"
              ToolTipService.ToolTip="{Binding CompactSecondaryText}"
              AutomationProperties.Name="{Binding CompactSecondaryText}">
        <FontIcon Glyph="&#xE711;" FontSize="12" />
      </Button>
    </StackPanel>

    <Button x:Name="SilenceAlarmButton"
            Grid.Column="2"
            MinWidth="112"
            Height="44"
            Padding="10,0"
            Visibility="Collapsed"
            Style="{StaticResource DockInlineButtonStyle}"
            Command="{Binding CompactSecondaryCommand}"
            ToolTipService.ToolTip="{Binding CompactSecondaryText}"
            AutomationProperties.Name="{Binding CompactSecondaryText}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon Glyph="&#xE7ED;" FontSize="13" />
      <TextBlock Text="{Binding CompactSecondaryText}"
                 VerticalAlignment="Center"
                 Style="{StaticResource DockBodyTextStyle}" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
