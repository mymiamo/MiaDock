<UserControl x:Class="MiaDock.App.Controls.PrivacyExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons"
             xmlns:controls="using:MiaDock.App.Controls"
             xmlns:animations="using:MiaDock.App.Animations">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding TitleText}"
        animations:MicroMotion.StateKey="{Binding SummaryText}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource DockHeroSectionStyle}"
            Padding="14,10">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource DockModuleIconContainerStyle}">
          <icons:DockIcon IsFilled="{Binding HasActiveUsage}" Glyph="{Binding StatusGlyph}"
                    FontSize="20"
                    Foreground="{ThemeResource IslandStyleAccentBrush}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding SummaryText}"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     Style="{StaticResource DockTitleTextStyle}" />
          <TextBlock Text="{Binding HeroDetailText}"
                     MaxLines="1"
                     Style="{StaticResource DockCaptionTextStyle}"
                     TextTrimming="CharacterEllipsis"
                     ToolTipService.ToolTip="{Binding HeroDetailText}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Width="44" Height="44"
                  Style="{StaticResource DockIconButtonStyle}"
                  animations:MicroMotion.IsInteractive="True"
                  Command="{Binding OpenMicrophonePrivacySettingsCommand}"
                  ToolTipService.ToolTip="Mikrofon gizlilik ayarlarını aç"
                  AutomationProperties.Name="Mikrofon gizlilik ayarlarını aç"
                  AutomationProperties.HelpText="Mikrofon gizlilik ayarlarını aç">
            <icons:DockIcon Glyph="&#xE720;" FontSize="14" />
          </Button>
          <Button Width="44" Height="44"
                  Style="{StaticResource DockIconButtonStyle}"
                  animations:MicroMotion.IsInteractive="True"
                  Command="{Binding OpenCameraPrivacySettingsCommand}"
                  ToolTipService.ToolTip="Kamera gizlilik ayarlarını aç"
                  AutomationProperties.Name="Kamera gizlilik ayarlarını aç"
                  AutomationProperties.HelpText="Kamera gizlilik ayarlarını aç">
            <icons:DockIcon Glyph="&#xE714;" FontSize="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1"
                Margin="0,10,0,0"
                Visibility="{Binding HasActiveUsage, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Text="{Binding ActiveApplicationsHeader}"
                 Style="{StaticResource DockSectionHeaderTextStyle}" />
      <Border Style="{StaticResource DockGroupedSectionStyle}">
        <ItemsControl ItemsSource="{Binding Applications}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource DockMiniGroupedRowStyle}">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:PrivacyAppIconView DataContext="{Binding}" />
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                             VerticalAlignment="Center"
                             Style="{StaticResource DockBodyTextStyle}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding UsageText}"
                             VerticalAlignment="Center"
                             Style="{StaticResource DockStatusTextStyle}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
