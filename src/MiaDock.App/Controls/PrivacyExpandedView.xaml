<UserControl x:Class="MiaDock.App.Controls.PrivacyExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding TitleText}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource DockSectionStyle}" Padding="12,10">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="{Binding StatusGlyph}"
                  FontSize="18"
                  Foreground="{ThemeResource IslandStyleAccentBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding TitleText}" Style="{StaticResource DockModuleHeaderTextStyle}" />
          <TextBlock Text="{Binding SummaryText}"
                     Style="{StaticResource DockCaptionTextStyle}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Margin="0,8,0,0"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding HasActiveUsage, Converter={StaticResource BooleanToVisibility}}">
      <ItemsControl ItemsSource="{Binding Applications}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource DockSectionStyle}" Padding="10,8" Margin="0,0,0,6">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:PrivacyAppIconView DataContext="{Binding}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding DisplayName}"
                             Style="{StaticResource DockBodyTextStyle}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding UsageText}"
                             Style="{StaticResource DockCaptionTextStyle}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="1"
            Style="{StaticResource DockSectionStyle}"
            Padding="12,16"
            VerticalAlignment="Center">
      <Border.Visibility>
        <Binding Path="HasActiveUsage" Converter="{StaticResource BooleanToVisibility}" ConverterParameter="Invert" />
      </Border.Visibility>
      <TextBlock Text="{Binding EmptyText}"
                 HorizontalAlignment="Center"
                 Style="{StaticResource DockCaptionTextStyle}" />
    </Border>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,8,0,0"
                HorizontalAlignment="Right">
      <Button Style="{StaticResource DockIconButtonStyle}"
              Width="40"
              Height="40"
              Command="{Binding OpenMicrophonePrivacySettingsCommand}"
              ToolTipService.ToolTip="Mikrofon gizlilik ayarlarını aç"
              AutomationProperties.Name="Mikrofon gizlilik ayarlarını aç">
        <FontIcon Glyph="&#xE720;" FontSize="13" />
      </Button>
      <Button Style="{StaticResource DockIconButtonStyle}"
              Width="40"
              Height="40"
              Command="{Binding OpenCameraPrivacySettingsCommand}"
              ToolTipService.ToolTip="Kamera gizlilik ayarlarını aç"
              AutomationProperties.Name="Kamera gizlilik ayarlarını aç">
        <FontIcon Glyph="&#xE714;" FontSize="13" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
