<UserControl x:Class="MiaDock.App.Controls.AudioActivityIndicator"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             Foreground="White"
             AutomationProperties.Name="Müzik etkinliği">
  <UserControl.Resources>
    <Storyboard x:Name="FallbackStoryboard" RepeatBehavior="Forever">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     Duration="0:0:0.78">
        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.28" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="0.88" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="0.42" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="0.28" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     Duration="0:0:0.78">
        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0.34" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="0.72" />
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     Duration="0:0:0.78">
        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.46" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.3" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.46" Value="0.82" />
        <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="0.46" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal" Spacing="1.5" VerticalAlignment="Center">
    <Rectangle Width="2" Height="14" RadiusX="1" RadiusY="1"
               Fill="{Binding Foreground, ElementName=Root}" RenderTransformOrigin="0.5,0.5">
      <Rectangle.RenderTransform><ScaleTransform x:Name="LeftScale" ScaleY="0.18" /></Rectangle.RenderTransform>
    </Rectangle>
    <Rectangle Width="2" Height="14" RadiusX="1" RadiusY="1"
               Fill="{Binding Foreground, ElementName=Root}" RenderTransformOrigin="0.5,0.5">
      <Rectangle.RenderTransform><ScaleTransform x:Name="CenterScale" ScaleY="0.18" /></Rectangle.RenderTransform>
    </Rectangle>
    <Rectangle Width="2" Height="14" RadiusX="1" RadiusY="1"
               Fill="{Binding Foreground, ElementName=Root}" RenderTransformOrigin="0.5,0.5">
      <Rectangle.RenderTransform><ScaleTransform x:Name="RightScale" ScaleY="0.18" /></Rectangle.RenderTransform>
    </Rectangle>
  </StackPanel>
</UserControl>
