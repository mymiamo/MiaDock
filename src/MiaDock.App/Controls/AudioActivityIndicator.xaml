<UserControl x:Class="MiaDock.App.Controls.AudioActivityIndicator"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             Foreground="White"
             AutomationProperties.Name="Müzik etkinliği">
  <StackPanel Orientation="Horizontal"
              Spacing="{Binding BarSpacing, ElementName=Root}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
    <Rectangle x:Name="TrebleBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               VerticalAlignment="Center" />
    <Rectangle x:Name="BassBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               VerticalAlignment="Center" />
    <Rectangle x:Name="VocalBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
