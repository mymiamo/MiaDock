<UserControl x:Class="MiaDock.App.Controls.AudioActivityIndicator"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             Foreground="White"
             AutomationProperties.Name="Müzik etkinliği">
  <StackPanel Orientation="Horizontal"
              Spacing="{Binding BarSpacing, ElementName=Root}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
    <Rectangle x:Name="LeadingBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               RenderTransformOrigin="0.5,0.5"
               VerticalAlignment="Center" />
    <Rectangle x:Name="LeadingInnerBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               RenderTransformOrigin="0.5,0.5"
               VerticalAlignment="Center" />
    <Rectangle x:Name="CenterLeadingBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               RenderTransformOrigin="0.5,0.5"
               VerticalAlignment="Center" />
    <Rectangle x:Name="CenterBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               RenderTransformOrigin="0.5,0.5"
               VerticalAlignment="Center" />
    <Rectangle x:Name="TrailingInnerBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               RenderTransformOrigin="0.5,0.5"
               VerticalAlignment="Center" />
    <Rectangle x:Name="TrailingBar"
               Width="{Binding BarWidth, ElementName=Root}"
               Height="{Binding BarHeight, ElementName=Root}"
               RadiusX="999" RadiusY="999"
               Fill="{Binding Foreground, ElementName=Root}"
               RenderTransformOrigin="0.5,0.5"
               VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
