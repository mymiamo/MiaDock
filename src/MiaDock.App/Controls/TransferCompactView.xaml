<UserControl x:Class="MiaDock.App.Controls.TransferCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="14,0" ColumnSpacing="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="72" />
    </Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource IslandStyleAccentBrush}" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
      <TextBlock Text="{Binding Title}" MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource IslandBodyTextStyle}" />
      <TextBlock Text="{Binding StatusText}" MaxLines="1"
                 Style="{StaticResource IslandCaptionTextStyle}" />
    </StackPanel>
    <ProgressBar Grid.Column="2" Value="{Binding Progress}" Maximum="1"
                 VerticalAlignment="Center" AutomationProperties.Name="Aktarım ilerlemesi" />
  </Grid>
</UserControl>
