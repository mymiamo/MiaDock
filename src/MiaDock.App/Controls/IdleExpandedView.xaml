<UserControl
    x:Class="MiaDock.App.Controls.IdleExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiaDock.App.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <Grid x:Name="LayoutRoot"
        Padding="16,8,16,6"
        RowSpacing="7"
        AutomationProperties.LiveSetting="Polite">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TimeText"
                 VerticalAlignment="Center"
                 Style="{StaticResource DockDisplayTextStyle}"
                 FontFamily="Segoe UI Variable Display"
                 FontSize="30"
                 FontWeight="Bold"
                 Foreground="{ThemeResource IslandTextPrimaryBrush}" />
      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center"
                  Spacing="0">
        <TextBlock x:Name="DateText"
                   FontFamily="Segoe UI Variable Text"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource IslandTextPrimaryBrush}" />
        <TextBlock Text="{Binding NetworkStatus}"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockCaptionTextStyle}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
      <Button x:Name="NetworkCard"
              Padding="0"
              Background="Transparent"
              Command="{Binding ToggleWifiCommand}"
              ToolTipService.ToolTip="{Binding NetworkStatus}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <FontIcon Glyph="{Binding NetworkGlyph}"
                  FontSize="14"
                  Foreground="{Binding NetworkStatusBrush}" />
        <TextBlock Text="{Binding NetworkStatus}"
                   MaxWidth="122"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockStatusTextStyle}" />
        </StackPanel>
      </Button>

      <Border Width="1" Height="20" Background="{ThemeResource DockDividerBrush}" />

      <Button x:Name="BluetoothCard"
              Padding="0"
              Background="Transparent"
              Command="{Binding ToggleBluetoothCommand}"
              ToolTipService.ToolTip="{Binding BluetoothStatus}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE702;" FontSize="14" />
        <TextBlock Text="{Binding BluetoothStatus}"
                   MaxWidth="118"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockStatusTextStyle}" />
        </StackPanel>
      </Button>

      <FontIcon Glyph="&#xE72E;"
                FontSize="14"
                Visibility="{Binding VpnVisibility}"
                ToolTipService.ToolTip="{Binding VpnStatus}"
                AutomationProperties.Name="{Binding VpnStatus}" />

      <Border Width="1" Height="20" Background="{ThemeResource DockDividerBrush}" />

      <StackPanel x:Name="BatteryCard"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
        <FontIcon Glyph="{Binding BatteryGlyph}" FontSize="14" />
        <TextBlock Text="{Binding BatteryText}"
                   MaxLines="1"
                   Style="{StaticResource DockStatusTextStyle}" />
      </StackPanel>

      <Border Width="1" Height="20" Background="{ThemeResource DockDividerBrush}" />

      <Grid x:Name="SystemCard" VerticalAlignment="Center">
        <StackPanel x:Name="SystemStatusPanel"
                    Orientation="Horizontal"
                    Spacing="6">
          <FontIcon Glyph="{Binding MasterVolumeGlyph}" FontSize="14" />
          <TextBlock Text="{Binding MasterVolumeText}"
                     MaxLines="1"
                     Style="{StaticResource DockStatusTextStyle}" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FocusColumn" Width="170" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="FocusCard"
              Style="{StaticResource DockSectionStyle}"
              Padding="10,6">
        <local:FocusQuickPanel x:Name="FocusPanel" />
      </Border>

      <Border x:Name="MusicPanel"
              Grid.Column="1"
              Style="{StaticResource DockSectionStyle}"
              Padding="10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="142" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Width="142" Height="142" VerticalAlignment="Center">
            <Border x:Name="EmptyArtwork"
                    Background="{ThemeResource IslandSurfaceSecondaryBrush}"
                    BorderBrush="{ThemeResource DockSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16" />
            <local:AlbumArtwork x:Name="MediaArtwork"
                                Width="142"
                                Height="142" />
          </Grid>

          <Grid Grid.Column="1" RowSpacing="5">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid>
              <TextBlock Text="Şimdi Çalıyor"
                         Style="{StaticResource DockCaptionTextStyle}" />
              <local:AudioActivityIndicator x:Name="MusicActivity"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource IslandTextPrimaryBrush}"
                                            LeftLevel="{Binding LeftAudioLevel}"
                                            CenterLevel="{Binding CenterAudioLevel}"
                                            RightLevel="{Binding RightAudioLevel}"
                                            IsPlaying="{Binding HasAudioActivity}"
                                            IsAudioAvailable="{Binding IsAudioLevelAvailable}" />
            </Grid>

            <StackPanel x:Name="MediaMetadataPanel"
                        Grid.Row="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Spacing="2">
              <TextBlock Text="{Binding Current.Track.Title}"
                         MaxLines="2"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockTitleTextStyle}"
                         ToolTipService.ToolTip="{Binding Current.Track.Title}" />
              <TextBlock Text="{Binding Current.Track.Artist}"
                         MaxLines="1"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockCaptionTextStyle}"
                         ToolTipService.ToolTip="{Binding Current.Track.Artist}" />
            </StackPanel>

            <StackPanel x:Name="MediaEmptyPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Spacing="3">
              <TextBlock Text="Şu an çalınan medya yok"
                         MaxLines="2"
                         Style="{StaticResource DockTitleTextStyle}" />
              <TextBlock Text="Desteklenen bir uygulamada medya oynatın."
                         MaxLines="2"
                         Style="{StaticResource DockCaptionTextStyle}" />
            </StackPanel>

            <local:MediaTimeline Grid.Row="2" IsCompact="True" />

            <local:MediaTransportControls Grid.Row="3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
