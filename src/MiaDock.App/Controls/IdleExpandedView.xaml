<UserControl
    x:Class="MiaDock.App.Controls.IdleExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons"
    xmlns:local="using:MiaDock.App.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Loaded="OnLoaded"
    KeyDown="OnPlacementKeyDown"
    Unloaded="OnUnloaded">

  <Grid x:Name="LayoutRoot"
        Padding="16,8,16,6"
        RowSpacing="7"
        AutomationProperties.LiveSetting="Polite">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TimeText"
                 VerticalAlignment="Center"
                 Style="{StaticResource DockDisplayTextStyle}"
                 FontFamily="Segoe UI Variable Display"
                 FontSize="30"
                 FontWeight="Bold"
                 Foreground="{ThemeResource IslandTextPrimaryBrush}" />
      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center"
                  Spacing="0">
        <TextBlock x:Name="DateText"
                   FontFamily="Segoe UI Variable Text"
                   FontSize="17"
                   FontWeight="SemiBold"
                   MaxLines="1" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource IslandTextPrimaryBrush}" />
        <TextBlock Text="{Binding NetworkStatus}"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockCaptionTextStyle}" />
      </StackPanel>
      <ScrollViewer Grid.Column="2" MaxWidth="156" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FavoriteButtons" Orientation="Horizontal" Spacing="8"
                    AutomationProperties.Name="Favori modüller" />
      </ScrollViewer>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="PlacementEditButton" Style="{StaticResource DockPlacementButtonStyle}" Click="OnPlacementEditClick"
                ToolTipService.ToolTip="Dock konumunu düzenle" AutomationProperties.Name="Dock konumunu düzenle">
          <icons:DockIcon Glyph="&#xE70F;" FontSize="15" />
        </Button>
        <Button x:Name="PlacementResetButton" Style="{StaticResource DockPlacementButtonStyle}" Visibility="Collapsed"
                Click="OnPlacementResetClick" ToolTipService.ToolTip="Varsayılan konuma dön" AutomationProperties.Name="Varsayılan konuma dön">
          <icons:DockIcon Glyph="&#xE777;" FontSize="15" />
        </Button>
        <primitives:Thumb x:Name="PlacementMoveHandle" Style="{StaticResource DockPlacementThumbStyle}" Visibility="Collapsed"
                DragStarted="OnPlacementDragStarted" DragDelta="OnPlacementDragMoved" DragCompleted="OnPlacementDragEnded"
                PointerCaptureLost="OnPlacementCaptureLost"
                KeyDown="OnPlacementMoveKeyDown" ToolTipService.ToolTip="Sağa veya sola sürükleyin; ok tuşlarıyla taşıyın"
                AutomationProperties.Name="Dock konumunu sağa veya sola taşı" />
        <Button x:Name="PlacementSaveButton" Style="{StaticResource AccentButtonStyle}" Width="32" MinWidth="32" Height="32" Padding="4"
                Visibility="Collapsed" Click="OnPlacementSaveClick" ToolTipService.ToolTip="Konumu kaydet" AutomationProperties.Name="Konumu kaydet">
          <icons:DockIcon Glyph="&#xE73E;" FontSize="15" />
        </Button>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
      <Button x:Name="NetworkCard"
              Padding="0"
              Background="Transparent"
              Command="{Binding ToggleWifiCommand}"
              ToolTipService.ToolTip="{Binding NetworkStatus}" AutomationProperties.Name="{Binding NetworkStatus}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <icons:DockIcon IsFilled="{Binding NetworkIsConnected}" Glyph="{Binding NetworkGlyph}"
                  FontSize="14"
                  Foreground="{Binding NetworkStatusBrush}" />
        <TextBlock Text="{Binding NetworkStatus}"
                   MaxWidth="122"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockStatusTextStyle}" />
        </StackPanel>
      </Button>

      <Border Width="1" Height="20" Background="{ThemeResource DockDividerBrush}" />

      <Button x:Name="BluetoothCard"
              Padding="0"
              Background="Transparent"
              Command="{Binding ToggleBluetoothCommand}"
              ToolTipService.ToolTip="{Binding BluetoothStatus}" AutomationProperties.Name="{Binding BluetoothStatus}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <icons:DockIcon IsFilled="{Binding BluetoothIsConnected}" Glyph="&#xE702;" FontSize="14" />
        <TextBlock Text="{Binding BluetoothStatus}"
                   MaxWidth="118"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockStatusTextStyle}" />
        </StackPanel>
      </Button>

      <icons:DockIcon IsFilled="True" Glyph="&#xE72E;"
                FontSize="14"
                Visibility="{Binding VpnVisibility}"
                ToolTipService.ToolTip="{Binding VpnStatus}"
                AutomationProperties.Name="{Binding VpnStatus}" />

      <Border Width="1" Height="20" Background="{ThemeResource DockDividerBrush}" />

      <StackPanel x:Name="BatteryCard"
                  Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
        <local:BatteryStatusIcon Width="22" Height="13" ChargePercent="{Binding BatterySnapshot.ChargePercent}"
                                 IsCharging="{Binding BatterySnapshot.IsCharging}" HasReading="{Binding BatterySnapshot.HasReading}"
                                 IsBatteryPresent="{Binding BatterySnapshot.IsBatteryPresent}" AutomationProperties.Name="{Binding BatteryStatus}" />
        <TextBlock Text="{Binding BatteryText}"
                   MaxLines="1"
                   Style="{StaticResource DockStatusTextStyle}" />
      </StackPanel>

      <Border Width="1" Height="20" Background="{ThemeResource DockDividerBrush}" />

      <Grid x:Name="SystemCard" VerticalAlignment="Center">
        <StackPanel x:Name="SystemStatusPanel"
                    Orientation="Horizontal"
                    Spacing="6">
          <icons:DockIcon IsFilled="{Binding Snapshot.IsMasterMuted}" Glyph="{Binding MasterVolumeGlyph}" FontSize="14" />
          <TextBlock Text="{Binding MasterVolumeText}"
                     MaxLines="1"
                     Style="{StaticResource DockStatusTextStyle}" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FocusColumn" Width="170" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="FocusCard"
              Style="{StaticResource DockSectionStyle}"
              Padding="10,6">
        <local:FocusQuickPanel x:Name="FocusPanel" />
      </Border>

      <Border x:Name="MusicPanel"
              Grid.Column="1"
              Style="{StaticResource DockSectionStyle}"
              Padding="10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="142" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Width="142" Height="142" VerticalAlignment="Center">
            <Border x:Name="EmptyArtwork"
                    Background="{ThemeResource IslandSurfaceSecondaryBrush}"
                    BorderBrush="{ThemeResource DockSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16" />
            <local:AlbumArtwork x:Name="MediaArtwork"
                                Width="142"
                                Height="142" />
          </Grid>

          <Grid Grid.Column="1" RowSpacing="5">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid>
              <TextBlock Text="Şimdi Çalıyor"
                         Style="{StaticResource DockCaptionTextStyle}" />
              <local:AudioActivityIndicator x:Name="MusicActivity"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource IslandTextPrimaryBrush}"
                                            TrebleLevel="{Binding TrebleAudioLevel}"
                                            BassLevel="{Binding BassAudioLevel}"
                                            VocalLevel="{Binding VocalAudioLevel}"
                                            AudioLevelSource="{Binding AudioLevelSource}"
                                            AmplitudeLevel="{Binding AudioAmplitude}"
                                            IsPlaying="{Binding IsPlaying}"
                                            IsAudioAvailable="{Binding IsAudioLevelAvailable}" />
            </Grid>

            <StackPanel x:Name="MediaMetadataPanel"
                        Grid.Row="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Spacing="2">
              <TextBlock Text="{Binding Current.Track.Title}"
                         MaxLines="2"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockTitleTextStyle}"
                         ToolTipService.ToolTip="{Binding Current.Track.Title}" />
              <TextBlock Text="{Binding Current.Track.Artist}"
                         MaxLines="1"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockCaptionTextStyle}"
                         ToolTipService.ToolTip="{Binding Current.Track.Artist}" />
            </StackPanel>

            <StackPanel x:Name="MediaEmptyPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Spacing="3">
              <TextBlock Text="Şu an çalınan medya yok"
                         MaxLines="2"
                         Style="{StaticResource DockTitleTextStyle}" />
              <TextBlock Text="Desteklenen bir uygulamada medya oynatın."
                         MaxLines="2"
                         Style="{StaticResource DockCaptionTextStyle}" />
            </StackPanel>

            <local:MediaTimeline Grid.Row="2" IsCompact="True" />

            <local:MediaTransportControls Grid.Row="3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
