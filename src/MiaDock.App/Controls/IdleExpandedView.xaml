<UserControl
    x:Class="MiaDock.App.Controls.IdleExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <Grid x:Name="LayoutRoot"
        Padding="16,4,16,12"
        RowSpacing="9"
        AutomationProperties.LiveSetting="Polite">
    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TimeText"
                 VerticalAlignment="Center"
                 FontFamily="Segoe UI Variable Display"
                 FontSize="30"
                 FontWeight="SemiBold"
                 Foreground="{ThemeResource IslandTextPrimaryBrush}" />
      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center"
                  Spacing="1">
        <TextBlock x:Name="DateText"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource IslandTextPrimaryBrush}" />
        <TextBlock Text="{Binding StatusSummary}"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource IslandCaptionTextStyle}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="NetworkCard"
              Padding="8,7"
              Background="{ThemeResource IslandStyleControlBrush}"
              CornerRadius="10">
        <StackPanel Spacing="4">
          <FontIcon Glyph="{Binding NetworkGlyph}"
                    HorizontalAlignment="Left"
                    FontSize="15"
                    Foreground="{Binding NetworkStatusBrush}" />
          <TextBlock Text="{Binding NetworkStatus}"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     FontSize="9"
                     Foreground="{ThemeResource IslandTextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <Border x:Name="BatteryCard"
              Grid.Column="1"
              Padding="8,7"
              Background="{ThemeResource IslandStyleControlBrush}"
              CornerRadius="10"
              Visibility="{Binding BatteryVisibility}">
        <StackPanel Spacing="4">
          <FontIcon Glyph="{Binding BatteryGlyph}"
                    HorizontalAlignment="Left"
                    FontSize="15" />
          <TextBlock Text="{Binding BatteryText}"
                     FontSize="9"
                     Foreground="{ThemeResource IslandTextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <Border x:Name="BluetoothCard"
              Grid.Column="2"
              Padding="8,7"
              Background="{ThemeResource IslandStyleControlBrush}"
              CornerRadius="10">
        <StackPanel Spacing="4">
          <FontIcon Glyph="&#xE702;"
                    HorizontalAlignment="Left"
                    FontSize="15" />
          <TextBlock Text="{Binding BluetoothStatus}"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     FontSize="9"
                     Foreground="{ThemeResource IslandTextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <Border x:Name="SystemCard"
              Grid.Column="3"
              Padding="8,7"
              Background="{ThemeResource IslandStyleControlBrush}"
              CornerRadius="10">
        <StackPanel x:Name="SystemStatusPanel" Spacing="4">
          <FontIcon Glyph="{Binding MasterVolumeGlyph}"
                    HorizontalAlignment="Left"
                    FontSize="15" />
          <TextBlock Text="{Binding MasterVolumeText}"
                     FontSize="9"
                     Foreground="{ThemeResource IslandTextSecondaryBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="MusicPanel"
            Grid.Row="2"
            Padding="11,8"
            Background="{ThemeResource IslandStyleControlBrush}"
            CornerRadius="12">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE8D6;"
                  VerticalAlignment="Center"
                  FontSize="18"
                  Foreground="{ThemeResource IslandTextPrimaryBrush}" />
        <StackPanel Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Spacing="1">
          <TextBlock Text="{Binding Current.Track.Title}"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource IslandTextPrimaryBrush}" />
          <TextBlock Text="{Binding Current.Track.Artist}"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     FontSize="9"
                     Foreground="{ThemeResource IslandTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="3">
          <Button Width="28" Height="28"
                  Style="{StaticResource IslandCompactIconButtonStyle}"
                  Command="{Binding PreviousCommand}"
                  ToolTipService.ToolTip="Önceki parça"
                  AutomationProperties.Name="Önceki parça">
            <FontIcon Glyph="&#xE892;" FontSize="10" />
          </Button>
          <Button Width="30" Height="30"
                  Style="{StaticResource IslandCompactIconButtonStyle}"
                  Command="{Binding PlayPauseCommand}"
                  ToolTipService.ToolTip="Oynat veya duraklat"
                  AutomationProperties.Name="Oynat veya duraklat">
            <FontIcon Glyph="{Binding PlaybackGlyph}" FontSize="11" />
          </Button>
          <Button Width="28" Height="28"
                  Style="{StaticResource IslandCompactIconButtonStyle}"
                  Command="{Binding NextCommand}"
                  ToolTipService.ToolTip="Sonraki parça"
                  AutomationProperties.Name="Sonraki parça">
            <FontIcon Glyph="&#xE893;" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="IdlePanel"
            Grid.Row="2"
            Padding="12"
            Background="{ThemeResource IslandStyleControlBrush}"
            CornerRadius="12">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE823;"
                  VerticalAlignment="Center"
                  FontSize="17"
                  Foreground="{ThemeResource IslandStyleAccentBrush}" />
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
          <TextBlock Text="Ana dock"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource IslandTextPrimaryBrush}" />
          <TextBlock Text="Bir modüle geçmek için üstteki simgeleri veya kaydırmayı kullanın."
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     FontSize="9"
                     Foreground="{ThemeResource IslandTextSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
