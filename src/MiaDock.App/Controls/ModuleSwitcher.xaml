<UserControl x:Class="MiaDock.App.Controls.ModuleSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:MiaDock.App.Animations"
             AutomationProperties.Name="Modüller arasında geçiş"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             KeyDown="OnKeyDown"
             PointerWheelChanged="OnPointerWheelChanged"
             ManipulationMode="TranslateX"
             ManipulationCompleted="OnManipulationCompleted">
  <Border x:Name="SwitcherRoot"
          Height="48"
          Style="{StaticResource DockSectionStyle}"
          Background="Transparent"
          BorderBrush="Transparent"
          BorderThickness="0"
          Padding="2">
    <Grid ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="44" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="44" />
      </Grid.ColumnDefinitions>

      <Button Width="44"
              Height="44"
              Style="{StaticResource ModuleSwitcherArrowStyle}"
              animations:MicroMotion.IsInteractive="True"
              Click="OnPreviousClick"
              ToolTipService.ToolTip="Önceki modül"
              AutomationProperties.Name="Önceki modül">
        <FontIcon Glyph="&#xE76B;" FontSize="14" />
      </Button>

      <Grid x:Name="TabViewport" Grid.Column="1">
        <ScrollViewer x:Name="TabScrollViewer"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="DefaultButton"
                    Width="44"
                    Height="44"
                    Style="{StaticResource ModuleSwitcherItemStyle}"
                    animations:MicroMotion.IsInteractive="True"
                    Click="OnDefaultClick"
                    ToolTipService.ToolTip="Ana dock"
                    AutomationProperties.Name="Ana dock">
              <FontIcon x:Name="DefaultIcon"
                        Glyph="&#xE80F;"
                        FontSize="17"
                        Foreground="{ThemeResource IslandTextSecondaryBrush}" />
            </Button>
            <StackPanel x:Name="ModuleButtons" Orientation="Horizontal" Spacing="4" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Button Grid.Column="2"
              Width="44"
              Height="44"
              Style="{StaticResource ModuleSwitcherArrowStyle}"
              animations:MicroMotion.IsInteractive="True"
              Click="OnNextClick"
              ToolTipService.ToolTip="Sonraki modül"
              AutomationProperties.Name="Sonraki modül">
        <FontIcon Glyph="&#xE76C;" FontSize="14" />
      </Button>
    </Grid>
  </Border>
</UserControl>
