<UserControl x:Class="MiaDock.App.Controls.NotificationModuleNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockNotificationLayoutStyle}"
        AutomationProperties.Name="{Binding SecondaryText}"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Style="{StaticResource DockNotificationIconContainerStyle}">
      <FontIcon Glyph="{Binding LeadingGlyph}"
                Style="{StaticResource DockModuleIconStyle}" />
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
      <TextBlock Text="{Binding PrimaryText}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockCaptionTextStyle}"
                 ToolTipService.ToolTip="{Binding PrimaryText}" />
      <TextBlock Text="{Binding SecondaryText}" Style="{StaticResource DockTitleTextStyle}"
                 MaxLines="1" TextTrimming="CharacterEllipsis"
                 ToolTipService.ToolTip="{Binding SecondaryText}" />
      <TextBlock Text="{Binding ValueText}" Style="{StaticResource DockCaptionTextStyle}"
                 MaxLines="1" TextTrimming="CharacterEllipsis"
                 ToolTipService.ToolTip="{Binding ValueText}" />
    </StackPanel>
  </Grid>
</UserControl>
