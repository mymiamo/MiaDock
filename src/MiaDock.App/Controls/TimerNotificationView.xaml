<UserControl x:Class="MiaDock.App.Controls.TimerNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="14,0" ColumnSpacing="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE823;" FontSize="22" Foreground="{ThemeResource IslandStyleAccentBrush}" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="Süre doldu" FontWeight="SemiBold" Foreground="{ThemeResource IslandTextPrimaryBrush}" />
      <TextBlock Text="Zamanlayıcı tamamlandı" Style="{StaticResource IslandCaptionTextStyle}" />
    </StackPanel>
    <Button x:Name="SilenceAlarmButton"
            Grid.Column="2"
            MinWidth="108"
            Height="34"
            Padding="10,0"
            IsTabStop="True"
            Style="{StaticResource IslandCompactIconButtonStyle}"
            Command="{Binding CompactSecondaryCommand}"
            ToolTipService.ToolTip="{Binding CompactSecondaryText}"
            AutomationProperties.Name="{Binding CompactSecondaryText}"
            AutomationProperties.HelpText="{Binding CompactSecondaryText}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon Glyph="&#xE7ED;" FontSize="13" />
        <TextBlock Text="{Binding CompactSecondaryText}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
