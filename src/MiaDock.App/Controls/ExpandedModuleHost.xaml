<UserControl x:Class="MiaDock.App.Controls.ExpandedModuleHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="64" />
    </Grid.RowDefinitions>

    <Border x:Name="HeaderBar"
            Margin="16,8,16,0"
            Style="{StaticResource DockModuleHeaderStyle}"
            Visibility="Collapsed">
      <Grid Height="42" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="HeaderGlyph"
                  Width="18"
                  VerticalAlignment="Center"
                  FontSize="18"
                  Foreground="{ThemeResource IslandStyleAccentBrush}" />
        <TextBlock x:Name="HeaderTitle"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   FontSize="17"
                   Style="{StaticResource DockTitleTextStyle}" />
        <Border Grid.Column="2"
                HorizontalAlignment="Right"
                Style="{StaticResource DockStatusBadgeStyle}">
          <TextBlock x:Name="HeaderStatus"
                     MaxWidth="220"
                     VerticalAlignment="Center"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     Style="{StaticResource DockStatusTextStyle}" />
        </Border>
      </Grid>
    </Border>

    <ContentControl x:Name="ViewHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />

    <controls:ModuleSwitcher x:Name="Switcher"
                             Grid.Row="2"
                             Margin="12,6,12,10"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Bottom"
                             PreviousRequested="OnPreviousRequested"
                             NextRequested="OnNextRequested"
                             DefaultRequested="OnDefaultRequested"
                             ModuleSelected="OnModuleSelected" />
  </Grid>
</UserControl>
