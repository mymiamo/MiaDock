<UserControl x:Class="MiaDock.App.Controls.ExpandedModuleHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls">
  <Grid RowSpacing="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:ModuleSwitcher x:Name="Switcher"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             PreviousRequested="OnPreviousRequested"
                             NextRequested="OnNextRequested"
                             ModuleSelected="OnModuleSelected" />
    <ContentControl x:Name="ViewHost" Grid.Row="1"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</UserControl>
