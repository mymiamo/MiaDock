<UserControl x:Class="MiaDock.App.Controls.ClipboardPeekCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:MiaDock.App.Animations"
             xmlns:controls="using:MiaDock.App.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>

  <Grid Style="{StaticResource DockCompactModuleLayoutStyle}"
        animations:MicroMotion.StateKey="{Binding PresentationVisualKey}"
        AutomationProperties.Name="{Binding SafeCurrentAutomationText}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="26" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Width="22" Height="22" VerticalAlignment="Center">
      <Border CornerRadius="6"
              Background="{ThemeResource DockStatusNeutralFillBrush}"
              Visibility="{Binding HasPrimaryVisualPreview, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}">
        <FontIcon Glyph="{Binding CurrentTypeGlyph}"
                  FontSize="13"
                  Foreground="{ThemeResource IslandStyleAccentBrush}"
                  AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border CornerRadius="6"
              Background="{Binding ColorPreviewBrush}"
              BorderBrush="{ThemeResource DockSurfaceStrokeBrush}"
              BorderThickness="1"
              Visibility="{Binding HasColorPreview, Converter={StaticResource BooleanToVisibility}}"
              AutomationProperties.AccessibilityView="Raw" />
      <Border CornerRadius="6"
              Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibility}}"
              AutomationProperties.AccessibilityView="Raw">
        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
      </Border>
    </Grid>

    <TextBlock Grid.Column="1"
               Text="{Binding CurrentDisplayText}"
               MaxLines="1"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center"
               Style="{StaticResource DockBodyTextStyle}" />
    <TextBlock Grid.Column="2"
               Text="{Binding CompactDetailText}"
               MaxLines="1"
               MaxWidth="90"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center"
               Style="{StaticResource DockStatusTextStyle}" />
  </Grid>
</UserControl>
