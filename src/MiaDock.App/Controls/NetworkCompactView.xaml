<UserControl x:Class="MiaDock.App.Controls.NetworkCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <Grid Padding="14,0" ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <FontIcon x:Name="NetworkIcon" Glyph="{Binding NetworkGlyph}" FontSize="15"
              AutomationProperties.Name="{Binding ConnectivityText}" />
    <TextBlock Grid.Column="1" Text="{Binding ConnectivityText}" VerticalAlignment="Center" Style="{StaticResource IslandBodyTextStyle}" />
    <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" VerticalAlignment="Center" Style="{StaticResource IslandCaptionTextStyle}" />
  </Grid>
</UserControl>
