<UserControl
    x:Class="MiaDock.App.Controls.EdgeRevealStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiaDock.App.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <UserControl.Resources>
    <Storyboard x:Name="ActivityPulseStoryboard" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="ActivityPulse"
                       Storyboard.TargetProperty="Opacity"
                       From="0.14" To="0.5" Duration="0:0:1.2"
                       AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="ActivityPulseScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="0.72" To="1" Duration="0:0:1.2"
                       AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="ActivityPulseScale"
                       Storyboard.TargetProperty="ScaleY"
                       From="0.72" To="1" Duration="0:0:1.2"
                       AutoReverse="True" />
    </Storyboard>
  </UserControl.Resources>

  <Grid x:Name="LayoutRoot"
        Height="15"
        Padding="8,0"
        Background="Transparent"
        AutomationProperties.LiveSetting="Polite">
    <StackPanel x:Name="LeftIndicators"
                Orientation="Horizontal"
                Spacing="5"
                Margin="0,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
      <Grid Width="8"
            Height="8"
            AutomationProperties.AccessibilityView="Raw">
        <Ellipse x:Name="ActivityPulse"
                 Fill="{ThemeResource IslandStyleAccentBrush}"
                 Opacity="0.22"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform x:Name="ActivityPulseScale" />
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="ActivityDot"
                 Width="4"
                 Height="4"
                 Fill="{ThemeResource IslandStyleAccentBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
      </Grid>

    </StackPanel>

    <Border x:Name="RevealGrip"
            Width="36"
            Height="2"
            Background="#CCFFFFFF"
            CornerRadius="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw" />

    <StackPanel x:Name="StatusTray"
                Orientation="Horizontal"
                Spacing="3"
                Margin="0,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
      <FontIcon Glyph="{Binding NetworkGlyph}"
                Width="11"
                Height="11"
                FontFamily="Segoe Fluent Icons"
                FontSize="10"
                Opacity="{Binding NetworkOpacity}"
                Foreground="{Binding NetworkStatusBrush}"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{Binding NetworkStatus}"
                AutomationProperties.Name="{Binding NetworkStatus}" />

      <FontIcon Glyph="&#xE72E;"
                Width="11"
                Height="11"
                FontFamily="Segoe Fluent Icons"
                FontSize="10"
                Foreground="{ThemeResource IslandTextPrimaryBrush}"
                VerticalAlignment="Center"
                Visibility="{Binding VpnVisibility}"
                ToolTipService.ToolTip="{Binding VpnStatus}"
                AutomationProperties.Name="{Binding VpnStatus}" />

      <FontIcon x:Name="CallActivityIcon"
                Glyph="&#xE717;"
                Width="11"
                Height="11"
                FontFamily="Segoe Fluent Icons"
                FontSize="10"
                Foreground="{ThemeResource IslandStyleAccentBrush}"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Olası arama etkinliği"
                AutomationProperties.Name="Olası arama etkinliği" />

      <StackPanel Orientation="Horizontal"
                  Spacing="1"
                  Visibility="{Binding BluetoothVisibility}"
                  ToolTipService.ToolTip="{Binding BluetoothStatus}"
                  AutomationProperties.Name="{Binding BluetoothStatus}">
        <FontIcon Glyph="&#xE702;"
                  Width="11"
                  Height="11"
                  FontFamily="Segoe Fluent Icons"
                  FontSize="10"
                  Foreground="{ThemeResource IslandTextPrimaryBrush}" />
        <TextBlock Text="{Binding BluetoothCountText}"
                   MaxLines="1"
                   FontSize="7"
                   Foreground="{ThemeResource IslandTextPrimaryBrush}"
                   VerticalAlignment="Center"
                   Opacity="0.86" />
      </StackPanel>

      <StackPanel Orientation="Horizontal"
                  Spacing="1"
                  Visibility="{Binding BatteryVisibility}"
                  ToolTipService.ToolTip="{Binding BatteryStatus}"
                  AutomationProperties.Name="{Binding BatteryStatus}">
        <FontIcon Glyph="{Binding BatteryGlyph}"
                  Width="11"
                  Height="11"
                  FontFamily="Segoe Fluent Icons"
                  FontSize="10"
                  Foreground="{ThemeResource IslandTextPrimaryBrush}" />
        <TextBlock Text="{Binding BatteryText}"
                   MaxLines="1"
                   FontSize="7"
                   Foreground="{ThemeResource IslandTextPrimaryBrush}"
                   VerticalAlignment="Center"
                   Opacity="0.86" />
      </StackPanel>

      <local:AudioActivityIndicator x:Name="MusicActivity"
                                    Width="9"
                                    Height="10"
                                    Foreground="{ThemeResource IslandTextPrimaryBrush}"
                                    Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</UserControl>
