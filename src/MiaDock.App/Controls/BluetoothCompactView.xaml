<UserControl x:Class="MiaDock.App.Controls.BluetoothCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="14,0" ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE702;" FontSize="15" Foreground="{ThemeResource IslandStyleAccentBrush}" />
    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource IslandBodyTextStyle}" />
  </Grid>
</UserControl>
