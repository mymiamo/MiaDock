<UserControl
    x:Class="MiaDock.App.Controls.VolumeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons">

  <StackPanel Orientation="Horizontal" Spacing="8">
    <icons:DockIcon Glyph="{Binding VolumeGlyph}" IsFilled="{Binding IsVolumeSilent}"
              FontSize="15"
              Foreground="{ThemeResource IslandTextSecondaryBrush}"
              AutomationProperties.AccessibilityView="Raw" />
    <Slider Width="90"
            Minimum="0"
            Maximum="100"
            Value="{Binding VolumePercent, Mode=OneWay}"
            IsEnabled="{Binding Current.Capabilities.CanChangeVolume}"
            AutomationProperties.Name="Ses seviyesi" />
  </StackPanel>
</UserControl>
