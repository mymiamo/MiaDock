<UserControl x:Class="MiaDock.App.Controls.ModuleAvailabilityBadge"
             x:Name="RootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="#25334B" BorderBrush="#405171" BorderThickness="1"
          CornerRadius="12" Padding="8,4">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <FontIcon Glyph="{Binding Glyph, ElementName=RootControl}" FontSize="11" />
      <TextBlock Text="{Binding Text, ElementName=RootControl}" FontSize="11"
                 VerticalAlignment="Center" MaxLines="1" />
    </StackPanel>
  </Border>
</UserControl>
