<UserControl x:Class="MiaDock.App.Controls.ModuleAvailabilityBadge"
             x:Name="RootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource DockStatusBadgeStyle}">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <FontIcon Glyph="{Binding Glyph, ElementName=RootControl}" FontSize="11" />
      <TextBlock Text="{Binding Text, ElementName=RootControl}"
                 Style="{StaticResource DockStatusTextStyle}"
                 VerticalAlignment="Center"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 ToolTipService.ToolTip="{Binding Text, ElementName=RootControl}" />
    </StackPanel>
  </Border>
</UserControl>
