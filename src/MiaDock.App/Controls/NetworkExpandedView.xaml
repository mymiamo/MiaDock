<UserControl x:Class="MiaDock.App.Controls.NetworkExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding ConnectivityText}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="7" Margin="3,0,3,2">
      <Border Style="{StaticResource DockStatusBadgeStyle}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon x:Name="NetworkIcon" Glyph="{Binding NetworkGlyph}" FontSize="13" />
          <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource DockStatusTextStyle}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource DockStatusBadgeStyle}">
        <TextBlock Text="{Binding CostText}" Style="{StaticResource DockStatusTextStyle}" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource DockSectionStyle}" Padding="14,12">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74B;" FontSize="18" Foreground="{ThemeResource IslandStyleAccentBrush}"/><TextBlock Text="İndirme" Style="{StaticResource DockModuleHeaderTextStyle}"/></StackPanel>
          <TextBlock Text="{Binding DownloadText}" Style="{StaticResource DockMetricTextStyle}" AutomationProperties.Name="İndirme hızı" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource DockSectionStyle}" Padding="14,12">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74A;" FontSize="18" Foreground="{ThemeResource IslandStyleAccentBrush}"/><TextBlock Text="Yükleme" Style="{StaticResource DockModuleHeaderTextStyle}"/></StackPanel>
          <TextBlock Text="{Binding UploadText}" Style="{StaticResource DockMetricTextStyle}" AutomationProperties.Name="Yükleme hızı" />
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Margin="4,1,4,0" Orientation="Horizontal" Spacing="6">
      <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource IslandTextSecondaryBrush}" />
      <TextBlock Text="{Binding ThroughputStatusText}" Style="{StaticResource DockCaptionTextStyle}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </Grid>
</UserControl>
