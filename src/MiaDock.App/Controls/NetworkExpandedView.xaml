<UserControl x:Class="MiaDock.App.Controls.NetworkExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:MiaDock.App.Animations"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding ConnectivityText}"
        animations:MicroMotion.StateKey="{Binding ConnectivityText}">
    <StackPanel Spacing="12">
      <Border Style="{StaticResource DockHeroSectionStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource DockHeroIconContainerStyle}">
            <FontIcon x:Name="NetworkIcon" Glyph="{Binding NetworkGlyph}"
                      FontSize="22" Foreground="{ThemeResource IslandStyleAccentBrush}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding ConnectivityText}"
                       Style="{StaticResource DockTitleTextStyle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ConnectionText}"
                       Style="{StaticResource DockCaptionTextStyle}" />
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource DockStatusBadgeStyle}">
            <TextBlock Text="{Binding CostText}" Style="{StaticResource DockStatusTextStyle}" />
          </Border>
        </Grid>
      </Border>

      <Border Style="{StaticResource DockGroupedSectionStyle}">
        <StackPanel>
          <Border Style="{StaticResource DockGroupedRowStyle}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE74B;" FontSize="16" Foreground="{ThemeResource IslandStyleAccentBrush}" />
              <TextBlock Grid.Column="1" Text="İndirme" VerticalAlignment="Center"
                         Style="{StaticResource DockBodyTextStyle}" />
              <TextBlock Grid.Column="2" Text="{Binding DownloadText}"
                         VerticalAlignment="Center" Style="{StaticResource DockMetricTextStyle}"
                         AutomationProperties.Name="İndirme hızı" />
            </Grid>
          </Border>
          <Border Style="{StaticResource DockInsetDividerStyle}" />
          <Border Style="{StaticResource DockGroupedRowStyle}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE74A;" FontSize="16" Foreground="{ThemeResource IslandStyleAccentBrush}" />
              <TextBlock Grid.Column="1" Text="Yükleme" VerticalAlignment="Center"
                         Style="{StaticResource DockBodyTextStyle}" />
              <TextBlock Grid.Column="2" Text="{Binding UploadText}"
                         VerticalAlignment="Center" Style="{StaticResource DockMetricTextStyle}"
                         AutomationProperties.Name="Yükleme hızı" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Margin="4,0" Orientation="Horizontal" Spacing="6">
        <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource IslandTextSecondaryBrush}" />
        <TextBlock Text="{Binding ThroughputStatusText}"
                   Style="{StaticResource DockCaptionTextStyle}"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
