<UserControl
    x:Class="MiaDock.App.Controls.StoreUpdateNotificationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockNotificationLayoutStyle}"
        AutomationProperties.LiveSetting="Polite"
        AutomationProperties.Name="{Binding PrimaryText}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="34" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border Style="{StaticResource DockNotificationIconContainerStyle}">
      <FontIcon Glyph="&#xE895;" Style="{StaticResource DockModuleIconStyle}" />
    </Border>
    <StackPanel Grid.Column="1"
                MinWidth="0"
                VerticalAlignment="Center"
                Spacing="2">
      <TextBlock Text="{Binding PrimaryText}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockTitleTextStyle}"
                 ToolTipService.ToolTip="{Binding PrimaryText}" />
      <TextBlock Text="{Binding SecondaryText}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockCaptionTextStyle}"
                 ToolTipService.ToolTip="{Binding SecondaryText}" />
    </StackPanel>
    <Button Grid.Column="2"
            Content="Microsoft Store'da aç"
            Click="OnOpenStoreClick"
            MinHeight="44"
            Style="{StaticResource DockInlineButtonStyle}"
            VerticalAlignment="Center"
            AutomationProperties.Name="Microsoft Store'da aç" />
  </Grid>
</UserControl>
