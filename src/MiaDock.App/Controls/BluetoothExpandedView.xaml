<UserControl x:Class="MiaDock.App.Controls.BluetoothExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:MiaDock.App.Animations">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding StatusText}"
        animations:MicroMotion.StateKey="{Binding StatusText}">
    <StackPanel Spacing="12">
      <Border Style="{StaticResource DockHeroSectionStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource DockHeroIconContainerStyle}">
            <FontIcon Glyph="&#xE702;" FontSize="22"
                      Foreground="{ThemeResource IslandStyleAccentBrush}" />
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                     MaxLines="2" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Style="{StaticResource DockTitleTextStyle}"
                     ToolTipService.ToolTip="{Binding StatusText}" />
        </Grid>
      </Border>

      <Border Style="{StaticResource DockGroupedSectionStyle}"
              AutomationProperties.Name="Bağlı Bluetooth cihazları">
        <ItemsControl ItemsSource="{Binding ConnectedDevices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource DockGroupedRowStyle}">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="8"
                          Background="{ThemeResource DockStatusNeutralFillBrush}">
                    <FontIcon Glyph="&#xE702;" FontSize="14"
                              Foreground="{ThemeResource IslandStyleAccentBrush}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                             VerticalAlignment="Center" MaxLines="1"
                             TextTrimming="CharacterEllipsis"
                             Style="{StaticResource DockBodyTextStyle}"
                             ToolTipService.ToolTip="{Binding DisplayName}" />
                  <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="11"
                            Foreground="{ThemeResource IslandTextSecondaryBrush}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
