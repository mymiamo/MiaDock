<UserControl x:Class="MiaDock.App.Controls.BluetoothExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding StatusText}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource DockSectionStyle}" Padding="12,10">
      <Grid ColumnSpacing="11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE702;"
                  FontSize="18"
                  Foreground="{ThemeResource IslandStyleAccentBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Bağlantı durumu" Style="{StaticResource DockModuleHeaderTextStyle}" />
        <TextBlock Text="{Binding StatusText}"
                   MaxLines="1" TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockCaptionTextStyle}"
                   ToolTipService.ToolTip="{Binding StatusText}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Style="{StaticResource DockSectionStyle}"
            Padding="7">
      <ListView ItemsSource="{Binding ConnectedDevices}"
                SelectionMode="None"
                MaxHeight="108"
                AutomationProperties.Name="Bağlı Bluetooth cihazları">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid MinHeight="34" Padding="7,3" ColumnSpacing="9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="7"
                       Height="7"
                       Fill="{ThemeResource IslandAccentBrush}"
                       VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding DisplayName}"
                         VerticalAlignment="Center"
                         MaxLines="1"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockBodyTextStyle}"
                         ToolTipService.ToolTip="{Binding DisplayName}" />
              <FontIcon Grid.Column="2"
                        Glyph="&#xE73E;"
                        FontSize="11"
                        Foreground="{ThemeResource IslandTextSecondaryBrush}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>
  </Grid>
</UserControl>
