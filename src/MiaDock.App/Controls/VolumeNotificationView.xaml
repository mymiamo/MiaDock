<UserControl x:Class="MiaDock.App.Controls.VolumeNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>

  <Grid Style="{StaticResource DockNotificationLayoutStyle}"
        AutomationProperties.Name="{Binding TitleText}"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Button x:Name="MuteButton"
            Width="44"
            Height="44"
            Style="{StaticResource DockIconButtonStyle}"
            Command="{Binding ToggleMuteCommand}"
            ToolTipService.ToolTip="Sesi aç veya kapat"
            AutomationProperties.Name="Windows ana sesini aç veya kapat"
            AutomationProperties.HelpText="Windows ana sesinin sessiz durumunu değiştirir.">
      <FontIcon Glyph="{Binding VolumeGlyph}"
                FontSize="20"
                Foreground="{ThemeResource IslandStyleAccentBrush}" />
    </Button>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding TitleText}"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     Style="{StaticResource DockTitleTextStyle}"
                     ToolTipService.ToolTip="{Binding TitleText}" />
          <TextBlock Text="{Binding OutputDeviceText}"
                     Visibility="{Binding IsOutputDeviceVisible, Converter={StaticResource BooleanToVisibility}}"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     Style="{StaticResource DockCaptionTextStyle}"
                     ToolTipService.ToolTip="{Binding OutputDeviceText}" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding VolumeText}"
                   Style="{StaticResource DockStatusTextStyle}"
                   VerticalAlignment="Center"
                   ToolTipService.ToolTip="{Binding VolumeText}" />
      </Grid>
      <ProgressBar x:Name="VolumeProgress"
                   Minimum="0"
                   Maximum="100"
                   Value="{Binding Snapshot.MasterVolumePercent}"
                   Style="{StaticResource DockProgressBarStyle}"
                   IsHitTestVisible="False"
                   AutomationProperties.Name="Windows ana ses seviyesi" />
      <Slider x:Name="VolumeSlider"
              Minimum="0"
              Maximum="100"
              Value="{Binding Snapshot.MasterVolumePercent, Mode=OneWay}"
              IsEnabled="{Binding Snapshot.IsMasterVolumeAvailable}"
              ValueChanged="OnMasterVolumeChanged"
              Visibility="Collapsed"
              AutomationProperties.Name="Windows ana ses seviyesi" />
    </StackPanel>

    <Button x:Name="SettingsButton"
            Grid.Column="2"
            Width="44"
            Height="44"
            Visibility="Collapsed"
            Style="{StaticResource DockIconButtonStyle}"
            Command="{Binding OpenSoundSettingsFromUiCommand}"
            ToolTipService.ToolTip="Windows ses ayarlarını aç"
            AutomationProperties.Name="Windows ses ayarlarını aç">
      <FontIcon Glyph="&#xE713;" FontSize="14" />
    </Button>
  </Grid>
</UserControl>
