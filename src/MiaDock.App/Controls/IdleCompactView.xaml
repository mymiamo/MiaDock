<UserControl
    x:Class="MiaDock.App.Controls.IdleCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons"
    xmlns:local="using:MiaDock.App.Controls"
    xmlns:animations="using:MiaDock.App.Animations"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <Grid x:Name="LayoutRoot"
        Padding="12,0"
        ColumnSpacing="10"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Width="8" Height="8" VerticalAlignment="Center"
          animations:MicroMotion.StateKey="{Binding SummaryText}"
          AutomationProperties.AccessibilityView="Raw">
      <Ellipse x:Name="IdlePulse" Fill="{ThemeResource IslandStyleAccentBrush}" Opacity="0.22"
               RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform><ScaleTransform x:Name="IdlePulseScale" /></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="ActivityDot" Width="4" Height="4"
               Fill="{ThemeResource IslandStyleAccentBrush}" />
    </Grid>

    <TextBlock x:Name="TimeText"
               Grid.Column="1"
               VerticalAlignment="Center"
               Style="{StaticResource DockTitleTextStyle}"
               AutomationProperties.AccessibilityView="Raw" />

    <Border x:Name="DateContainer"
            Grid.Column="2"
            MinWidth="0"
            Padding="10,0,0,0"
            VerticalAlignment="Center"
            BorderBrush="{ThemeResource IslandStrokeBrush}"
            BorderThickness="1,0,0,0">
      <TextBlock x:Name="DateText"
                 VerticalAlignment="Center"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockCaptionTextStyle}"
                 Opacity="0.82"
                 AutomationProperties.AccessibilityView="Raw" />
    </Border>

    <StackPanel x:Name="StatusTray" Grid.Column="3" Orientation="Horizontal" Spacing="6"
                 VerticalAlignment="Center">
      <icons:DockIcon IsFilled="{Binding NetworkIsConnected}" Glyph="{Binding NetworkGlyph}"
                Width="14"
                FontSize="13"
                Opacity="{Binding NetworkOpacity}"
                Foreground="{Binding NetworkStatusBrush}"
                animations:MicroMotion.StateKey="{Binding NetworkStatus}"
                ToolTipService.ToolTip="{Binding NetworkStatus}"
                AutomationProperties.Name="{Binding NetworkStatus}" />

      <icons:DockIcon IsFilled="True" Glyph="&#xE72E;"
                Width="14"
                FontSize="13"
                Foreground="{ThemeResource IslandTextPrimaryBrush}"
                Visibility="{Binding VpnVisibility}"
                ToolTipService.ToolTip="{Binding VpnStatus}"
                AutomationProperties.Name="{Binding VpnStatus}" />

      <icons:DockIcon IsFilled="True" x:Name="CallActivityIcon"
                Glyph="&#xE717;"
                Width="14"
                FontSize="13"
                Foreground="{ThemeResource IslandStyleAccentBrush}"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Olası arama etkinliği"
                AutomationProperties.Name="Olası arama etkinliği" />

      <StackPanel x:Name="BluetoothStatusIndicator"
                  Orientation="Horizontal"
                  Spacing="2"
                  Visibility="{Binding BluetoothVisibility}"
                  animations:MicroMotion.StateKey="{Binding BluetoothStatus}"
                  ToolTipService.ToolTip="{Binding BluetoothStatus}"
                  AutomationProperties.Name="{Binding BluetoothStatus}">
          <icons:DockIcon IsFilled="{Binding BluetoothIsConnected}" Glyph="&#xE702;"
                    Width="14"
                    FontSize="13"
                    Foreground="{ThemeResource IslandTextPrimaryBrush}" />
          <TextBlock Text="{Binding BluetoothCountText}"
                     MaxLines="1"
                     Style="{StaticResource DockCaptionTextStyle}"
                     VerticalAlignment="Center"
                     Opacity="0.82" />
      </StackPanel>

      <Grid x:Name="DockBatteryIndicator" Background="Transparent"
              VerticalAlignment="Center"
              Visibility="{Binding BatteryVisibility}"
              animations:MicroMotion.StateKey="{Binding BatteryStatus}"
              ToolTipService.ToolTip="{Binding BatteryStatus}"
              AutomationProperties.Name="{Binding BatteryStatus}">
          <local:BatteryStatusIcon Width="38" Height="16" ShowPercentage="True"
                                   Foreground="{ThemeResource IslandTextPrimaryBrush}"
                                   ChargePercent="{Binding BatterySnapshot.ChargePercent}"
                                   IsCharging="{Binding BatterySnapshot.IsCharging}" HasReading="{Binding BatterySnapshot.HasReading}"
                                   IsBatteryPresent="{Binding BatterySnapshot.IsBatteryPresent}" />
      </Grid>

      <local:FocusStatusBadge x:Name="FocusStatus"
                              VerticalAlignment="Center" />

      <local:AudioActivityIndicator x:Name="MusicActivity"
                                    Width="20"
                                    Height="14"
                                    Foreground="{ThemeResource IslandTextPrimaryBrush}"
                                    Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</UserControl>
