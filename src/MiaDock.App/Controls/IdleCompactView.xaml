<UserControl
    x:Class="MiaDock.App.Controls.IdleCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiaDock.App.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

  <UserControl.Resources>
    <Storyboard x:Name="IdlePulseStoryboard" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="IdlePulse"
                       Storyboard.TargetProperty="Opacity"
                       From="0.14" To="0.5" Duration="0:0:1.2"
                       AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="IdlePulseScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="0.72" To="1" Duration="0:0:1.2"
                       AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="IdlePulseScale"
                       Storyboard.TargetProperty="ScaleY"
                       From="0.72" To="1" Duration="0:0:1.2"
                       AutoReverse="True" />
    </Storyboard>
  </UserControl.Resources>

  <Grid x:Name="LayoutRoot"
        Padding="12,0"
        ColumnSpacing="10"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Width="8" Height="8" VerticalAlignment="Center"
          AutomationProperties.AccessibilityView="Raw">
      <Ellipse x:Name="IdlePulse" Fill="{ThemeResource IslandStyleAccentBrush}" Opacity="0.22"
               RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform><ScaleTransform x:Name="IdlePulseScale" /></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="ActivityDot" Width="4" Height="4"
               Fill="{ThemeResource IslandStyleAccentBrush}" />
    </Grid>

    <TextBlock x:Name="TimeText"
               Grid.Column="1"
               VerticalAlignment="Center"
               Style="{StaticResource DockTitleTextStyle}"
               AutomationProperties.AccessibilityView="Raw" />

    <Border x:Name="DateContainer"
            Grid.Column="2"
            MinWidth="0"
            Padding="10,0,0,0"
            VerticalAlignment="Center"
            BorderBrush="{ThemeResource IslandStrokeBrush}"
            BorderThickness="1,0,0,0">
      <TextBlock x:Name="DateText"
                 VerticalAlignment="Center"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockCaptionTextStyle}"
                 Opacity="0.82"
                 AutomationProperties.AccessibilityView="Raw" />
    </Border>

    <StackPanel x:Name="StatusTray" Grid.Column="3" Orientation="Horizontal" Spacing="6"
                 VerticalAlignment="Center">
      <FontIcon Glyph="{Binding NetworkGlyph}"
                Width="14"
                FontFamily="Segoe Fluent Icons"
                FontSize="13"
                Opacity="{Binding NetworkOpacity}"
                Foreground="{Binding NetworkStatusBrush}"
                ToolTipService.ToolTip="{Binding NetworkStatus}"
                AutomationProperties.Name="{Binding NetworkStatus}" />

      <FontIcon x:Name="CallActivityIcon"
                Glyph="&#xE717;"
                Width="14"
                FontFamily="Segoe Fluent Icons"
                FontSize="13"
                Foreground="{ThemeResource IslandStyleAccentBrush}"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Olası arama etkinliği"
                AutomationProperties.Name="Olası arama etkinliği" />

      <Border x:Name="BluetoothStatusIndicator"
              Padding="0"
              Visibility="{Binding BluetoothVisibility}"
              ToolTipService.ToolTip="{Binding BluetoothStatus}"
              AutomationProperties.Name="{Binding BluetoothStatus}">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <FontIcon Glyph="&#xE702;"
                    Width="14"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="13"
                    Foreground="{ThemeResource IslandTextPrimaryBrush}" />
          <TextBlock Text="{Binding BluetoothCountText}"
                     MaxLines="1"
                     Style="{StaticResource DockCaptionTextStyle}"
                     VerticalAlignment="Center"
                     Opacity="0.82" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource DockStatusBadgeStyle}"
              Padding="6,2"
              Visibility="{Binding BatteryVisibility}"
              ToolTipService.ToolTip="{Binding BatteryStatus}"
              AutomationProperties.Name="{Binding BatteryStatus}">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <FontIcon Glyph="{Binding BatteryGlyph}"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="11"
                    Foreground="{ThemeResource IslandStyleAccentBrush}" />
          <TextBlock Text="{Binding BatteryText}"
                     MaxLines="1"
                     Style="{StaticResource DockStatusTextStyle}"
                     VerticalAlignment="Center"
                     Foreground="{ThemeResource IslandTextPrimaryBrush}" />
        </StackPanel>
      </Border>

      <local:FocusStatusBadge x:Name="FocusStatus"
                              VerticalAlignment="Center" />

      <local:AudioActivityIndicator x:Name="MusicActivity"
                                    Width="10"
                                    Height="14"
                                    Foreground="{ThemeResource IslandTextPrimaryBrush}"
                                    Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</UserControl>
