<UserControl x:Class="MiaDock.App.Controls.TransferNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="18" ColumnSpacing="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border Width="42" Height="42" CornerRadius="14"
            Background="{ThemeResource IslandStyleControlBrush}">
      <FontIcon Glyph="&#xE896;" FontSize="21"
                Foreground="{ThemeResource IslandStyleAccentBrush}" />
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
      <TextBlock Text="{Binding PrimaryText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource IslandTitleTextStyle}" />
      <TextBlock Text="{Binding SecondaryText}" MaxLines="1"
                 Style="{StaticResource IslandBodyTextStyle}" />
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"
               Style="{StaticResource IslandCaptionTextStyle}" />
  </Grid>
</UserControl>
