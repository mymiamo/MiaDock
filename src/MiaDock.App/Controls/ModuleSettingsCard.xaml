<UserControl x:Class="MiaDock.App.Controls.ModuleSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls">
  <Border Style="{StaticResource SettingsCardBorderStyle}">
    <Grid RowSpacing="14" ColumnSpacing="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="42" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource SettingsIconTileBorderStyle}">
        <FontIcon Glyph="{Binding IconGlyph}" FontSize="18" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
          <controls:ModuleAvailabilityBadge Text="{Binding AvailabilityText}"
                                            Glyph="{Binding AvailabilityGlyph}" />
        </StackPanel>
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
      </StackPanel>
      <ToggleSwitch x:Name="EnabledToggle" Grid.Column="2" MinWidth="44" MinHeight="36"
                    IsOn="{Binding IsEnabled, Mode=OneWay}"
                    Toggled="OnEnabledToggled"
                    AutomationProperties.Name="{Binding Title}" />

      <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <NumberBox Header="Olay süresi (saniye)" Minimum="1" Maximum="60"
                   Value="{Binding EventDurationSeconds, Mode=TwoWay}"
                   SpinButtonPlacementMode="Compact" />
        <ToggleSwitch Grid.Column="1" Header="Tam ekranda göster"
                      IsOn="{Binding ShowInFullscreen, Mode=TwoWay}"
                      MinHeight="36" />
        <Button Grid.Column="3" Content="Ayrıntılar" MinHeight="36"
                Click="OnDetailsClick"
                AutomationProperties.Name="Modül ayrıntılarını aç" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
