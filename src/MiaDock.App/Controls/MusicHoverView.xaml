<UserControl
    x:Class="MiaDock.App.Controls.MusicHoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="LayoutRoot"
        Padding="12,0"
        ColumnSpacing="9"
        AutomationProperties.Name="{Binding Current.Track.Title}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border Width="24"
            Height="24"
            CornerRadius="12"
            Background="{ThemeResource IslandStyleControlBrush}"
            AutomationProperties.AccessibilityView="Raw">
      <FontIcon Glyph="&#xE8D6;"
                FontSize="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource IslandStyleAccentBrush}" />
    </Border>
    <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Spacing="0">
      <TextBlock x:Name="TrackTitleText"
                 Text="{Binding Current.Track.Title}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{ThemeResource IslandTextPrimaryBrush}"
                 ToolTipService.ToolTip="{Binding Current.Track.Title}" />
      <TextBlock x:Name="TrackArtistText"
                 Text="{Binding Current.Track.Artist}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource IslandCaptionTextStyle}"
                 ToolTipService.ToolTip="{Binding Current.Track.Artist}" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
      <Button Width="28"
              Height="28"
              Style="{StaticResource IslandCompactIconButtonStyle}"
              IsTabStop="True"
              Command="{Binding PreviousCommand}"
              ToolTipService.ToolTip="Önceki parça"
              AutomationProperties.Name="Önceki parça"
              AutomationProperties.HelpText="Önceki parçaya geçer">
        <FontIcon Glyph="&#xE892;" FontSize="12" />
      </Button>
      <Button Width="32"
              Height="32"
              Style="{StaticResource IslandCompactIconButtonStyle}"
              IsTabStop="True"
              Command="{Binding PlayPauseCommand}"
              ToolTipService.ToolTip="Oynat veya duraklat"
              AutomationProperties.Name="Oynat veya duraklat"
              AutomationProperties.HelpText="Geçerli parçayı oynatır veya duraklatır">
        <FontIcon Glyph="{Binding PlaybackGlyph}" FontSize="14" />
      </Button>
      <Button Width="28"
              Height="28"
              Style="{StaticResource IslandCompactIconButtonStyle}"
              IsTabStop="True"
              Command="{Binding NextCommand}"
              ToolTipService.ToolTip="Sonraki parça"
              AutomationProperties.Name="Sonraki parça"
              AutomationProperties.HelpText="Sonraki parçaya geçer">
        <FontIcon Glyph="&#xE893;" FontSize="12" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
