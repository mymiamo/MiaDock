<UserControl x:Class="MiaDock.App.Controls.ClipboardPeekNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons"
             xmlns:animations="using:MiaDock.App.Animations"
             xmlns:controls="using:MiaDock.App.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>

  <Grid Style="{StaticResource DockNotificationLayoutStyle}"
        animations:MicroMotion.StateKey="{Binding PrimaryText}"
        AutomationProperties.Name="{Binding PrimaryText}"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Width="42" Height="42" Margin="0,0,10,0">
      <Border Style="{StaticResource DockNotificationIconContainerStyle}"
              Visibility="{x:Bind Peek.HasPrimaryVisualPreview, Mode=OneWay, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}">
        <icons:DockIcon Glyph="{Binding LeadingGlyph}"
                  Style="{StaticResource DockModuleIconStyle}"
                  AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Border CornerRadius="10"
              Background="{x:Bind Peek.ColorPreviewBrush, Mode=OneWay}"
              BorderBrush="{ThemeResource DockSurfaceStrokeBrush}"
              BorderThickness="1"
              Visibility="{x:Bind Peek.HasColorPreview, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}"
              AutomationProperties.AccessibilityView="Raw" />
      <Border CornerRadius="10"
              Visibility="{x:Bind Peek.HasThumbnail, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}"
              AutomationProperties.AccessibilityView="Raw">
        <Image Source="{x:Bind Peek.Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
      </Border>
    </Grid>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
      <TextBlock Text="{Binding PrimaryText}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockTitleTextStyle}" />
      <TextBlock Text="{Binding SecondaryText}"
                 MaxLines="1"
                 TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockBodyTextStyle}" />
    </StackPanel>

    <ItemsControl Grid.Column="2"
                  ItemsSource="{Binding Commands}"
                  VerticalAlignment="Center">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding DisplayName}"
                  Tag="{Binding Id}"
                  IsEnabled="{Binding IsEnabled}"
                  MinHeight="44"
                  Style="{StaticResource DockInlineButtonStyle}"
                  Click="OnCommandClick"
                  animations:MicroMotion.IsInteractive="True"
                  AutomationProperties.Name="{Binding DisplayName}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
