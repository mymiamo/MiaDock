<UserControl x:Class="MiaDock.App.Controls.BatteryCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockCompactModuleLayoutStyle}"
        AutomationProperties.Name="{Binding StatusText}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <FontIcon Glyph="{Binding BatteryGlyph}" Style="{StaticResource DockModuleIconStyle}" />
    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis"
               Style="{StaticResource DockBodyTextStyle}"
               ToolTipService.ToolTip="{Binding StatusText}" />
    <TextBlock Grid.Column="2" Text="{Binding ChargeText}" VerticalAlignment="Center"
               Style="{StaticResource DockStatusTextStyle}" />
  </Grid>
</UserControl>
