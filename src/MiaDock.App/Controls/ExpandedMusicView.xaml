<UserControl
    x:Class="MiaDock.App.Controls.ExpandedMusicView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiaDock.App.Controls"
    xmlns:animations="using:MiaDock.App.Animations">

  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding Current.Track.Title}"
        animations:MicroMotion.StateKey="{Binding Current.Track.Title}">
    <Border Style="{StaticResource DockHeroSectionStyle}">
      <Grid ColumnSpacing="18" RowSpacing="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="132" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3"
                Width="132" Height="132"
                CornerRadius="18"
                BorderBrush="{ThemeResource DockSurfaceStrokeBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">
          <controls:AlbumArtwork Width="130" Height="130" />
        </Border>

        <Grid Grid.Column="1" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel MinWidth="0" VerticalAlignment="Center" Spacing="2">
            <TextBlock MaxLines="1"
                       Style="{StaticResource DockTitleTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Current.Track.Title}"
                       ToolTipService.ToolTip="{Binding Current.Track.Title}" />
            <TextBlock MaxLines="1"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource DockBodyTextStyle}"
                       Text="{Binding Current.Track.Artist}"
                       ToolTipService.ToolTip="{Binding Current.Track.Artist}" />
            <TextBlock MaxLines="1"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource DockCaptionTextStyle}"
                       Text="{Binding Current.Track.AlbumTitle}"
                       ToolTipService.ToolTip="{Binding Current.Track.AlbumTitle}" />
          </StackPanel>
          <controls:SourceAppBadge Grid.Column="1"
                                   VerticalAlignment="Top"
                                   ToolTipService.ToolTip="{Binding Current.SourceAppDisplayName}" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:MediaTimeline />
          <controls:VolumeControl Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <controls:MediaTransportControls x:Name="TransportControls"
                                         Grid.Row="2" Grid.Column="1"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
