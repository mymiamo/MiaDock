<UserControl x:Class="MiaDock.App.Controls.VolumeExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="OnUnloaded">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="Ses merkezi">
    <StackPanel Spacing="8">
      <Border Style="{StaticResource DockSectionStyle}" Padding="12,10">
        <StackPanel Spacing="8">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
              <TextBlock Text="Ana ses"
                         Style="{StaticResource DockModuleHeaderTextStyle}" />
              <TextBlock Text="{Binding OutputDeviceText}"
                         MaxLines="1"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockCaptionTextStyle}"
                         ToolTipService.ToolTip="{Binding OutputDeviceText}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding VolumeText}"
                       VerticalAlignment="Center"
                       Style="{StaticResource DockMetricTextStyle}" />
          </Grid>
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Width="44" Height="44"
                    Style="{StaticResource DockIconButtonStyle}"
                    Command="{Binding ToggleMuteCommand}"
                    ToolTipService.ToolTip="Sesi aç veya kapat"
                    AutomationProperties.Name="Windows ana sesini aç veya kapat">
              <FontIcon Glyph="{Binding VolumeGlyph}" FontSize="15" />
            </Button>
            <Slider Grid.Column="1"
                    Minimum="0" Maximum="100"
                    Value="{Binding Snapshot.MasterVolumePercent, Mode=OneWay}"
                    IsEnabled="{Binding Snapshot.IsMasterVolumeAvailable}"
                    ValueChanged="OnMasterVolumeChanged"
                    AutomationProperties.Name="Windows ana ses seviyesi" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource DockSectionStyle}" Padding="12,9">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE995;" FontSize="15"
                    Foreground="{ThemeResource IslandStyleAccentBrush}" />
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Text="Uygulama sesleri"
                       Style="{StaticResource DockBodyTextStyle}" />
            <TextBlock Text="{Binding MixerStatusText}"
                       Style="{StaticResource DockCaptionTextStyle}"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Grid>
      </Border>

      <Button HorizontalAlignment="Left"
              MinHeight="44" Padding="11,0"
              Style="{StaticResource DockInlineButtonStyle}"
              Command="{Binding OpenSoundSettingsFromUiCommand}"
              ToolTipService.ToolTip="Windows ses ayarlarını aç"
              AutomationProperties.Name="Windows ses ayarlarını aç">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <FontIcon Glyph="&#xE713;" FontSize="12" />
          <TextBlock Text="Ses aygıtlarını yönet"
                     VerticalAlignment="Center"
                     Style="{StaticResource DockBodyTextStyle}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
