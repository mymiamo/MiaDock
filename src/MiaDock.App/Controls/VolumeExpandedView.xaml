<UserControl x:Class="MiaDock.App.Controls.VolumeExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:MiaDock.App.Animations"
             Unloaded="OnUnloaded">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="Ses merkezi"
        animations:MicroMotion.StateKey="{Binding VolumeText}">
    <StackPanel Spacing="12">
      <Border Style="{StaticResource DockHeroSectionStyle}">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Width="56" Height="56"
                    animations:MicroMotion.IsInteractive="True"
                    Style="{StaticResource DockIconButtonStyle}"
                    Command="{Binding ToggleMuteCommand}"
                    ToolTipService.ToolTip="Sesi aç veya kapat"
                    AutomationProperties.Name="Windows ana sesini aç veya kapat">
              <FontIcon Glyph="{Binding VolumeGlyph}"
                        FontSize="22"
                        Foreground="{ThemeResource IslandStyleAccentBrush}" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding TitleText}"
                         Style="{StaticResource DockTitleTextStyle}" />
              <TextBlock Text="{Binding OutputDeviceText}"
                         MaxLines="1"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource DockCaptionTextStyle}"
                         ToolTipService.ToolTip="{Binding OutputDeviceText}" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="{Binding VolumeText}"
                       VerticalAlignment="Center"
                       Style="{StaticResource DockDisplayTextStyle}" />
          </Grid>
          <Slider Minimum="0" Maximum="100"
                  Value="{Binding Snapshot.MasterVolumePercent, Mode=OneWay}"
                  IsEnabled="{Binding Snapshot.IsMasterVolumeAvailable}"
                  ValueChanged="OnMasterVolumeChanged"
                  AutomationProperties.Name="Windows ana ses seviyesi" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource DockGroupedSectionStyle}">
        <StackPanel>
          <Border Style="{StaticResource DockGroupedRowStyle}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE995;" FontSize="15"
                        Foreground="{ThemeResource IslandStyleAccentBrush}" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Uygulama sesleri" Style="{StaticResource DockBodyTextStyle}" />
                <TextBlock Text="{Binding MixerStatusText}"
                           Style="{StaticResource DockCaptionTextStyle}"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource DockInsetDividerStyle}" />
          <Button MinHeight="58"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  CornerRadius="0"
                  Command="{Binding OpenSoundSettingsFromUiCommand}"
                  ToolTipService.ToolTip="Windows ses ayarlarını aç"
                  AutomationProperties.Name="Windows ses ayarlarını aç">
            <Grid Padding="6,0" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE713;" FontSize="14"
                        Foreground="{ThemeResource IslandStyleAccentBrush}" />
              <TextBlock Grid.Column="1" Text="Ses aygıtlarını yönet"
                         VerticalAlignment="Center"
                         Style="{StaticResource DockBodyTextStyle}" />
              <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11"
                        Foreground="{ThemeResource IslandTextSecondaryBrush}" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
