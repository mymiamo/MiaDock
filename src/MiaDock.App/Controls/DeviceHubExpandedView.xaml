<UserControl x:Class="MiaDock.App.Controls.DeviceHubExpandedView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:MiaDock.App.Animations"
             xmlns:controls="using:MiaDock.App.Controls"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <Style x:Key="DeviceHubGroupStyle" TargetType="Border"
           BasedOn="{StaticResource DockSectionStyle}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="DeviceHubItemContainerStyle" TargetType="ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="DeviceHubExpanderStyle" TargetType="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style x:Key="DeviceHubGlyphContainerStyle" TargetType="Border">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="DeviceHubDetailLabelStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DockCaptionTextStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.78" />
    </Style>

    <DataTemplate x:Key="AudioDeviceTemplate">
      <Grid>
        <Expander Style="{StaticResource DeviceHubExpanderStyle}"
                  Expanding="OnDeviceExpanding"
                  Unloaded="OnDeviceExpanderUnloaded"
                  Loaded="OnDeviceRowLoaded"
                  animations:MicroMotion.IsInteractive="True"
                  animations:MicroMotion.StateKey="{Binding VisualStateKey}"
                  AutomationProperties.Name="{Binding AccessibilityText}">
          <Expander.Header>
            <Grid MinHeight="62" Padding="14,8,8,8" ColumnSpacing="11">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource DeviceHubGlyphContainerStyle}">
                <FontIcon Glyph="{Binding Glyph}" FontSize="17" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource DockBodyTextStyle}"
                           MaxLines="1" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding DisplayName}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource DockCaptionTextStyle}"
                           MaxLines="1" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding TrailingText}"
                         Style="{StaticResource DockCaptionTextStyle}" VerticalAlignment="Center" />
            </Grid>
          </Expander.Header>
          <CommandBar Margin="50,0,6,7" Background="Transparent"
                      DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton Label="{Binding DataContext.SelectSoundText, ElementName=Root}"
                          Command="{Binding DataContext.OpenSoundSettingsCommand, ElementName=Root}"
                          AutomationProperties.Name="{Binding DataContext.SelectSoundText, ElementName=Root}">
              <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>
            </AppBarButton>
          </CommandBar>
        </Expander>
        <Border Height="1" Margin="62,0,0,0" VerticalAlignment="Bottom"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding HasDivider, Converter={StaticResource BooleanToVisibility}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BluetoothDeviceTemplate">
      <Grid>
        <Expander Style="{StaticResource DeviceHubExpanderStyle}"
                  Expanding="OnDeviceExpanding"
                  Unloaded="OnDeviceExpanderUnloaded"
                  Loaded="OnDeviceRowLoaded"
                  animations:MicroMotion.IsInteractive="True"
                  animations:MicroMotion.StateKey="{Binding VisualStateKey}"
                  AutomationProperties.Name="{Binding AccessibilityText}">
          <Expander.Header>
            <Grid MinHeight="62" Padding="14,8,8,8" ColumnSpacing="11">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource DeviceHubGlyphContainerStyle}">
                <FontIcon Glyph="{Binding Glyph}" FontSize="17" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource DockBodyTextStyle}"
                           MaxLines="1" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding DisplayName}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource DockCaptionTextStyle}"
                           MaxLines="1" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding TrailingText}"
                         Style="{StaticResource DockStatusTextStyle}" VerticalAlignment="Center" />
            </Grid>
          </Expander.Header>
          <CommandBar Margin="50,0,6,7" Background="Transparent"
                      DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton Label="{Binding DataContext.ConnectText, ElementName=Root}"
                          Command="{Binding DataContext.ConnectBluetoothCommand, ElementName=Root}"
                          CommandParameter="{Binding Device}"
                          Visibility="{Binding CanConnect, Converter={StaticResource BooleanToVisibility}}"
                          AutomationProperties.Name="{Binding DataContext.ConnectText, ElementName=Root}">
              <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="{Binding DataContext.DisconnectText, ElementName=Root}"
                          Command="{Binding DataContext.DisconnectBluetoothCommand, ElementName=Root}"
                          CommandParameter="{Binding Device}"
                          Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibility}}"
                          AutomationProperties.Name="{Binding DataContext.DisconnectText, ElementName=Root}">
              <AppBarButton.Icon><FontIcon Glyph="&#xE738;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="{Binding DataContext.ManageBluetoothText, ElementName=Root}"
                          Command="{Binding DataContext.OpenBluetoothSettingsCommand, ElementName=Root}"
                          AutomationProperties.Name="{Binding DataContext.ManageBluetoothText, ElementName=Root}">
              <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>
            </AppBarButton>
          </CommandBar>
        </Expander>
        <Border Height="1" Margin="62,0,0,0" VerticalAlignment="Bottom"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding HasDivider, Converter={StaticResource BooleanToVisibility}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="StorageDeviceTemplate">
      <Grid>
        <Expander Style="{StaticResource DeviceHubExpanderStyle}"
                  Expanding="OnDeviceExpanding"
                  Unloaded="OnDeviceExpanderUnloaded"
                  Loaded="OnDeviceRowLoaded"
                  animations:MicroMotion.IsInteractive="True"
                  animations:MicroMotion.StateKey="{Binding VisualStateKey}"
                  AutomationProperties.Name="{Binding AccessibilityText}">
          <Expander.Header>
            <Grid MinHeight="62" Padding="14,8,8,8" ColumnSpacing="11">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource DeviceHubGlyphContainerStyle}">
                <FontIcon Glyph="{Binding Glyph}" FontSize="17" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource DockBodyTextStyle}"
                           MaxLines="1" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding DisplayName}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource DockCaptionTextStyle}"
                           MaxLines="1" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding TrailingText}"
                         Style="{StaticResource DockCaptionTextStyle}" VerticalAlignment="Center" />
            </Grid>
          </Expander.Header>
          <StackPanel Margin="62,0,14,9" Spacing="6">
            <Grid Visibility="{Binding HasCapacity, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding DataContext.CapacityText, ElementName=Root}"
                         Style="{StaticResource DeviceHubDetailLabelStyle}" />
              <TextBlock Grid.Column="1" Text="{Binding CapacityValue}"
                         Style="{StaticResource DockBodyTextStyle}" />
            </Grid>
            <Grid Visibility="{Binding HasAvailable, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding DataContext.AvailableText, ElementName=Root}"
                         Style="{StaticResource DeviceHubDetailLabelStyle}" />
              <TextBlock Grid.Column="1" Text="{Binding AvailableValue}"
                         Style="{StaticResource DockBodyTextStyle}" />
            </Grid>
            <Grid Visibility="{Binding HasFileSystem, Converter={StaticResource BooleanToVisibility}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding DataContext.FileSystemText, ElementName=Root}"
                         Style="{StaticResource DeviceHubDetailLabelStyle}" />
              <TextBlock Grid.Column="1" Text="{Binding FileSystemValue}"
                         Style="{StaticResource DockBodyTextStyle}" />
            </Grid>
            <CommandBar Margin="-12,2,-8,-3" Background="Transparent"
                        DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
              <AppBarButton Label="{Binding DataContext.OpenText, ElementName=Root}"
                            Command="{Binding DataContext.OpenStorageCommand, ElementName=Root}"
                            CommandParameter="{Binding Device}"
                            Visibility="{Binding CanOpen, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.Name="{Binding DataContext.OpenText, ElementName=Root}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
              </AppBarButton>
              <AppBarButton Label="{Binding DataContext.EjectText, ElementName=Root}"
                            Command="{Binding DataContext.EjectStorageCommand, ElementName=Root}"
                            CommandParameter="{Binding Device}"
                            Visibility="{Binding CanEject, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.Name="{Binding DataContext.EjectText, ElementName=Root}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7B2;" /></AppBarButton.Icon>
              </AppBarButton>
            </CommandBar>
          </StackPanel>
        </Expander>
        <Border Height="1" Margin="62,0,0,0" VerticalAlignment="Bottom"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding HasDivider, Converter={StaticResource BooleanToVisibility}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding AutomationText}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
      <StackPanel Padding="0,4,0,8" Spacing="18">
        <StackPanel Spacing="7"
                    Visibility="{Binding HasAudioOutputs, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="{Binding AudioOutputText}" Style="{StaticResource DockModuleHeaderTextStyle}" />
          <Border Style="{StaticResource DeviceHubGroupStyle}">
            <ItemsControl ItemsSource="{Binding AudioOutputRows}"
                          ItemTemplate="{StaticResource AudioDeviceTemplate}"
                          ItemContainerStyle="{StaticResource DeviceHubItemContainerStyle}"
                          AutomationProperties.Name="{Binding AudioOutputAutomationText}" />
          </Border>
        </StackPanel>

        <StackPanel Spacing="7"
                    Visibility="{Binding HasAudioInputs, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="{Binding MicrophoneText}" Style="{StaticResource DockModuleHeaderTextStyle}" />
          <Border Style="{StaticResource DeviceHubGroupStyle}">
            <ItemsControl ItemsSource="{Binding AudioInputRows}"
                          ItemTemplate="{StaticResource AudioDeviceTemplate}"
                          ItemContainerStyle="{StaticResource DeviceHubItemContainerStyle}"
                          AutomationProperties.Name="{Binding MicrophoneAutomationText}" />
          </Border>
        </StackPanel>

        <StackPanel Spacing="7"
                    Visibility="{Binding HasBluetoothDevices, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="{Binding BluetoothText}" Style="{StaticResource DockModuleHeaderTextStyle}" />
          <Border Style="{StaticResource DeviceHubGroupStyle}">
            <ItemsControl ItemsSource="{Binding BluetoothRows}"
                          ItemTemplate="{StaticResource BluetoothDeviceTemplate}"
                          ItemContainerStyle="{StaticResource DeviceHubItemContainerStyle}"
                          AutomationProperties.Name="{Binding BluetoothAutomationText}" />
          </Border>
          <InfoBar x:Name="BluetoothInfoBar" IsOpen="{Binding BluetoothOperationOpen}"
                   IsClosable="True" Message="{Binding BluetoothOperationMessage}"
                   AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <StackPanel Spacing="7"
                    Visibility="{Binding HasStorageDevices, Converter={StaticResource BooleanToVisibility}}">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StorageText}" Style="{StaticResource DockModuleHeaderTextStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DockIconButtonStyle}"
                    Width="44" Height="44" MinHeight="44"
                    Command="{Binding OpenSafelyRemoveHardwareCommand}"
                    AutomationProperties.Name="{Binding WindowsRemoveOptionsText}"
                    ToolTipService.ToolTip="{Binding WindowsRemoveOptionsText}"
                    animations:MicroMotion.IsInteractive="True">
              <FontIcon Glyph="&#xE7BA;" FontSize="15" />
            </Button>
          </Grid>
          <Border Style="{StaticResource DeviceHubGroupStyle}">
            <ItemsControl ItemsSource="{Binding StorageRows}"
                          ItemTemplate="{StaticResource StorageDeviceTemplate}"
                          ItemContainerStyle="{StaticResource DeviceHubItemContainerStyle}"
                          AutomationProperties.Name="{Binding StorageAutomationText}" />
          </Border>
          <InfoBar x:Name="StorageInfoBar" IsOpen="{Binding StorageOperationOpen}"
                   IsClosable="True" Message="{Binding StorageOperationMessage}"
                   AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" Spacing="8" Padding="20,34"
                    Visibility="{Binding HasAnyDevices, Converter={StaticResource BooleanToVisibility}, ConverterParameter=Invert}"
                    AutomationProperties.Name="{Binding EmptyText}">
          <FontIcon Glyph="&#xE7F4;" FontSize="24" Opacity="0.62" />
          <TextBlock Text="{Binding EmptyText}" Style="{StaticResource DockCaptionTextStyle}"
                     TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
