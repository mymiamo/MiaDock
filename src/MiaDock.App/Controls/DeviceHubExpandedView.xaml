<UserControl x:Class="MiaDock.App.Controls.DeviceHubExpandedView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="12"
                AutomationProperties.Name="Connected devices">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource DockModuleIconContainerStyle}">
          <FontIcon Glyph="&#xE7F4;" Style="{StaticResource DockModuleIconStyle}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Device Hub" Style="{StaticResource DockTitleTextStyle}" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource DockCaptionTextStyle}" />
        </StackPanel>
      </Grid>

      <StackPanel Spacing="5">
        <TextBlock Text="Audio output" Style="{StaticResource DockModuleHeaderTextStyle}" />
        <ItemsControl ItemsSource="{Binding AudioOutputDevices}"
                      AutomationProperties.Name="Audio output devices">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Expanding="OnDeviceExpanding" HorizontalAlignment="Stretch">
                <Expander.Header>
                  <Grid MinHeight="44" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE767;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource DockCaptionTextStyle}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE73E;" VerticalAlignment="Center" />
                  </Grid>
                </Expander.Header>
                <Button Content="Select in sound settings"
                        Command="{Binding DataContext.OpenSoundSettingsCommand, ElementName=Root}"
                        MinHeight="44"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Select this output in sound settings" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Text="Microphone" Style="{StaticResource DockModuleHeaderTextStyle}" />
        <ItemsControl ItemsSource="{Binding AudioInputDevices}"
                      AutomationProperties.Name="Microphone devices">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Expanding="OnDeviceExpanding" HorizontalAlignment="Stretch">
                <Expander.Header>
                  <Grid MinHeight="44" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE720;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource DockCaptionTextStyle}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE73E;" VerticalAlignment="Center" />
                  </Grid>
                </Expander.Header>
                <Button Content="Select in sound settings"
                        Command="{Binding DataContext.OpenSoundSettingsCommand, ElementName=Root}"
                        MinHeight="44"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Select this microphone in sound settings" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Text="Bluetooth" Style="{StaticResource DockModuleHeaderTextStyle}" />
        <ItemsControl ItemsSource="{Binding BluetoothDevices}"
                      AutomationProperties.Name="Bluetooth devices">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Expanding="OnDeviceExpanding" HorizontalAlignment="Stretch">
                <Expander.Header>
                  <Grid MinHeight="44" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE702;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource DockCaptionTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding BatteryText}"
                               VerticalAlignment="Center" Style="{StaticResource DockStatusTextStyle}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource DockCaptionTextStyle}" />
                  <Button Content="{Binding DataContext.ConnectText, ElementName=Root}"
                          Command="{Binding DataContext.ConnectBluetoothCommand, ElementName=Root}"
                          CommandParameter="{Binding}"
                          MinHeight="44" HorizontalAlignment="Left"
                          Visibility="{Binding CanConnect, Converter={StaticResource BooleanToVisibility}}"
                          AutomationProperties.Name="{Binding DataContext.ConnectText, ElementName=Root}" />
                  <Button Content="{Binding DataContext.DisconnectText, ElementName=Root}"
                          Command="{Binding DataContext.DisconnectBluetoothCommand, ElementName=Root}"
                          CommandParameter="{Binding}"
                          MinHeight="44" HorizontalAlignment="Left"
                          Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibility}}"
                          AutomationProperties.Name="{Binding DataContext.DisconnectText, ElementName=Root}" />
                  <Button Content="{Binding DataContext.ManageBluetoothText, ElementName=Root}"
                          Command="{Binding DataContext.OpenBluetoothSettingsCommand, ElementName=Root}"
                          MinHeight="44" HorizontalAlignment="Left"
                          AutomationProperties.Name="{Binding DataContext.ManageBluetoothText, ElementName=Root}" />
                </StackPanel>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <InfoBar x:Name="BluetoothInfoBar"
                 IsOpen="{Binding BluetoothOperationOpen}"
                 IsClosable="True"
                 Message="{Binding BluetoothOperationMessage}"
                 AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <StackPanel Spacing="5">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Removable storage" Style="{StaticResource DockModuleHeaderTextStyle}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Windows remove options"
                  Command="{Binding OpenSafelyRemoveHardwareCommand}"
                  MinHeight="44" />
        </Grid>
        <ItemsControl ItemsSource="{Binding StorageDevices}"
                      AutomationProperties.Name="Removable storage devices">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Expanding="OnDeviceExpanding" HorizontalAlignment="Stretch">
                <Expander.Header>
                  <Grid MinHeight="44" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE88E;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource DockCaptionTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding FileSystem}" VerticalAlignment="Center"
                               Style="{StaticResource DockCaptionTextStyle}" />
                  </Grid>
                </Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Open" MinHeight="44"
                          Command="{Binding DataContext.OpenStorageCommand, ElementName=Root}"
                          CommandParameter="{Binding}" />
                  <Button Content="Eject safely" MinHeight="44"
                          Command="{Binding DataContext.EjectStorageCommand, ElementName=Root}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <InfoBar x:Name="StorageInfoBar"
                 IsOpen="{Binding StorageOperationOpen}"
                 IsClosable="True"
                 Message="{Binding StorageOperationMessage}"
                 AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <StackPanel x:Name="BatterySection" Spacing="5">
        <TextBlock Text="Device batteries" Style="{StaticResource DockModuleHeaderTextStyle}" />
        <ItemsControl ItemsSource="{Binding BatteryDevices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid MinHeight="44" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE850;" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Grid.Column="2" Text="{Binding BatteryText}"
                           VerticalAlignment="Center" Style="{StaticResource DockStatusTextStyle}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
