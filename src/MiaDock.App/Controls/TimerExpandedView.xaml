<UserControl x:Class="MiaDock.App.Controls.TimerExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             DataContextChanged="OnDataContextChanged">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}" RowSpacing="7"
        AutomationProperties.Name="Zaman araçları">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Style="{StaticResource DockSectionStyle}" Padding="2">
      <Grid ColumnSpacing="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="TimerSegment" MinHeight="40" IsThreeState="False"
                      Content="Zamanlayıcı" Style="{StaticResource DockSegmentToggleButtonStyle}"
                      Click="OnTimerSegmentClick" AutomationProperties.Name="Zamanlayıcı görünümü" />
        <ToggleButton x:Name="StopwatchSegment" Grid.Column="1" MinHeight="40" IsThreeState="False"
                      Content="Kronometre" Style="{StaticResource DockSegmentToggleButtonStyle}"
                      Click="OnStopwatchSegmentClick" AutomationProperties.Name="Kronometre görünümü" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer x:Name="TimerPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="8" Padding="2,0,2,4">
          <StackPanel HorizontalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding TimerText}" Style="{StaticResource DockDisplayTextStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding TimerStatusText}" Style="{StaticResource DockCaptionTextStyle}" HorizontalAlignment="Center" />
          </StackPanel>
          <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding TimerProgressPercent}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
            <Button MinHeight="44" Content="5 dk" Command="{Binding StartPresetCommand}" CommandParameter="5" Style="{StaticResource DockInlineButtonStyle}" />
            <Button MinHeight="44" Content="10 dk" Command="{Binding StartPresetCommand}" CommandParameter="10" Style="{StaticResource DockInlineButtonStyle}" />
            <Button MinHeight="44" Content="15 dk" Command="{Binding StartPresetCommand}" CommandParameter="15" Style="{StaticResource DockInlineButtonStyle}" />
            <Button MinHeight="44" Content="25 dk" Command="{Binding StartPresetCommand}" CommandParameter="25" Style="{StaticResource DockInlineButtonStyle}" />
            <Button MinHeight="44" Content="45 dk" Command="{Binding StartPresetCommand}" CommandParameter="45" Style="{StaticResource DockInlineButtonStyle}" />
          </StackPanel>
          <Grid ColumnSpacing="7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="96"/><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2"><TextBlock Text="Saat" Style="{StaticResource DockCaptionTextStyle}"/><NumberBox x:Name="HoursBox" Minimum="0" Maximum="99" Value="{Binding CustomHours, Mode=TwoWay}" SpinButtonPlacementMode="Inline" GotFocus="OnDurationEditorGotFocus" LostFocus="OnDurationEditorLostFocus" AutomationProperties.Name="Saat"/></StackPanel>
            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Dakika" Style="{StaticResource DockCaptionTextStyle}"/><NumberBox x:Name="MinutesBox" Minimum="0" Maximum="59" Value="{Binding CustomMinutes, Mode=TwoWay}" SpinButtonPlacementMode="Inline" GotFocus="OnDurationEditorGotFocus" LostFocus="OnDurationEditorLostFocus" AutomationProperties.Name="Dakika"/></StackPanel>
            <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="Saniye" Style="{StaticResource DockCaptionTextStyle}"/><NumberBox x:Name="SecondsBox" Minimum="0" Maximum="59" Value="{Binding CustomSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Inline" GotFocus="OnDurationEditorGotFocus" LostFocus="OnDurationEditorLostFocus" AutomationProperties.Name="Saniye"/></StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Right">
              <Button MinWidth="78" MinHeight="44" Content="{Binding TimerPrimaryText}" Command="{Binding TimerPrimaryCommand}" Style="{StaticResource AccentButtonStyle}" />
              <Button MinWidth="78" MinHeight="44" Content="{Binding TimerSecondaryText}" Command="{Binding CancelTimerCommand}" Style="{StaticResource DockInlineButtonStyle}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="StopwatchPanel" Visibility="Collapsed" RowSpacing="10" Padding="8,2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding StopwatchText}" Style="{StaticResource DockDisplayTextStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="Saat : dakika : saniye" Style="{StaticResource DockCaptionTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button MinWidth="100" MinHeight="44" Content="{Binding StopwatchPrimaryText}" Command="{Binding StopwatchPrimaryCommand}" Style="{StaticResource AccentButtonStyle}" />
          <Button MinWidth="72" MinHeight="44" Content="Tur" Command="{Binding AddLapCommand}" Style="{StaticResource DockInlineButtonStyle}" />
          <Button MinWidth="72" MinHeight="44" Content="Sıfırla" Command="{Binding ResetStopwatchCommand}" Style="{StaticResource DockInlineButtonStyle}" />
        </StackPanel>
        <Grid Grid.Row="2"><TextBlock Text="Turlar" Style="{StaticResource DockModuleHeaderTextStyle}"/><TextBlock Text="En yeni tur üstte" HorizontalAlignment="Right" Style="{StaticResource DockCaptionTextStyle}"/></Grid>
        <ListView Grid.Row="3" ItemsSource="{Binding LapTexts}" AutomationProperties.Name="Kronometre turları" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
