<UserControl x:Class="MiaDock.App.Controls.TimerExpandedView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             DataContextChanged="OnDataContextChanged">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>

  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="Zaman araçları">
    <TabView x:Name="TimeToolTabs"
             SelectedIndex="{Binding SelectedToolIndex, Mode=TwoWay}"
             IsAddTabButtonVisible="False"
             CanDragTabs="False"
             CanReorderTabs="False"
             TabWidthMode="Equal"
             TabNavigation="Local"
             AutomationProperties.Name="Zaman araçları">
      <TabViewItem IsClosable="False"
                   AutomationProperties.Name="Zamanlayıcı görünümü">
        <TabViewItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE823;" FontSize="14" />
            <TextBlock Text="Zamanlayıcı" />
          </StackPanel>
        </TabViewItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Padding="2,4,2,4">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding TimerText}"
                         Style="{StaticResource DockDisplayTextStyle}"
                         FontSize="26"
                         HorizontalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding TimerStatusText}"
                         Style="{StaticResource DockCaptionTextStyle}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <ProgressBar Height="4"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding TimerProgressPercent}"
                         Style="{StaticResource DockProgressBarStyle}"
                         AutomationProperties.Name="Zamanlayıcı ilerlemesi" />

            <StackPanel Spacing="4">
              <TextBlock Text="Hazır süreler" Style="{StaticResource DockModuleHeaderTextStyle}" />
              <ItemsRepeater x:Name="PresetList" ItemsSource="{Binding PresetDurations}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout MinItemWidth="80"
                                     MinItemHeight="44"
                                     MinColumnSpacing="6"
                                     MinRowSpacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate>
                    <Button MinHeight="44"
                            HorizontalAlignment="Stretch"
                            Click="OnPresetClick"
                            Style="{StaticResource DockInlineButtonStyle}"
                            AutomationProperties.Name="{Binding Label}">
                      <TextBlock Text="{Binding Label}" />
                    </Button>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Özel süre" Style="{StaticResource DockModuleHeaderTextStyle}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Text="Saat" Style="{StaticResource DockCaptionTextStyle}" />
                  <NumberBox x:Name="HoursBox" Minimum="0" Maximum="99" SmallChange="1"
                             Value="{Binding CustomHours, Mode=TwoWay}"
                             SpinButtonPlacementMode="Compact"
                             GotFocus="OnDurationEditorGotFocus"
                             LostFocus="OnDurationEditorLostFocus"
                             AutomationProperties.Name="Saat" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Dakika" Style="{StaticResource DockCaptionTextStyle}" />
                  <NumberBox x:Name="MinutesBox" Minimum="0" Maximum="59" SmallChange="1"
                             Value="{Binding CustomMinutes, Mode=TwoWay}"
                             SpinButtonPlacementMode="Compact"
                             GotFocus="OnDurationEditorGotFocus"
                             LostFocus="OnDurationEditorLostFocus"
                             AutomationProperties.Name="Dakika" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Saniye" Style="{StaticResource DockCaptionTextStyle}" />
                  <NumberBox x:Name="SecondsBox" Minimum="0" Maximum="59" SmallChange="1"
                             Value="{Binding CustomSeconds, Mode=TwoWay}"
                             SpinButtonPlacementMode="Compact"
                             GotFocus="OnDurationEditorGotFocus"
                             LostFocus="OnDurationEditorLostFocus"
                             AutomationProperties.Name="Saniye" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button MinHeight="44"
                      Content="{Binding TimerPrimaryText}"
                      Command="{Binding TimerPrimaryCommand}"
                      Style="{StaticResource AccentButtonStyle}"
                      AutomationProperties.Name="{Binding TimerPrimaryText}" />
              <Button Grid.Column="1"
                      MinHeight="44"
                      Content="{Binding TimerSecondaryText}"
                      Command="{Binding CancelTimerCommand}"
                      Style="{StaticResource DockInlineButtonStyle}"
                      AutomationProperties.Name="{Binding TimerSecondaryText}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabViewItem>

      <TabViewItem IsClosable="False"
                   AutomationProperties.Name="Kronometre görünümü">
        <TabViewItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE916;" FontSize="14" />
            <TextBlock Text="Kronometre" />
          </StackPanel>
        </TabViewItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Padding="2,4,2,4">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding StopwatchText}"
                         Style="{StaticResource DockDisplayTextStyle}"
                         FontSize="26"
                         HorizontalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="Saat : dakika : saniye"
                         Style="{StaticResource DockCaptionTextStyle}"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button MinHeight="44"
                      Content="{Binding StopwatchPrimaryText}"
                      Command="{Binding StopwatchPrimaryCommand}"
                      Style="{StaticResource AccentButtonStyle}"
                      AutomationProperties.Name="{Binding StopwatchPrimaryText}" />
              <Button Grid.Column="1"
                      MinHeight="44"
                      Content="Tur"
                      Command="{Binding AddLapCommand}"
                      Style="{StaticResource DockInlineButtonStyle}"
                      AutomationProperties.Name="Tur" />
              <Button Grid.Column="2"
                      MinHeight="44"
                      Content="Sıfırla"
                      Command="{Binding ResetStopwatchCommand}"
                      Style="{StaticResource DockInlineButtonStyle}"
                      AutomationProperties.Name="Kronometreyi sıfırla" />
            </Grid>

            <StackPanel Spacing="4"
                        Visibility="{Binding HasStopwatchActivity, Converter={StaticResource BooleanToVisibility}}">
              <Grid>
                <TextBlock Text="Turlar" Style="{StaticResource DockModuleHeaderTextStyle}" />
                <TextBlock Text="En yeni tur üstte"
                           HorizontalAlignment="Right"
                           Style="{StaticResource DockCaptionTextStyle}" />
              </Grid>
              <ItemsRepeater ItemsSource="{Binding LapTexts}"
                             AutomationProperties.Name="Kronometre turları">
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{ThemeResource DockDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,8">
                      <TextBlock Text="{Binding}" Style="{StaticResource DockBodyTextStyle}" />
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabViewItem>
    </TabView>
  </Grid>
</UserControl>
