<UserControl x:Class="MiaDock.App.Controls.BatteryExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:MiaDock.UI.Icons"
             xmlns:local="using:MiaDock.App.Controls"
             xmlns:animations="using:MiaDock.App.Animations">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding StatusText}"
        animations:MicroMotion.StateKey="{Binding BatteryGlyph}">
    <StackPanel Spacing="12">
      <Border Style="{StaticResource DockHeroSectionStyle}">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource DockHeroIconContainerStyle}">
              <local:BatteryStatusIcon Width="38" Height="22" ChargePercent="{Binding Snapshot.ChargePercent}"
                                       IsCharging="{Binding Snapshot.IsCharging}" HasReading="{Binding Snapshot.HasReading}"
                                       IsBatteryPresent="{Binding Snapshot.IsBatteryPresent}" AutomationProperties.Name="{Binding StatusText}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding StatusText}" MaxLines="1"
                         Style="{StaticResource DockTitleTextStyle}"
                         ToolTipService.ToolTip="{Binding StatusText}" />
              <TextBlock Text="{Binding PowerText}" MaxLines="1"
                         Style="{StaticResource DockCaptionTextStyle}"
                         ToolTipService.ToolTip="{Binding PowerText}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding ChargeText}"
                       Style="{StaticResource DockDisplayTextStyle}"
                       VerticalAlignment="Center"
                       ToolTipService.ToolTip="{Binding ChargeText}" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="100"
                       Value="{Binding Snapshot.ChargePercent}"
                       Style="{StaticResource DockProgressBarStyle}"
                       AutomationProperties.Name="Pil seviyesi" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource DockGroupedSectionStyle}">
        <Border Style="{StaticResource DockGroupedRowStyle}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <icons:DockIcon Glyph="&#xE7E8;" FontSize="15"
                      Foreground="{ThemeResource IslandStyleAccentBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding PowerText}"
                       VerticalAlignment="Center" Style="{StaticResource DockBodyTextStyle}" />
            <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                       VerticalAlignment="Center" Style="{StaticResource DockStatusTextStyle}" />
          </Grid>
        </Border>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
