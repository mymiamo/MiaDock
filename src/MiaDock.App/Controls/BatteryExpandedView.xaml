<UserControl x:Class="MiaDock.App.Controls.BatteryExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}"
        AutomationProperties.Name="{Binding StatusText}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource DockSectionStyle}">
      <Grid ColumnSpacing="14" RowSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource DockModuleIconContainerStyle}">
          <FontIcon Glyph="{Binding BatteryGlyph}"
                    Style="{StaticResource DockModuleIconStyle}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding StatusText}"
                     MaxLines="1"
                     Style="{StaticResource DockTitleTextStyle}"
                     ToolTipService.ToolTip="{Binding StatusText}" />
          <TextBlock Text="{Binding PowerText}"
                     MaxLines="1"
                     Style="{StaticResource DockBodyTextStyle}"
                     ToolTipService.ToolTip="{Binding PowerText}" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="{Binding ChargeText}"
                   Style="{StaticResource DockMetricTextStyle}"
                   VerticalAlignment="Center"
                   ToolTipService.ToolTip="{Binding ChargeText}" />

        <ProgressBar Grid.Row="1"
                     Grid.ColumnSpan="3"
                     Minimum="0" Maximum="100"
                     Value="{Binding Snapshot.ChargePercent}"
                     Style="{StaticResource DockProgressBarStyle}"
                     AutomationProperties.Name="Pil seviyesi" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1"
                Margin="4,0"
                Orientation="Horizontal"
                Spacing="8">
      <FontIcon Glyph="&#xE7E8;"
                FontSize="12"
                Foreground="{ThemeResource IslandTextSecondaryBrush}" />
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource DockCaptionTextStyle}" />
    </StackPanel>
  </Grid>
</UserControl>
