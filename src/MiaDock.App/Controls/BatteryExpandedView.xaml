<UserControl x:Class="MiaDock.App.Controls.BatteryExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="22,12,22,16" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="{Binding BatteryGlyph}" FontSize="28" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding StatusText}" Style="{StaticResource IslandTitleTextStyle}" /><TextBlock Text="{Binding PowerText}" Style="{StaticResource IslandBodyTextStyle}" /></StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding ChargeText}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>
    <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Snapshot.ChargePercent}" Height="6" AutomationProperties.Name="Pil seviyesi" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <FontIcon Glyph="&#xE7E8;" FontSize="13" />
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource IslandCaptionTextStyle}" />
    </StackPanel>
  </Grid>
</UserControl>
