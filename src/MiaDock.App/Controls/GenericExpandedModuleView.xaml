<UserControl
    x:Class="MiaDock.App.Controls.GenericExpandedModuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DataContextChanged="OnDataContextChanged">
  <Grid Style="{StaticResource DockExpandedModuleLayoutStyle}">
    <Grid x:Name="ContentPanel"
          Visibility="Collapsed"
          AutomationProperties.Name="{Binding PrimaryText}">
      <Border Style="{StaticResource DockSectionStyle}">
        <Grid ColumnSpacing="12" RowSpacing="11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource DockModuleIconContainerStyle}"
                  AutomationProperties.AccessibilityView="Raw">
            <FontIcon Glyph="{Binding LeadingGlyph}"
                      Style="{StaticResource DockModuleIconStyle}" />
          </Border>
          <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding PrimaryText}"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource DockTitleTextStyle}"
                       ToolTipService.ToolTip="{Binding PrimaryText}" />
            <TextBlock Text="{Binding SecondaryText}"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource DockBodyTextStyle}"
                       ToolTipService.ToolTip="{Binding SecondaryText}" />
          </StackPanel>
          <Border Grid.Column="2"
                  Style="{StaticResource DockStatusBadgeStyle}"
                  VerticalAlignment="Center">
            <TextBlock MaxWidth="150"
                       Text="{Binding ValueText}"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource DockStatusTextStyle}"
                       ToolTipService.ToolTip="{Binding ValueText}" />
          </Border>
          <ProgressBar Grid.Row="1"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource DockProgressBarStyle}"
                       Minimum="0"
                       Maximum="1"
                       Value="{Binding Progress}"
                       Foreground="{ThemeResource IslandStyleAccentBrush}"
                       AutomationProperties.Name="İlerleme" />
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="EmptyState"
            Style="{StaticResource DockSectionStyle}"
            AutomationProperties.Name="Etkin olay yok">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="7">
        <Border Style="{StaticResource DockModuleIconContainerStyle}"
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw">
          <FontIcon Glyph="&#xE946;"
                    Style="{StaticResource DockModuleIconStyle}" />
        </Border>
        <TextBlock x:Name="EmptyStateText"
                   Text="Etkin olay yok"
                   HorizontalAlignment="Center"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource DockTitleTextStyle}" />
        <TextBlock Text="Yeni bir etkinlik olduğunda burada görünecek."
                   HorizontalAlignment="Center"
                   MaxLines="2"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Style="{StaticResource DockBodyTextStyle}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
