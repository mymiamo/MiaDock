<UserControl x:Class="MiaDock.App.Controls.DeviceHubNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockNotificationLayoutStyle}"
        AutomationProperties.Name="{Binding PrimaryText}"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border Style="{StaticResource DockNotificationIconContainerStyle}">
      <FontIcon Glyph="{Binding LeadingGlyph}" Style="{StaticResource DockModuleIconStyle}" />
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
      <TextBlock Text="{Binding PrimaryText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockTitleTextStyle}" />
      <TextBlock Text="{Binding SecondaryText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockBodyTextStyle}" />
    </StackPanel>
    <ItemsControl Grid.Column="2" ItemsSource="{Binding Commands}" VerticalAlignment="Center">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding DisplayName}"
                  Tag="{Binding Id}"
                  IsEnabled="{Binding IsEnabled}"
                  MinHeight="44"
                  Click="OnCommandClick"
                  AutomationProperties.Name="{Binding DisplayName}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
