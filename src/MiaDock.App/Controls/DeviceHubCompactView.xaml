<UserControl x:Class="MiaDock.App.Controls.DeviceHubCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Style="{StaticResource DockCompactModuleLayoutStyle}"
        AutomationProperties.Name="Device Hub">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource DockModuleIconStyle}" />
    <TextBlock Grid.Column="1" Text="{Binding CompactSummary}" VerticalAlignment="Center"
               MaxLines="1" TextTrimming="CharacterEllipsis"
               Style="{StaticResource DockBodyTextStyle}"
               ToolTipService.ToolTip="{Binding StatusText}" />
  </Grid>
</UserControl>
