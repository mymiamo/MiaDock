<UserControl
    x:Class="MiaDock.App.Controls.TrackNotificationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiaDock.App.Controls">

  <Grid Style="{StaticResource DockNotificationLayoutStyle}"
        AutomationProperties.Name="{Binding Current.Track.Title}"
        AutomationProperties.LiveSetting="Polite">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="64" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <controls:AlbumArtwork Width="64" Height="64" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
      <TextBlock Text="Şimdi çalıyor" Style="{StaticResource DockCaptionTextStyle}" />
      <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockTitleTextStyle}"
                 Text="{Binding Current.Track.Title}"
                 ToolTipService.ToolTip="{Binding Current.Track.Title}" />
      <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource DockBodyTextStyle}"
                 Text="{Binding Current.Track.Artist}"
                 ToolTipService.ToolTip="{Binding Current.Track.Artist}" />
    </StackPanel>
    <controls:MediaTransportControls x:Name="TransportControls"
                                     Grid.Column="2"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed" />
  </Grid>
</UserControl>
