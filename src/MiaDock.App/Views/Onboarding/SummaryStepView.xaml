<UserControl x:Class="MiaDock.App.Views.Onboarding.SummaryStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Left">
    <TextBlock Text="Kurulum özeti" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock Text="Seçimlerinizi kontrol edin. Tamamla düğmesine bastığınızda ayarlar tek seferde kaydedilecektir."
               TextWrapping="Wrap" />
    <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" LineHeight="26" />
    </Border>
    <InfoBar IsOpen="True" Severity="Success" Title="Hazır"
             Message="Bu seçimlerin tümünü daha sonra Ayarlar penceresinden değiştirebilirsiniz." />
  </StackPanel>
</UserControl>
