<UserControl x:Class="MiaDock.App.Views.Onboarding.FeaturesAndPrivacyStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Stretch">
    <StackPanel Spacing="5">
      <TextBlock Text="Özellikler ve Gizlilik" FontSize="32" FontWeight="SemiBold"
                 AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="Kullanacağınız modülleri ve varsayılan medya kaynağını seçin."
                 TextWrapping="Wrap" Opacity="0.72" />
    </StackPanel>

    <StackPanel Spacing="7">
      <TextBlock Text="Varsayılan medya uygulaması" FontWeight="SemiBold" />
      <ComboBox ItemsSource="{Binding MediaSourceOptions}"
                ItemTemplate="{StaticResource SettingOptionItemTemplate}"
                SelectedIndex="{Binding MediaSourceIndex, Mode=TwoWay}"
                MinHeight="44" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Varsayılan medya uygulaması" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Text="Modüller" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding ModuleOptions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="14,10" Margin="0,0,0,6" MinHeight="60" CornerRadius="10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" /><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding IconGlyph}" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.68"
                             TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" MinHeight="44"
                              IsOn="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectDuringOnboarding}"
                              AutomationProperties.Name="{Binding Title}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <InfoBar IsOpen="True" Severity="Informational" Title="İzinler ertelenir"
             Message="Kamera, mikrofon ve bildirim izinleri burada açılmaz; ilgili özellik ilk kullanıldığında bağlam içinde açıklanır ve istenir." />
  </StackPanel>
</UserControl>
