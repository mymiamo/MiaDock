<UserControl x:Class="MiaDock.App.Views.Onboarding.ModulesStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel MaxWidth="620" Spacing="16">
    <TextBlock Text="Modüllerinizi seçin" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Dock'ta kullanmak istediğiniz özellikleri seçin. İleri dediğinizde kullanılan servisler açıklanır ve onayınız istenir."
               TextWrapping="Wrap" Opacity="0.72" />
    <ItemsControl ItemsSource="{Binding ModuleOptions}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Padding="14" Margin="0,0,0,8" CornerRadius="10"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="{Binding IconGlyph}" FontSize="19" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2" MinHeight="36"
                            IsOn="{Binding IsSelected, Mode=TwoWay}"
                            IsEnabled="{Binding CanSelectDuringOnboarding}"
                            AutomationProperties.Name="{Binding Title}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
