<UserControl x:Class="MiaDock.App.Views.Onboarding.ReadyStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Stretch">
    <StackPanel Spacing="5">
      <TextBlock Text="Hazır" FontSize="34" FontWeight="SemiBold"
                 AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="Seçimlerinizi kontrol edin; MiaDock'u başlattığınızda hepsi tek seferde kaydedilir."
                 TextWrapping="Wrap" Opacity="0.72" />
    </StackPanel>

    <Border Padding="22" CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" LineHeight="27" />
    </Border>

    <InfoBar IsOpen="True" Severity="Success" Title="MiaDock hazır"
             Message="Eksik izinler yalnız ilgili özelliği kullandığınızda açıklanır. Tüm seçimleri daha sonra Ayarlar'dan değiştirebilirsiniz." />
  </StackPanel>
</UserControl>
