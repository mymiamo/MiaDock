<UserControl
    x:Class="MiaDock.App.Views.Settings.HomeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer Padding="28,24,28,48"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Spacing="5" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="MiaDock Ayarları"
                     Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
          <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,5" Opacity="0.58">
            <Run Text="v" /><Run Text="{Binding VersionText}" />
          </TextBlock>
        </StackPanel>
        <TextBlock Text="Ana Sayfa" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Dock'un temel durumunu görün ve sık kullanılan ayarlara hızla ulaşın."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Grid x:Name="DashboardGrid" ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
          <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup>
            <VisualState x:Name="Narrow" />
            <VisualState x:Name="Wide">
              <VisualState.StateTriggers>
                <AdaptiveTrigger MinWindowWidth="760" />
              </VisualState.StateTriggers>
              <VisualState.Setters>
                <Setter Target="SecondaryColumn.Width" Value="*" />
                <Setter Target="AppearanceCard.(Grid.Row)" Value="0" />
                <Setter Target="AppearanceCard.(Grid.Column)" Value="1" />
                <Setter Target="ModulesCard.(Grid.Row)" Value="1" />
                <Setter Target="StartupCard.(Grid.Row)" Value="1" />
                <Setter Target="StartupCard.(Grid.Column)" Value="1" />
                <Setter Target="UpdateCard.(Grid.Row)" Value="2" />
                <Setter Target="UpdateCard.(Grid.ColumnSpan)" Value="2" />
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="QuickSettingsCard"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE713;"
                        Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="10">
              <StackPanel>
                <TextBlock Text="Hızlı dock ayarları" FontWeight="SemiBold" />
                <TextBlock Text="Görünürlük ve etkileşim davranışını doğrudan değiştirin."
                           FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding VisibilityModes}"
                          DisplayMemberPath="Label"
                          SelectedIndex="{Binding VisibilityModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Görünürlük" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding InteractionModes}"
                          DisplayMemberPath="Label"
                          SelectedIndex="{Binding InteractionModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Etkileşim" />
              </Grid>
              <Button Content="Genel ayarları aç"
                      Tag="general"
                      HorizontalAlignment="Left"
                      Click="OnNavigateClick" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="StartupCard"
                Grid.Row="1"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE7E8;"
                        Foreground="{ThemeResource SettingsSystemIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="Windows başlangıcı" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StartupStatusMessage}"
                         FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
              <Button Content="Başlangıç ayarlarını aç"
                      Tag="startup"
                      Margin="0,6,0,0"
                      HorizontalAlignment="Left"
                      Click="OnNavigateClick" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2"
                          IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                          IsEnabled="{Binding IsStartupTaskAvailable}"
                          AutomationProperties.Name="Windows açılışında başlat" />
          </Grid>
        </Border>

        <Border x:Name="ModulesCard"
                Grid.Row="2"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE74C;"
                        Foreground="{ThemeResource SettingsModulesIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="Modül durumu" FontWeight="SemiBold" />
              <TextBlock Text="{Binding EnabledModuleSummary}"
                         FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2"
                    Content="Yönet"
                    Tag="modules"
                    VerticalAlignment="Center"
                    Click="OnNavigateClick" />
          </Grid>
        </Border>

        <Border x:Name="AppearanceCard"
                Grid.Row="3"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE790;"
                        Foreground="{ThemeResource SettingsAppearanceIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="9">
              <StackPanel>
                <TextBlock Text="Dock görünümü" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ThemeDescription}"
                           FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox ItemsSource="{Binding Themes}"
                        DisplayMemberPath="Label"
                        SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Tema" />
              <Button Content="Görünüm ayarlarını aç"
                      Tag="appearance"
                      HorizontalAlignment="Left"
                      Click="OnNavigateClick" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="UpdateCard"
                Grid.Row="4"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE895;"
                        Foreground="{ThemeResource SettingsNotificationIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="Microsoft Store güncellemeleri" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StoreUpdateStatusMessage}"
                         FontSize="12" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding StoreUpdateVersionText}"
                         FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
              <Button Content="Güncellemeleri denetle"
                      Command="{Binding CheckForUpdatesCommand}" />
              <Button Content="Microsoft Store'da aç"
                      Command="{Binding OpenStoreCommand}"
                      IsEnabled="{Binding IsStoreUpdateAvailable}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
