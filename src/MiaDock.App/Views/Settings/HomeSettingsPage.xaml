<UserControl
    x:Class="MiaDock.App.Views.Settings.HomeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiaDock.App.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}" Spacing="20">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="MiaDock Ayarları"
                     Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
          <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,5" Opacity="0.58">
            <Run Text="v" /><Run Text="{Binding VersionText}" />
          </TextBlock>
        </StackPanel>
        <TextBlock Text="Dock'un temel durumunu görün ve sık kullanılan ayarlara hızla ulaşın."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Padding="20"
              CornerRadius="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
              BorderThickness="3,1,1,1"
              AutomationProperties.Name="Dock hazır, MiaDock çalışıyor">
        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="52" Height="52" CornerRadius="26"
                  Background="{ThemeResource AccentFillColorTertiaryBrush}">
            <FontIcon Glyph="&#xE73E;" Foreground="White" FontSize="24" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="Dock hazır" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="MiaDock sorunsuz çalışıyor; değişiklikleriniz otomatik kaydedilir."
                       TextWrapping="Wrap" Opacity="0.78" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Spacing="8">
        <TextBlock Text="Hızlı ayarlar" Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
        <Border CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
          <StackPanel>
            <Border Style="{StaticResource SettingsRowBorderStyle}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SettingsIconTileBorderStyle}">
                  <FontIcon Glyph="&#xE890;" Foreground="{ThemeResource SettingsGeneralIconBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Görünürlük" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
                  <TextBlock Text="Dock'un ne zaman görünür olacağını seçin."
                             Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding VisibilityModes}"
                          DisplayMemberPath="Label"
                          SelectedIndex="{Binding VisibilityModeIndex, Mode=TwoWay}"
                          MinHeight="44" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Görünürlük" />
              </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorderStyle}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SettingsIconTileBorderStyle}">
                  <FontIcon Glyph="&#xE962;" Foreground="{ThemeResource SettingsGeneralIconBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Etkileşim davranışı" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
                  <TextBlock Text="Dock'un fare ve tıklama davranışını belirleyin."
                             Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding InteractionModes}"
                          DisplayMemberPath="Label"
                          SelectedIndex="{Binding InteractionModeIndex, Mode=TwoWay}"
                          MinHeight="44" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Etkileşim" />
              </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRowBorderStyle}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SettingsIconTileBorderStyle}">
                  <FontIcon Glyph="&#xE7E8;" Foreground="{ThemeResource SettingsSystemIconBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Windows başlangıcı" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
                  <TextBlock Text="{Binding StartupStatusMessage}"
                             Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" MinHeight="44"
                              IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                              IsEnabled="{Binding IsStartupTaskAvailable}"
                              AutomationProperties.Name="Windows açılışında başlat" />
              </Grid>
            </Border>

            <Border Padding="16,12" MinHeight="64">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SettingsIconTileBorderStyle}">
                  <FontIcon Glyph="&#xE74C;" Foreground="{ThemeResource SettingsModulesIconBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Modüller" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
                  <TextBlock Text="{Binding EnabledModuleSummary}"
                             Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Yönet" Tag="modules"
                        MinHeight="44" Click="OnNavigateClick" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Padding="18"
              CornerRadius="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE895;" FontSize="22" Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            <StackPanel>
              <TextBlock Text="Güncelleme" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StoreUpdateStatusMessage}" FontSize="12" Opacity="0.68"
                         TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Denetle" Command="{Binding CheckForUpdatesCommand}"
                        MinHeight="44" HorizontalAlignment="Left" />
                <ProgressRing Width="20" Height="20"
                              IsActive="{Binding IsStoreUpdateChecking}"
                              Visibility="{Binding IsStoreUpdateChecking, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="Güncellemeler denetleniyor" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Rectangle Grid.Column="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE74C;" FontSize="22" Foreground="{ThemeResource SettingsModulesIconBrush}" />
            <StackPanel>
              <TextBlock Text="Aktif modüller" FontWeight="SemiBold" />
              <TextBlock Text="{Binding EnabledModuleSummary}" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
          <Rectangle Grid.Column="3" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xEA18;" FontSize="22" Foreground="{ThemeResource SettingsFocusIconBrush}" />
            <StackPanel>
              <TextBlock Text="İzinler" FontWeight="SemiBold" />
              <TextBlock Text="Yalnız gerektiğinde sorulur" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
