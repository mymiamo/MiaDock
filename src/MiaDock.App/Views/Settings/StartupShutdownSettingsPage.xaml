<UserControl x:Class="MiaDock.App.Views.Settings.StartupShutdownSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32,24,32,40">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="18">
      <TextBlock Text="Başlangıç ve kapanış" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock Text="MiaDock'un Windows ile ve pencere kapatıldığında nasıl davranacağını seçin." TextWrapping="Wrap" Opacity="0.68" />
      <ToggleSwitch Header="Windows açılışında başlat"
                    IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                    IsEnabled="{Binding IsStartupTaskAvailable}" />
      <TextBlock Text="{Binding StartupStatusMessage}" TextWrapping="Wrap" Opacity="0.68" />
      <TextBlock Text="Uygulama açıldığında" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <ComboBox ItemsSource="{Binding LaunchModes}" DisplayMemberPath="Label"
                SelectedIndex="{Binding LaunchModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Uygulama açıldığında" />
      <TextBlock Text="Pencere kapatıldığında" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <ComboBox ItemsSource="{Binding CloseBehaviors}" DisplayMemberPath="Label"
                SelectedIndex="{Binding CloseBehaviorIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Pencere kapatıldığında" />
      <InfoBar IsOpen="True" Severity="Informational" Title="Güvenli başlangıç" Message="MiaDock, kayıt defteri yerine Microsoft Store uyumlu StartupTask API'sini kullanır." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
