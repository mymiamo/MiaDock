<UserControl
    x:Class="MiaDock.App.Views.Settings.StartupShutdownSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="Başlangıç ve kapanış"
                   Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="MiaDock'un Windows ile ve pencere kapatıldığında nasıl davranacağını seçin."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE7E8;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="Windows açılışında başlat" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StartupStatusMessage}"
                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2"
                        IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                        IsEnabled="{Binding IsStartupTaskAvailable}"
                        AutomationProperties.Name="Windows açılışında başlat" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE768;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Uygulama açıldığında" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <ComboBox ItemsSource="{Binding LaunchModes}"
                      DisplayMemberPath="Label"
                      SelectedIndex="{Binding LaunchModeIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MaxWidth="360"
                      AutomationProperties.Name="Uygulama açıldığında" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE8BB;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Pencere kapatıldığında" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <ComboBox ItemsSource="{Binding CloseBehaviors}"
                      DisplayMemberPath="Label"
                      SelectedIndex="{Binding CloseBehaviorIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MaxWidth="360"
                      AutomationProperties.Name="Pencere kapatıldığında" />
          </StackPanel>
        </Grid>
      </Border>

      <InfoBar IsOpen="True"
               Severity="Informational"
               Title="Güvenli başlangıç"
               Message="MiaDock, kayıt defteri yerine Microsoft Store uyumlu StartupTask API'sini kullanır." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
