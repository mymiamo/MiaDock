<UserControl x:Class="MiaDock.App.Views.Settings.NotificationSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="Bildirimler" Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Windows bildirimlerini izin verdiğiniz kapsamda MiaDock üzerinde gösterin."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xEA8F;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Bildirim modülünü etkinleştir" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <TextBlock Text="İzin verilirse kaynak uygulama ve bildirim başlığı gösterilir."
                       Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
            <TextBlock Text="{Binding NotificationStatusMessage}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <ToggleSwitch x:Name="EnableToggle" Grid.Column="2" VerticalAlignment="Center"
                        IsEnabled="{Binding CanEnableNotifications}" Toggled="OnEnableToggled"
                        AutomationProperties.Name="Bildirim modülünü etkinleştir" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE823;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="7">
            <StackPanel>
              <TextBlock Text="Görünme süresi" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
              <TextBlock Text="Bildirimin dock üzerinde kaç saniye kalacağını belirler" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
            </StackPanel>
            <NumberBox Minimum="1" Maximum="60" MaxWidth="220" HorizontalAlignment="Stretch"
                       Value="{Binding NotificationEventSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                       AutomationProperties.Name="Görünme süresi" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE740;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Tam ekranda göster" FontWeight="SemiBold" /><TextBlock Text="Hassas içerik varsayılan olarak kapalıdır" FontSize="12" Opacity="0.66" /></StackPanel>
          <ToggleSwitch Grid.Column="2" IsOn="{Binding NotificationsInFullscreen, Mode=TwoWay}"
                        AutomationProperties.Name="Tam ekranda göster" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Yalnızca izin listesini kullan" FontWeight="SemiBold" /><TextBlock Text="Açıkken yalnız aşağıda etkinleştirilen uygulamalar gösterilir" FontSize="12" Opacity="0.66" /></StackPanel>
          <ToggleSwitch Grid.Column="2" IsOn="{Binding NotificationUseAllowList, Mode=TwoWay}"
                        AutomationProperties.Name="Yalnızca izin listesini kullan" />
        </Grid>
      </Border>

      <TextBlock Text="Uygulamalar" Style="{StaticResource SettingsSectionTitleTextBlockStyle}" Margin="0,8,0,0" />
      <TextBlock Text="Gövde metni her uygulama için ayrıca açılmalıdır. Bildirim içeriği teknik loglara yazılmaz."
                 TextWrapping="Wrap" FontSize="12" Opacity="0.66" />
      <ItemsControl ItemsSource="{Binding NotificationApplications}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="14" Margin="0,0,0,8"
                    Style="{StaticResource SettingsCardBorderStyle}">
              <StackPanel Spacing="10">
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
                  <TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <ToggleSwitch Header="Göster" IsOn="{Binding IsVisible, Mode=TwoWay}" />
                  <ToggleSwitch Grid.Column="1" Header="Gövde" IsOn="{Binding ShowBody, Mode=TwoWay}" IsEnabled="{Binding IsVisible}" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Uygulama listesi, Windows bildirim erişimi verildikten sonra dolacaktır."
                 TextWrapping="Wrap" FontSize="12" Opacity="0.58" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
