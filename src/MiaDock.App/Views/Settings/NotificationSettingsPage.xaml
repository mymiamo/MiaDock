<UserControl x:Class="MiaDock.App.Views.Settings.NotificationSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <ScrollViewer Padding="28,20,28,40"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Width="820" MaxWidth="820" HorizontalAlignment="Center" Spacing="14">
      <StackPanel Spacing="5" Margin="0,0,0,8">
        <TextBlock Text="Bildirimler" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="Windows bildirimlerini izin verdiğiniz kapsamda MiaDock üzerinde gösterin."
                   TextWrapping="Wrap" Opacity="0.72" />
      </StackPanel>

      <Border Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xEA8F;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Bildirim modülünü etkinleştir" FontWeight="SemiBold" />
            <TextBlock Text="İzin verilirse kaynak uygulama ve bildirim başlığı gösterilir."
                       TextWrapping="Wrap" FontSize="12" Opacity="0.66" />
            <TextBlock Text="{Binding NotificationStatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="#A9B9FF" />
          </StackPanel>
          <ToggleSwitch x:Name="EnableToggle" Grid.Column="2" VerticalAlignment="Center"
                        IsEnabled="{Binding CanEnableNotifications}" Toggled="OnEnableToggled" />
        </Grid>
      </Border>

      <Border Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE823;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Görünme süresi" FontWeight="SemiBold" /><TextBlock Text="Bildirim adada kaç saniye kalır" FontSize="12" Opacity="0.66" /></StackPanel>
          <NumberBox Grid.Column="2" Minimum="1" Maximum="60" Value="{Binding NotificationEventSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                     AutomationProperties.Name="Görünme süresi" />
        </Grid>
      </Border>

      <Border Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE740;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Tam ekranda göster" FontWeight="SemiBold" /><TextBlock Text="Hassas içerik varsayılan olarak kapalıdır" FontSize="12" Opacity="0.66" /></StackPanel>
          <ToggleSwitch Grid.Column="2" IsOn="{Binding NotificationsInFullscreen, Mode=TwoWay}" />
        </Grid>
      </Border>

      <Border Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Yalnızca izin listesini kullan" FontWeight="SemiBold" /><TextBlock Text="Açıkken yalnız aşağıda etkinleştirilen uygulamalar gösterilir" FontSize="12" Opacity="0.66" /></StackPanel>
          <ToggleSwitch Grid.Column="2" IsOn="{Binding NotificationUseAllowList, Mode=TwoWay}" />
        </Grid>
      </Border>

      <TextBlock Text="Uygulamalar" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <TextBlock Text="Gövde metni her uygulama için ayrıca açılmalıdır. Bildirim içeriği teknik loglara yazılmaz."
                 TextWrapping="Wrap" FontSize="12" Opacity="0.66" />
      <ItemsControl ItemsSource="{Binding NotificationApplications}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="14" Margin="0,0,0,8" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" /></StackPanel>
                <ToggleSwitch Grid.Column="1" Header="Göster" IsOn="{Binding IsVisible, Mode=TwoWay}" />
                <ToggleSwitch Grid.Column="2" Header="Gövde" IsOn="{Binding ShowBody, Mode=TwoWay}" IsEnabled="{Binding IsVisible}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Uygulama listesi, Windows bildirim erişimi verildikten sonra dolacaktır."
                 TextWrapping="Wrap" FontSize="12" Opacity="0.58" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
