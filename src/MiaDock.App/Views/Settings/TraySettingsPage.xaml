<UserControl
    x:Class="MiaDock.App.Views.Settings.TraySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="Sistem tepsisi"
                   Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Sistem tepsisi simgesinde sunulacak davranışları seçin."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="4">
          <TextBlock Text="Simgeye bir kez tıklayınca"
                     Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
          <ComboBox ItemsSource="{Binding TrayPrimaryActions}"
                    DisplayMemberPath="Label"
                    SelectedIndex="{Binding TrayPrimaryActionIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Tray tek tık davranışı" />
          <ToggleSwitch Header="Sistem tepsisi simgesini göster"
                        IsOn="{Binding ShowTrayIcon, Mode=TwoWay}"
                        AutomationProperties.Name="Sistem tepsisi simgesini göster" />
          <ToggleSwitch Header="Medya kontrollerini menüde göster"
                        IsOn="{Binding ShowTrayMediaControls, Mode=TwoWay}"
                        AutomationProperties.Name="Medya kontrollerini menüde göster" />
          <ToggleSwitch Header="Geçici bildirimleri etkinleştir"
                        IsOn="{Binding TemporaryNotifications, Mode=TwoWay}"
                        AutomationProperties.Name="Geçici bildirimleri etkinleştir" />
        </StackPanel>
      </Border>

      <InfoBar IsOpen="True"
               Severity="Informational"
               Title="Erişim"
               Message="Simgeyi kapatırsanız Ayarlara dock üzerindeki sağ tık menüsünden ulaşabilirsiniz." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
