<UserControl x:Class="MiaDock.App.Views.Settings.DiagnosticsSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="{StaticResource SettingsPagePadding}" RowSpacing="16" MaxWidth="920"
        HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
      <TextBlock Text="Tanılama" Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
      <TextBlock Text="Yerel teknik logları görüntüleyin ve yönetin."
                 Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
    </StackPanel>

    <InfoBar Grid.Row="1" IsOpen="True" Severity="Informational" Title="Gizlilik"
             Message="Loglar yalnızca bu cihazda tutulur. Şarkı, sanatçı, kullanıcı adı, kişisel yol ve medya geçmişi kaydedilmez." />

    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock Text="Performans özeti" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
      <TextBlock Text="{Binding PerformanceSummaryText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                 AutomationProperties.Name="Performans özeti" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="MeasureAnimationButton" Content="60 saniye akıcılık ölç" IsEnabled="{Binding CanStartAnimationMeasurement}" Click="OnMeasureAnimationClick" />
        <Button x:Name="StopAnimationButton" Content="Ölçümü durdur" Click="OnStopAnimationClick" />
      </StackPanel>
      <TextBlock Text="{Binding AnimationSummaryText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                 AutomationProperties.Name="UI akıcılık ölçümü" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding RuntimeSummaryText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SessionSummaryText}" TextWrapping="Wrap" Opacity="0.72" />
      <StackPanel Orientation="Horizontal" Spacing="20">
        <TextBlock Text="{Binding FileCountText}" />
        <TextBlock Text="{Binding StorageSizeText}" />
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <Grid Grid.Row="3" ColumnSpacing="8" RowSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Button Content="Yenile" Click="OnRefreshClick" Margin="0,0,8,8" />
      <Button Grid.Column="1" Content="Performansı dışa aktar" Click="OnPerformanceExportClick" Margin="0,0,8,8" />
      <Button Grid.Row="1" Content="Log klasörünü aç" Click="OnOpenFolderClick" Margin="0,0,8,8" />
      <Button Grid.Row="1" Grid.Column="1" Content="ZIP olarak dışa aktar" Click="OnExportClick" Margin="0,0,8,8" />
      <Button Grid.Row="2" Content="Logları temizle" Click="OnClearClick" Margin="0,0,8,8" />
      <Button Content="Hata bildir"
              Grid.Row="2" Grid.Column="1"
              Click="OnReportBugClick"
              AutomationProperties.Name="MiaDock hata bildirim sayfasını aç"
              Margin="0,0,0,8" />
    </Grid>

    <ListView Grid.Row="4" ItemsSource="{Binding RecentEntries}"
              AutomationProperties.Name="Son teknik log kayıtları">
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel Padding="8" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding TimestampUtc}" Opacity="0.68" />
              <TextBlock Text="{Binding Level}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
            <StackPanel>
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EventId}" Opacity="0.58" />
              <TextBlock Text="{Binding CorrelationText}" Opacity="0.58" TextWrapping="Wrap"
                         IsTextSelectionEnabled="True" />
              <TextBlock Text="{Binding ExceptionType}" Opacity="0.68" TextWrapping="Wrap"
                         IsTextSelectionEnabled="True" />
              <TextBlock Text="{Binding ExceptionChain}" Opacity="0.68" TextWrapping="Wrap"
                         IsTextSelectionEnabled="True" />
              <TextBlock Text="{Binding HResultText}" Opacity="0.68"
                         IsTextSelectionEnabled="True" />
              <TextBlock Text="{Binding PropertiesText}" Opacity="0.68" TextWrapping="Wrap"
                         IsTextSelectionEnabled="True" />
              <TextBlock Text="{Binding StackTrace}" Opacity="0.58" TextWrapping="Wrap"
                         FontFamily="Consolas" IsTextSelectionEnabled="True" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
