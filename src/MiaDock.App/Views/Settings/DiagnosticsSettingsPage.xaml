<UserControl x:Class="MiaDock.App.Views.Settings.DiagnosticsSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32,24,32,40" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="8">
      <TextBlock Text="Tanılama" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock Text="Yerel teknik logları görüntüleyin ve yönetin." Opacity="0.68" />
    </StackPanel>

    <InfoBar Grid.Row="1" IsOpen="True" Severity="Informational" Title="Gizlilik"
             Message="Loglar yalnızca bu cihazda tutulur. Şarkı, sanatçı, kullanıcı adı, kişisel yol ve medya geçmişi kaydedilmez." />

    <Grid Grid.Row="2" ColumnSpacing="20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding FileCountText}" />
      <TextBlock Grid.Column="1" Text="{Binding StorageSizeText}" />
      <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
      <Button Content="Yenile" Click="OnRefreshClick" />
      <Button Content="Log klasörünü aç" Click="OnOpenFolderClick" />
      <Button Content="ZIP olarak dışa aktar" Click="OnExportClick" />
      <Button Content="Logları temizle" Click="OnClearClick" />
    </StackPanel>

    <ListView Grid.Row="4" ItemsSource="{Binding RecentEntries}"
              AutomationProperties.Name="Son teknik log kayıtları">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Padding="8" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TimestampUtc}" Opacity="0.68" />
            <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="3">
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding EventId}" Opacity="0.58" />
              <TextBlock Text="{Binding ExceptionType}" Opacity="0.58" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
