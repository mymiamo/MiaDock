<UserControl
    x:Class="MiaDock.App.Views.Settings.HotKeysSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiaDock.App.Controls">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="Kısayollar" Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Dock ve modüller için global klavye kısayollarını yönetin."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Padding="18" Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Global kısayollar" Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
          <TextBlock Text="Kısayol kaydetmek için düğmeye tıklayın ve Ctrl, Alt veya Shift içeren kombinasyona basın. Windows tuşu ve F12 kullanılamaz."
                     TextWrapping="Wrap" Opacity="0.72" />
          <ToggleSwitch Header="Global kısayolları etkinleştir"
                        IsOn="{Binding HotKeysEnabled, Mode=TwoWay}"
                        OnContent="{Binding HotKeysOnText}"
                        OffContent="{Binding HotKeysOffText}" />
          <TextBlock Text="{Binding HotKeyStatusMessage}" TextWrapping="Wrap" Opacity="0.72" />
          <Button Content="Tüm kısayolları varsayılana döndür"
                  Command="{Binding RestoreDefaultHotKeysCommand}"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="Tüm global kısayolları varsayılan atamalara döndür" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="Dock'u göster / gizle" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
          <controls:HotKeyRecorderControl
                                        Gesture="{Binding ToggleDockHotKey, Mode=TwoWay}"
                                        DefaultGesture="{Binding ToggleDockDefaultHotKey}"
                                        StatusText="{Binding ToggleDockHotKeyStatus}"
                                        AccessibleName="{Binding ToggleDockHotKeyAccessibleName}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Dock'u genişlet / küçült" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
          <controls:HotKeyRecorderControl
                                        Gesture="{Binding ToggleExpandedHotKey, Mode=TwoWay}"
                                        DefaultGesture="{Binding ToggleExpandedDefaultHotKey}"
                                        StatusText="{Binding ToggleExpandedHotKeyStatus}"
                                        AccessibleName="{Binding ToggleExpandedHotKeyAccessibleName}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Sonraki modül" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
          <controls:HotKeyRecorderControl
                                        Gesture="{Binding NextModuleHotKey, Mode=TwoWay}"
                                        DefaultGesture="{Binding NextModuleDefaultHotKey}"
                                        StatusText="{Binding NextModuleHotKeyStatus}"
                                        AccessibleName="{Binding NextModuleHotKeyAccessibleName}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Medyayı oynat / duraklat" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
          <controls:HotKeyRecorderControl
                                        Gesture="{Binding MediaPlayPauseHotKey, Mode=TwoWay}"
                                        DefaultGesture="{Binding MediaPlayPauseDefaultHotKey}"
                                        StatusText="{Binding MediaPlayPauseHotKeyStatus}"
                                        AccessibleName="{Binding MediaPlayPauseHotKeyAccessibleName}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Zamanlayıcıyı duraklat / sürdür" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
          <controls:HotKeyRecorderControl
                                        Gesture="{Binding TimerPauseResumeHotKey, Mode=TwoWay}"
                                        DefaultGesture="{Binding TimerPauseResumeDefaultHotKey}"
                                        StatusText="{Binding TimerPauseResumeHotKeyStatus}"
                                        AccessibleName="{Binding TimerPauseResumeHotKeyAccessibleName}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
