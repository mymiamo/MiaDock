<UserControl
    x:Class="MiaDock.App.Views.Settings.MonitorSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="Monitör"
                   Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Dock'un hangi ekranda gösterileceğini seçin."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE7F4;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Monitör davranışı" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <ComboBox ItemsSource="{Binding MonitorModes}"
                      DisplayMemberPath="Label"
                      SelectedIndex="{Binding MonitorModeIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MaxWidth="380"
                      AutomationProperties.Name="Monitör davranışı" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE714;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Sabit monitör" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <ComboBox ItemsSource="{Binding Displays}"
                      DisplayMemberPath="DisplayName"
                      SelectedIndex="{Binding FixedMonitorIndex, Mode=TwoWay}"
                      PlaceholderText="Bir monitör seçin"
                      HorizontalAlignment="Stretch"
                      MaxWidth="380"
                      AutomationProperties.Name="Sabit monitör" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Ekrana özel görünüm" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
          <TextBlock Text="Genel görünümü bir profil olarak kaydedin ve bu bilgisayardaki bir ekranla eşleştirin. Eşleştirilmemiş ekranlar genel görünümü kullanır."
                     TextWrapping="Wrap" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
          <TextBox x:Name="ProfileName" Header="Profil adı" MaxLength="64" AutomationProperties.Name="Profil adı" />
          <ComboBox x:Name="ProfileDisplay" Header="Profilin kullanılacağı ekran" DisplayMemberPath="DisplayName" SelectedIndex="0"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="Profilin kullanılacağı ekran" />
          <Button Content="Genel görünümü kaydet" Click="OnSaveProfileClick" />
          <ComboBox x:Name="SavedProfile" Header="Kayıtlı görünüm profili" DisplayMemberPath="Name" SelectedIndex="0"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="Kayıtlı görünüm profili" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Ekranla eşleştir" Click="OnAssignProfileClick" />
            <Button Content="Genel görünüme dön" Click="OnUnassignProfileClick" />
            <Button Content="Profili kaldır" Click="OnRemoveProfileClick" />
          </StackPanel>
          <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>

      <InfoBar IsOpen="True"
               Severity="Informational"
               Title="Güvenli geçiş"
               Message="Seçilen monitör bağlantısı kesilirse dock otomatik olarak ana monitöre taşınır." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
