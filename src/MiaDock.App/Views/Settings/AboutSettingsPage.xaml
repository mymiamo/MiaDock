<UserControl
    x:Class="MiaDock.App.Views.Settings.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <TextBlock Text="Hakkında"
                 Style="{StaticResource SettingsPageTitleTextBlockStyle}" />

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Width="56"
                 Height="56"
                 Source="ms-appx:///Assets/AppLogo.png"
                 Stretch="Uniform"
                 AutomationProperties.Name="MiaDock logosu" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="MiaDock" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Windows 11 ile doğal şekilde bütünleşen modüler sistem dock'u."
                       TextWrapping="Wrap" Opacity="0.68" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Sürüm" FontWeight="SemiBold" />
              <TextBlock Text="{Binding VersionText}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="UpdateActionColumn" Width="0" />
          </Grid.ColumnDefinitions>
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
              <VisualState x:Name="CompactUpdateCard" />
              <VisualState x:Name="WideUpdateCard">
                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                <VisualState.Setters>
                  <Setter Target="UpdateActionColumn.Width" Value="Auto" />
                  <Setter Target="UpdateActionPanel.(Grid.Row)" Value="0" />
                  <Setter Target="UpdateActionPanel.(Grid.Column)" Value="2" />
                  <Setter Target="UpdateActionPanel.Margin" Value="0" />
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE895;"
                      Foreground="{ThemeResource SettingsNotificationIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="Microsoft Store güncellemeleri" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <TextBlock Text="{Binding StoreUpdateStatusMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding StoreUpdateVersionText}"
                       FontSize="12" Opacity="0.68" />
          </StackPanel>
          <StackPanel x:Name="UpdateActionPanel" Grid.Row="1" Grid.Column="1" Spacing="8"
                      Margin="0,8,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Button Content="Güncellemeleri denetle"
                    Command="{Binding CheckForUpdatesCommand}"
                    AutomationProperties.Name="Güncellemeleri denetle" />
            <Button Content="Microsoft Store'da aç"
                    Command="{Binding OpenStoreCommand}"
                    IsEnabled="{Binding IsStoreUpdateAvailable}"
                    AutomationProperties.Name="Microsoft Store'da aç" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="Bağlantılar"
                 Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
      <StackPanel Spacing="8">
        <Button Tag="github"
                Click="OnExternalLinkClick"
                Style="{StaticResource SettingsLinkCardButtonStyle}"
                AutomationProperties.Name="GitHub sayfasını varsayılan tarayıcıda aç">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE943;" Foreground="{ThemeResource SettingsSystemIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="GitHub" FontWeight="SemiBold" />
              <TextBlock Text="Kaynak kodu, sürümleri ve proje gelişimini görüntüleyin."
                         TextWrapping="Wrap" Opacity="0.72" />
              <TextBlock Text="github.com/mymiamo/MiaDock" FontSize="12" Opacity="0.58" />
            </StackPanel>
            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14"
                      VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Button Tag="instagram"
                Click="OnExternalLinkClick"
                Style="{StaticResource SettingsLinkCardButtonStyle}"
                AutomationProperties.Name="Instagram sayfasını varsayılan tarayıcıda aç">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE722;" Foreground="{ThemeResource SettingsAppearanceIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Instagram" FontWeight="SemiBold" />
              <TextBlock Text="MiaMo'nun duyurularını ve sosyal paylaşımlarını takip edin."
                         TextWrapping="Wrap" Opacity="0.72" />
              <TextBlock Text="instagram.com/mymiamonet" FontSize="12" Opacity="0.58" />
            </StackPanel>
            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14"
                      VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Button Tag="website"
                Click="OnExternalLinkClick"
                Style="{StaticResource SettingsLinkCardButtonStyle}"
                AutomationProperties.Name="MiaMo web sitesini varsayılan tarayıcıda aç">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE774;" Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Web sitesi" FontWeight="SemiBold" />
              <TextBlock Text="MiaMo projelerini ve güncel bilgileri keşfedin."
                         TextWrapping="Wrap" Opacity="0.72" />
              <TextBlock Text="mymiamo.net" FontSize="12" Opacity="0.58" />
            </StackPanel>
            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="14"
                      VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>

      <InfoBar x:Name="ExternalLinkError"
               IsOpen="False"
               IsClosable="True"
               Severity="Warning"
               Title="Bağlantı açılamadı"
               AutomationProperties.LiveSetting="Assertive" />

      <TextBlock Text="Ayar dosyası"
                 Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
      <TextBox Text="{Binding SettingsFilePath}"
               IsReadOnly="True"
               TextWrapping="Wrap" />

      <InfoBar IsOpen="True"
               IsClosable="False"
               Severity="Informational"
               Title="Gizlilik"
               Message="Temel özellikler çevrimdışı çalışır. MiaDock telemetri, kullanıcı hesabı veya otomatik hata gönderimi kullanmaz." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
