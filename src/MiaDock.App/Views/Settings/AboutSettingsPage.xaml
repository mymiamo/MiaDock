<UserControl
    x:Class="MiaDock.App.Views.Settings.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="28,24,28,48"
                HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <TextBlock Text="Hakkında"
                 Style="{StaticResource SettingsPageTitleTextBlockStyle}" />

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Width="56"
                 Height="56"
                 Source="ms-appx:///Assets/AppLogo.png"
                 Stretch="Uniform"
                 AutomationProperties.Name="MiaDock logosu" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="MiaDock" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Windows 11 ile doğal şekilde bütünleşen modüler sistem dock'u."
                       TextWrapping="Wrap" Opacity="0.68" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Sürüm" FontWeight="SemiBold" />
              <TextBlock Text="{Binding VersionText}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE895;"
                      Foreground="{ThemeResource SettingsNotificationIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="Microsoft Store güncellemeleri" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StoreUpdateStatusMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding StoreUpdateVersionText}"
                       FontSize="12" Opacity="0.68" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
            <Button Content="Güncellemeleri denetle"
                    Command="{Binding CheckForUpdatesCommand}" />
            <Button Content="Microsoft Store'da aç"
                    Command="{Binding OpenStoreCommand}"
                    IsEnabled="{Binding IsStoreUpdateAvailable}" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="Ayar dosyası"
                 Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
      <TextBox Text="{Binding SettingsFilePath}"
               IsReadOnly="True"
               TextWrapping="Wrap" />

      <InfoBar IsOpen="True"
               IsClosable="False"
               Severity="Informational"
               Title="Gizlilik"
               Message="Temel özellikler çevrimdışı çalışır. MiaDock telemetri, kullanıcı hesabı veya otomatik hata gönderimi kullanmaz." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
