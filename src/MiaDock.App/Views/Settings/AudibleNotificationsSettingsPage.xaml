<UserControl x:Class="MiaDock.App.Views.Settings.AudibleNotificationsSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="{Binding AudibleNotificationsTitle}"
                   Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="{Binding AudibleNotificationsDescription}"
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Width="20" Height="20" VerticalAlignment="Center"
                 Source="ms-appx:///Assets/FluentIcons/settings_24_regular.svg"
                 AutomationProperties.AccessibilityView="Raw" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding AudibleNotificationsMasterTitle}"
                       Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <TextBlock Text="{Binding AudibleNotificationsMasterDescription}"
                       TextWrapping="Wrap"
                       Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2"
                        MinWidth="44"
                        MinHeight="44"
                        IsOn="{Binding AudibleNotificationsEnabled, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding AudibleNotificationsMasterTitle}" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding AudibleOutputDeviceTitle}" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <TextBlock Text="{Binding AudibleOutputDeviceDescription}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
          </StackPanel>
          <ComboBox ItemsSource="{Binding AudibleOutputDevices}" DisplayMemberPath="Label"
                    SelectedIndex="{Binding AudibleOutputDeviceIndex, Mode=TwoWay}"
                    IsEnabled="{Binding AudibleNotificationControlsEnabled}" MinHeight="44"
                    AutomationProperties.Name="{Binding AudibleOutputDeviceTitle}" />
          <Grid>
            <TextBlock Text="{Binding AudibleVolumeTitle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding AudibleVolumePercentText}" HorizontalAlignment="Right" />
          </Grid>
          <Slider Minimum="0" Maximum="100" StepFrequency="1"
                  Value="{Binding AudibleVolumePercent, Mode=TwoWay}"
                  IsEnabled="{Binding AudibleNotificationControlsEnabled}"
                  AutomationProperties.Name="{Binding AudibleVolumeTitle}" />
          <Button Content="{Binding StopPreviewSoundText}" Command="{Binding StopPreviewSoundCommand}"
                  HorizontalAlignment="Left" MinHeight="44"
                  AutomationProperties.Name="{Binding StopPreviewSoundText}" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding AudibleNotificationsEventsTitle}"
                 Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding NetworkOfflineSoundTitle}" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
              <TextBlock Text="{Binding NetworkOfflineSoundDescription}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" MinWidth="88" Content="{Binding PreviewSoundText}"
                    Command="{Binding PreviewNetworkOfflineSoundCommand}"
                    AutomationProperties.Name="{Binding NetworkOfflineSoundPreviewName}" />
            <ToggleSwitch Grid.Column="2" MinHeight="44" MinWidth="44"
                          IsEnabled="{Binding AudibleNotificationControlsEnabled}"
                          IsOn="{Binding NetworkOfflineSoundEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding NetworkOfflineSoundTitle}" />
          </Grid>
          <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding ConnectedWithoutInternetSoundTitle}" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
              <TextBlock Text="{Binding ConnectedWithoutInternetSoundDescription}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" MinWidth="88" Content="{Binding PreviewSoundText}"
                    Command="{Binding PreviewConnectedWithoutInternetSoundCommand}"
                    AutomationProperties.Name="{Binding ConnectedWithoutInternetSoundPreviewName}" />
            <ToggleSwitch Grid.Column="2" MinHeight="44" MinWidth="44"
                          IsEnabled="{Binding AudibleNotificationControlsEnabled}"
                          IsOn="{Binding ConnectedWithoutInternetSoundEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding ConnectedWithoutInternetSoundTitle}" />
          </Grid>
          <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding LowBatterySoundTitle}" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
              <TextBlock Text="{Binding LowBatterySoundDescription}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" MinWidth="88" Content="{Binding PreviewSoundText}"
                    Command="{Binding PreviewLowBatterySoundCommand}"
                    AutomationProperties.Name="{Binding LowBatterySoundPreviewName}" />
            <ToggleSwitch Grid.Column="2" MinHeight="44" MinWidth="44"
                          IsEnabled="{Binding AudibleNotificationControlsEnabled}"
                          IsOn="{Binding LowBatterySoundEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding LowBatterySoundTitle}" />
          </Grid>
          <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding DeviceConnectedSoundTitle}" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
              <TextBlock Text="{Binding DeviceConnectedSoundDescription}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" MinWidth="88" Content="{Binding PreviewSoundText}"
                    Command="{Binding PreviewDeviceConnectedSoundCommand}"
                    AutomationProperties.Name="{Binding DeviceConnectedSoundPreviewName}" />
            <ToggleSwitch Grid.Column="2" MinHeight="44" MinWidth="44"
                          IsEnabled="{Binding AudibleNotificationControlsEnabled}"
                          IsOn="{Binding DeviceConnectedSoundEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding DeviceConnectedSoundTitle}" />
          </Grid>
          <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding DeviceDisconnectedSoundTitle}" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
              <TextBlock Text="{Binding DeviceDisconnectedSoundDescription}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" MinWidth="88" Content="{Binding PreviewSoundText}"
                    Command="{Binding PreviewDeviceDisconnectedSoundCommand}"
                    AutomationProperties.Name="{Binding DeviceDisconnectedSoundPreviewName}" />
            <ToggleSwitch Grid.Column="2" MinHeight="44" MinWidth="44"
                          IsEnabled="{Binding AudibleNotificationControlsEnabled}"
                          IsOn="{Binding DeviceDisconnectedSoundEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding DeviceDisconnectedSoundTitle}" />
          </Grid>
          <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding HourlySoundTitle}" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
              <TextBlock Text="{Binding HourlySoundDescription}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" MinWidth="88" Content="{Binding PreviewSoundText}"
                    Command="{Binding PreviewHourlySoundCommand}"
                    AutomationProperties.Name="{Binding HourlySoundPreviewName}" />
            <ToggleSwitch Grid.Column="2" MinHeight="44" MinWidth="44"
                          IsEnabled="{Binding AudibleNotificationControlsEnabled}"
                          IsOn="{Binding HourlySoundEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding HourlySoundTitle}" />
          </Grid>
        </StackPanel>
      </Border>

      <InfoBar IsOpen="True"
               IsClosable="False"
               Severity="Informational"
               Title="{Binding AlarmSoundTitle}"
               Message="{Binding AlarmSoundDescription}"
               AutomationProperties.Name="{Binding AlarmSoundTitle}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
