<UserControl x:Class="MiaDock.App.Views.Settings.MediaSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls">
  <UserControl.Resources>
    <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="Medya" Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Windows medya oturumlarından kullanılacak kaynağı ve kontrol davranışını seçin."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="8"
                    Visibility="{Binding IsMediaLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ProgressRing Width="18" Height="18" IsActive="True" />
          <TextBlock Text="Medya kaynakları hazırlanıyor…" VerticalAlignment="Center" Opacity="0.72" />
        </StackPanel>
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE8D6;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="8">
            <StackPanel><TextBlock Text="Varsayılan medya uygulaması" Style="{StaticResource SettingsCardTitleTextBlockStyle}" /><TextBlock Text="Dock yalnız seçtiğiniz kaynağı izleyebilir" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" /></StackPanel>
            <ComboBox ItemsSource="{Binding MediaSources}" DisplayMemberPath="DisplayName"
                     SelectedIndex="{Binding MediaSourceIndex, Mode=TwoWay}" PlaceholderText="Sistem oturumu" HorizontalAlignment="Stretch"
                     MaxWidth="360" AutomationProperties.Name="Varsayılan medya uygulaması" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE72C;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="8">
            <StackPanel><TextBlock Text="Kaynak kullanılamadığında" Style="{StaticResource SettingsCardTitleTextBlockStyle}" /><TextBlock Text="Başka bir aktif oturuma geçilip geçilmeyeceğini belirler" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" /></StackPanel>
            <ComboBox ItemsSource="{Binding MediaFallbackModes}" DisplayMemberPath="Label"
                     SelectedIndex="{Binding MediaFallbackIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                     MaxWidth="360" AutomationProperties.Name="Kaynak kullanılamadığında" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE767;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="8">
            <StackPanel><TextBlock Text="Ses denetimi hedefi" Style="{StaticResource SettingsCardTitleTextBlockStyle}" /><TextBlock Text="Ana sesi veya eşleşen uygulama oturumunu kontrol eder" Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" /></StackPanel>
            <ComboBox ItemsSource="{Binding VolumeTargets}" DisplayMemberPath="Label"
                     SelectedIndex="{Binding VolumeTargetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                     MaxWidth="360" AutomationProperties.Name="Ses denetimi hedefi" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
