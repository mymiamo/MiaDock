<UserControl x:Class="MiaDock.App.Views.Settings.MediaSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="28,20,28,40"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Spacing="5" Margin="0,0,0,10">
        <TextBlock Text="Medya" Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Windows medya oturumlarından kullanılacak kaynağı ve kontrol davranışını seçin."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE8D6;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Varsayılan medya uygulaması" FontWeight="SemiBold" /><TextBlock Text="Dock yalnız seçtiğiniz kaynağı izleyebilir" FontSize="12" Opacity="0.66" /></StackPanel>
          <ComboBox Grid.Column="2" ItemsSource="{Binding MediaSources}" DisplayMemberPath="DisplayName"
                    SelectedIndex="{Binding MediaSourceIndex, Mode=TwoWay}" PlaceholderText="Sistem oturumu" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Varsayılan medya uygulaması" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE72C;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Kaynak kullanılamadığında" FontWeight="SemiBold" /><TextBlock Text="Başka bir aktif oturuma geçilip geçilmeyeceğini belirler" FontSize="12" Opacity="0.66" TextWrapping="Wrap" /></StackPanel>
          <ComboBox Grid.Column="2" ItemsSource="{Binding MediaFallbackModes}" DisplayMemberPath="Label"
                    SelectedIndex="{Binding MediaFallbackIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Kaynak kullanılamadığında" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE767;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"><TextBlock Text="Ses denetimi hedefi" FontWeight="SemiBold" /><TextBlock Text="Ana sesi veya eşleşen uygulama oturumunu kontrol eder" FontSize="12" Opacity="0.66" TextWrapping="Wrap" /></StackPanel>
          <ComboBox Grid.Column="2" ItemsSource="{Binding VolumeTargets}" DisplayMemberPath="Label"
                    SelectedIndex="{Binding VolumeTargetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Ses denetimi hedefi" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
