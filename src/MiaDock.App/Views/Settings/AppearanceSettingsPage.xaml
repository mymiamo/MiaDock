<UserControl x:Class="MiaDock.App.Views.Settings.AppearanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="28,20,28,40"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel MaxWidth="820" HorizontalAlignment="Center" Spacing="16">
      <TextBlock Text="Görünüm" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock Text="Tema, boyut ve hareket ayarları adada anında önizlenir."
                 TextWrapping="Wrap" Opacity="0.68" />

      <TextBlock Text="Tema" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Padding="16" CornerRadius="10"
              Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="Yüzey stili" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ThemeDescription}" FontSize="12" Opacity="0.68"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox Grid.Column="2"
                    ItemsSource="{Binding Themes}"
                    DisplayMemberPath="Label"
                    SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Tema" />
        </Grid>
      </Border>
      <InfoBar IsOpen="{Binding IsBlurredGlassTheme}"
               Severity="Informational"
               Title="Saydam Bulanık Cam"
               Message="Bu tema sabit bir arka plan rengi kullanmaz; masaüstünü gerçek Windows Acrylic ile bulanık gösterir. Opaklık, yalnızca ince cam katmanının yoğunluğunu değiştirir." />

      <TextBlock Text="Ada boyutları" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Padding="16" CornerRadius="10"
              Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="Kapalı genişlik" /><NumberBox Minimum="120" Maximum="360" Value="{Binding CollapsedWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Kapalı genişlik" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Kapalı yükseklik" /><NumberBox Minimum="32" Maximum="96" Value="{Binding CollapsedHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Kapalı yükseklik" /></StackPanel>
          </Grid>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="Hover genişliği" /><NumberBox Minimum="180" Maximum="520" Value="{Binding HoverWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Hover genişliği" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Hover yüksekliği" /><NumberBox Minimum="48" Maximum="160" Value="{Binding HoverHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Hover yüksekliği" /></StackPanel>
          </Grid>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="Genişletilmiş genişlik" /><NumberBox Minimum="320" Maximum="720" Value="{Binding ExpandedWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Genişletilmiş genişlik" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Genişletilmiş yükseklik" /><NumberBox Minimum="260" Maximum="420" Value="{Binding ExpandedHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Genişletilmiş yükseklik" /></StackPanel>
          </Grid>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="Bildirim genişliği" /><NumberBox Minimum="240" Maximum="620" Value="{Binding NotificationWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Bildirim genişliği" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Bildirim yüksekliği" /><NumberBox Minimum="64" Maximum="180" Value="{Binding NotificationHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Bildirim yüksekliği" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Yüzey ve renk" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Padding="16" CornerRadius="10"
              Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Köşe yuvarlaklığı" />
          <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="48"
                  Value="{Binding CornerRadius, Mode=TwoWay}"
                  Header="{Binding Value, ElementName=CornerRadiusSlider}"
                  AutomationProperties.Name="Köşe yuvarlaklığı" />
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
              <TextBlock Text="Arka plan rengi" />
              <TextBox MaxLength="7"
                       Text="{Binding BackgroundColor, Mode=TwoWay}"
                       IsEnabled="{Binding IsBackgroundColorEditable}"
                       PlaceholderText="#000000"
                       AutomationProperties.Name="Arka plan rengi" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="Vurgu rengi" />
              <TextBox MaxLength="7" Text="{Binding AccentColor, Mode=TwoWay}"
                       PlaceholderText="#FFFFFF" AutomationProperties.Name="Vurgu rengi" />
            </StackPanel>
          </Grid>
          <Grid><TextBlock Text="Cam / yüzey yoğunluğu" /><TextBlock Text="{Binding Value, ElementName=OpacitySlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" StepFrequency="0.01"
                  Value="{Binding Opacity, Mode=TwoWay}" AutomationProperties.Name="Cam veya yüzey yoğunluğu" />
          <Grid><TextBlock Text="Gölge yoğunluğu" /><TextBlock Text="{Binding Value, ElementName=ShadowIntensitySlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="ShadowIntensitySlider" Minimum="0" Maximum="1" StepFrequency="0.05"
                  Value="{Binding ShadowIntensity, Mode=TwoWay}" AutomationProperties.Name="Gölge yoğunluğu" />
        </StackPanel>
      </Border>

      <TextBlock Text="Hareket" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Padding="16" CornerRadius="10"
              Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Animasyon türü" />
          <ComboBox ItemsSource="{Binding AnimationKinds}" DisplayMemberPath="Label"
                    SelectedIndex="{Binding AnimationKindIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="Animasyon türü" />
          <Grid><TextBlock Text="Animasyon hızı" /><TextBlock Text="{Binding Value, ElementName=AnimationSpeedSlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="AnimationSpeedSlider" Minimum="0.5" Maximum="2" StepFrequency="0.1"
                  Value="{Binding AnimationSpeed, Mode=TwoWay}" AutomationProperties.Name="Animasyon hızı" />
        </StackPanel>
      </Border>

      <Button Content="Görünüm ayarlarını varsayılana döndür"
              Command="{Binding ResetAppearanceCommand}"
              HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
