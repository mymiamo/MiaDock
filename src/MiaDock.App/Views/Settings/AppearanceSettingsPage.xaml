<UserControl x:Class="MiaDock.App.Views.Settings.AppearanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             DataContextChanged="OnDataContextChanged">
  <ScrollViewer Padding="28,20,28,40"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <TextBlock Text="Görünüm" Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
      <TextBlock Text="Tema, boyut ve hareket ayarları dock üzerinde anında önizlenir."
                 Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />

      <TextBlock Text="Tema" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="Yüzey stili" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ThemeDescription}" FontSize="12" Opacity="0.68"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox Grid.Column="2"
                    ItemsSource="{Binding Themes}"
                    DisplayMemberPath="Label"
                    SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Tema" />
        </Grid>
      </Border>
      <InfoBar IsOpen="{Binding IsBlurredGlassTheme}"
               Severity="Informational"
               Title="Saydam Bulanık Cam"
               Message="Bu tema sabit bir arka plan rengi kullanmaz; masaüstünü gerçek Windows Acrylic ile bulanık gösterir. Opaklık, yalnızca ince cam katmanının yoğunluğunu değiştirir." />

      <TextBlock Text="Canlı dock önizlemesi" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="14">
          <Grid x:Name="PreviewStage"
                Height="230"
                CornerRadius="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Border x:Name="PreviewDock"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource IslandStyleSurfaceBrush}"
                    BorderBrush="{ThemeResource DockSurfaceStrokeBrush}"
                    BorderThickness="1">
              <Grid Padding="14,0">
                <Grid x:Name="CompactPreviewContent" ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="21:39" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="MiaDock" VerticalAlignment="Center" Opacity="0.68" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE701;" FontSize="12" Foreground="{ThemeResource IslandStyleAccentBrush}" />
                    <FontIcon Glyph="&#xE995;" FontSize="12" />
                  </StackPanel>
                </Grid>

                <Grid x:Name="HoverPreviewContent" Visibility="Collapsed" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="21:39" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Bugün" FontSize="11" Opacity="0.64" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Çalan Parça" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Sanatçı" FontSize="11" Opacity="0.64" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                    <FontIcon Glyph="&#xE769;" FontSize="12" />
                  </StackPanel>
                </Grid>

                <Grid x:Name="ExpandedPreviewContent" Visibility="Collapsed" Padding="4,12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <TextBlock Text="Aktif merkez" FontWeight="SemiBold" />
                    <TextBlock Text="21:39" HorizontalAlignment="Right" Opacity="0.72" />
                  </Grid>
                  <Border Grid.Row="1" Margin="0,10" Padding="12"
                          Background="{ThemeResource DockSectionBrush}"
                          CornerRadius="12">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource IslandStyleAccentBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Müzik" FontWeight="SemiBold" />
                        <TextBlock Text="Çalan Parça · Sanatçı" FontSize="11" Opacity="0.64" />
                      </StackPanel>
                      <FontIcon Grid.Column="2" Glyph="&#xE769;" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <Ellipse Width="5" Height="5" Fill="{ThemeResource IslandStyleAccentBrush}" />
                    <Ellipse Width="5" Height="5" Fill="{ThemeResource IslandIconButtonForegroundBrush}" Opacity="0.4" />
                    <Ellipse Width="5" Height="5" Fill="{ThemeResource IslandIconButtonForegroundBrush}" Opacity="0.4" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CompactPreviewButton" Content="Compact" Tag="Compact"
                    HorizontalAlignment="Stretch" Click="OnPreviewModeClick"
                    AutomationProperties.Name="Compact önizleme" />
            <Button x:Name="HoverPreviewButton" Grid.Column="1" Content="Hover" Tag="Hover"
                    HorizontalAlignment="Stretch" Click="OnPreviewModeClick"
                    AutomationProperties.Name="Hover önizleme" />
            <Button x:Name="ExpandedPreviewButton" Grid.Column="2" Content="Genişletilmiş" Tag="Expanded"
                    HorizontalAlignment="Stretch" Click="OnPreviewModeClick"
                    AutomationProperties.Name="Genişletilmiş önizleme" />
            <Button Grid.Column="3" Content="Animasyonu dene" Click="OnTestAnimationClick"
                    AutomationProperties.Name="Dock animasyonunu dene" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Dock boyutları" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="Kapalı genişlik" /><NumberBox Minimum="120" Maximum="360" Value="{Binding CollapsedWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Kapalı genişlik" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Kapalı yükseklik" /><NumberBox Minimum="32" Maximum="96" Value="{Binding CollapsedHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Kapalı yükseklik" /></StackPanel>
          </Grid>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="Hover genişliği" /><NumberBox Minimum="180" Maximum="520" Value="{Binding HoverWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Hover genişliği" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Hover yüksekliği" /><NumberBox Minimum="48" Maximum="160" Value="{Binding HoverHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Hover yüksekliği" /></StackPanel>
          </Grid>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="Genişletilmiş genişlik" /><NumberBox Minimum="548" Maximum="720" Value="{Binding ExpandedWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Genişletilmiş genişlik" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Genişletilmiş yükseklik" /><NumberBox Minimum="360" Maximum="420" Value="{Binding ExpandedHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Genişletilmiş yükseklik" /></StackPanel>
          </Grid>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="Bildirim genişliği" /><NumberBox Minimum="240" Maximum="620" Value="{Binding NotificationWidth, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Bildirim genişliği" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Bildirim yüksekliği" /><NumberBox Minimum="64" Maximum="180" Value="{Binding NotificationHeight, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="Bildirim yüksekliği" /></StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Yüzey ve renk" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Köşe yuvarlaklığı" />
          <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="48"
                  Value="{Binding CornerRadius, Mode=TwoWay}"
                  Header="{Binding Value, ElementName=CornerRadiusSlider}"
                  AutomationProperties.Name="Köşe yuvarlaklığı" />
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
              <TextBlock Text="Arka plan rengi" />
              <TextBox MaxLength="7"
                       Text="{Binding BackgroundColor, Mode=TwoWay}"
                       IsEnabled="{Binding IsBackgroundColorEditable}"
                       PlaceholderText="#000000"
                       AutomationProperties.Name="Arka plan rengi" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="Vurgu rengi" />
              <TextBox MaxLength="7" Text="{Binding AccentColor, Mode=TwoWay}"
                       IsEnabled="{Binding IsAccentColorEditable}"
                       PlaceholderText="#FFFFFF" AutomationProperties.Name="Vurgu rengi" />
            </StackPanel>
          </Grid>
          <Grid><TextBlock Text="Cam / yüzey yoğunluğu" /><TextBlock Text="{Binding Value, ElementName=OpacitySlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" StepFrequency="0.01"
                  Value="{Binding Opacity, Mode=TwoWay}" AutomationProperties.Name="Cam veya yüzey yoğunluğu" />
          <Grid><TextBlock Text="Gölge yoğunluğu" /><TextBlock Text="{Binding Value, ElementName=ShadowIntensitySlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="ShadowIntensitySlider" Minimum="0" Maximum="1" StepFrequency="0.05"
                  Value="{Binding ShadowIntensity, Mode=TwoWay}" AutomationProperties.Name="Gölge yoğunluğu" />
        </StackPanel>
      </Border>

      <TextBlock Text="Hareket" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Hareket profili" />
          <ComboBox ItemsSource="{Binding MotionPresets}" DisplayMemberPath="Label"
                    SelectedIndex="{Binding MotionPresetIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="Hareket profili" />
          <Grid><TextBlock Text="Animasyon hızı" /><TextBlock Text="{Binding Value, ElementName=AnimationSpeedSlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="AnimationSpeedSlider" Minimum="0.5" Maximum="2" StepFrequency="0.1"
                  Value="{Binding AnimationSpeed, Mode=TwoWay}" AutomationProperties.Name="Animasyon hızı" />
          <Grid><TextBlock Text="Hareket yoğunluğu" /><TextBlock Text="{Binding Value, ElementName=MotionIntensitySlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="MotionIntensitySlider" Minimum="0" Maximum="1" StepFrequency="0.05"
                  Value="{Binding MotionIntensity, Mode=TwoWay}" AutomationProperties.Name="Hareket yoğunluğu" />
          <Grid><TextBlock Text="Yaylanma" /><TextBlock Text="{Binding Value, ElementName=MotionSpringSlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="MotionSpringSlider" Minimum="0" Maximum="1" StepFrequency="0.05"
                  Value="{Binding MotionSpringiness, Mode=TwoWay}" AutomationProperties.Name="Yaylanma" />
          <Grid><TextBlock Text="İçerik gecikmesi (ms)" /><TextBlock Text="{Binding Value, ElementName=MotionDelaySlider}" HorizontalAlignment="Right" Opacity="0.7" /></Grid>
          <Slider x:Name="MotionDelaySlider" Minimum="0" Maximum="120" StepFrequency="5"
                  Value="{Binding MotionContentDelayMilliseconds, Mode=TwoWay}" AutomationProperties.Name="İçerik animasyonu gecikmesi" />
          <ToggleSwitch Header="Hafif parallax"
                        OffContent="Kapalı" OnContent="Açık"
                        IsOn="{Binding MotionParallax, Mode=TwoWay}"
                        AutomationProperties.Name="Hafif parallax" />
          <ToggleSwitch Header="Geçici cam vurgusu"
                        OffContent="Kapalı" OnContent="Açık"
                        IsOn="{Binding MotionTransientBlur, Mode=TwoWay}"
                        AutomationProperties.Name="Geçici cam vurgusu" />
          <TextBlock Text="Windows'ta animasyonları azalt seçeneği açıksa bu ayarlar otomatik olarak devre dışı bırakılır."
                     Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
        </StackPanel>
      </Border>

      <Button Content="Görünüm ayarlarını varsayılana döndür"
              Command="{Binding ResetAppearanceCommand}"
              HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
