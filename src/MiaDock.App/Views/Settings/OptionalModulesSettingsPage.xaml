<UserControl
    x:Class="MiaDock.App.Views.Settings.OptionalModulesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="İsteğe bağlı modüller" Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Ana dock deneyimini tamamlayan isteğe bağlı olay ve yardımcı özellikler."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Padding="18" Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Klavye kilitleri" Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
          <TextBlock Text="Caps Lock, Num Lock veya Scroll Lock tuşuna basıldığında dock üzerinde açık/kapalı olayını gösterir."
                     TextWrapping="Wrap" Opacity="0.72" />
          <ToggleSwitch Header="Kilit tuşu olaylarını göster"
                        IsOn="{Binding ShowKeyboardLockEvents, Mode=TwoWay}"
                        OnContent="Açık"
                        OffContent="Kapalı"
                        AutomationProperties.Name="Kilit tuşu olaylarını göster" />
        </StackPanel>
      </Border>

      <Border Padding="18" Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="USB cihazları" Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
          <TextBlock Text="USB bellek takıldığında veya çıkarıldığında dock üzerinde olay gösterir."
                     TextWrapping="Wrap" Opacity="0.72" />
          <ToggleSwitch Header="USB tak/çıkar olaylarını göster"
                        IsOn="{Binding ShowUsbDeviceEvents, Mode=TwoWay}"
                        OnContent="Açık"
                        OffContent="Kapalı"
                        AutomationProperties.Name="USB tak/çıkar olaylarını göster" />
        </StackPanel>
      </Border>

      <Border Padding="18" Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding HourlyNotificationSettingsTitle}"
                     Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
          <TextBlock Text="{Binding HourlyNotificationSettingsDescription}"
                     TextWrapping="Wrap"
                     Opacity="0.72" />
          <ToggleSwitch Header="{Binding HourlyNotificationSettingsToggle}"
                        MinHeight="44"
                        MinWidth="44"
                        IsOn="{Binding HourlyNotificationEnabled, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding HourlyNotificationSettingsToggle}" />
        </StackPanel>
      </Border>

      <Border Padding="18" Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="Zamanlayıcı" Style="{StaticResource SettingsSectionTitleTextBlockStyle}" />
          <TextBlock Text="Zamanlayıcı ve kronometreyi genişletilmiş dock içindeki Zaman modülünden yönetin. Fare tekeriyle varsayılan görünüm ve modüller arasında geçebilirsiniz."
                     TextWrapping="Wrap" Opacity="0.72" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
