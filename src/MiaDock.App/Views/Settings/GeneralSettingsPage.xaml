<UserControl
    x:Class="MiaDock.App.Views.Settings.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiaDock.App.Controls">

  <ScrollViewer Padding="28,24,28,48"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Spacing="5" Margin="0,0,0,8">
        <TextBlock Text="Genel"
                   Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Dock'un görünürlüğünü, etkileşimini, konumunu ve dilini yapılandırın."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Grid x:Name="GeneralGrid" ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SecondColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup>
            <VisualState x:Name="Narrow" />
            <VisualState x:Name="Wide">
              <VisualState.StateTriggers>
                <AdaptiveTrigger MinWindowWidth="760" />
              </VisualState.StateTriggers>
              <VisualState.Setters>
                <Setter Target="SecondColumn.Width" Value="*" />
                <Setter Target="InteractionCard.(Grid.Row)" Value="0" />
                <Setter Target="InteractionCard.(Grid.Column)" Value="1" />
                <Setter Target="PositionCard.(Grid.Row)" Value="1" />
                <Setter Target="LanguageCard.(Grid.Row)" Value="1" />
                <Setter Target="LanguageCard.(Grid.Column)" Value="1" />
                <Setter Target="ReturnCard.(Grid.Row)" Value="2" />
                <Setter Target="ReturnCard.(Grid.ColumnSpan)" Value="2" />
                <Setter Target="ClockCard.(Grid.Row)" Value="3" />
                <Setter Target="ClockCard.(Grid.ColumnSpan)" Value="2" />
                <Setter Target="UpdateSettingsCard.(Grid.Row)" Value="4" />
                <Setter Target="UpdateSettingsCard.(Grid.ColumnSpan)" Value="2" />
                <Setter Target="BatteryCard.(Grid.Row)" Value="5" />
                <Setter Target="BatteryCard.(Grid.ColumnSpan)" Value="2" />
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="VisibilityCard"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE7E8;"
                        Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="7">
              <TextBlock Text="Görünürlük" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding VisibilityModes}"
                        DisplayMemberPath="Label"
                        SelectedIndex="{Binding VisibilityModeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Görünürlük" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="InteractionCard"
                Grid.Row="1"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE765;"
                        Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="7">
              <TextBlock Text="Etkileşim" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding InteractionModes}"
                        DisplayMemberPath="Label"
                        SelectedIndex="{Binding InteractionModeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Etkileşim" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="PositionCard"
                Grid.Row="2"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE707;"
                        Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="7">
              <TextBlock Text="Dock konumu" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding Positions}"
                        DisplayMemberPath="Label"
                        SelectedIndex="{Binding PositionIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Dock konumu" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="LanguageCard"
                Grid.Row="3"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE774;"
                        Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="7">
              <TextBlock Text="Dil" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding Languages}"
                        DisplayMemberPath="Label"
                        SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Dil" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="ReturnCard"
                Grid.Row="4"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE121;"
                        Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Pasif modülden dönüş" FontWeight="SemiBold" />
              <TextBlock Text="Etkin işi olmayan modülün ana dock'a dönme süresi"
                         FontSize="12" Opacity="0.66" TextWrapping="Wrap" />
            </StackPanel>
            <NumberBox Grid.Column="2"
                       Minimum="3"
                       Maximum="30"
                       Value="{Binding PassiveModuleReturnSeconds, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact"
                       AutomationProperties.Name="Pasif modülden dönüş süresi" />
          </Grid>
        </Border>

        <Border x:Name="ClockCard"
                Grid.Row="5"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE823;"
                        Foreground="{ThemeResource SettingsGeneralIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="10">
              <StackPanel>
                <TextBlock Text="Saat ve tarih" FontWeight="SemiBold" />
                <TextBlock Text="Ana dock'taki zaman bilgisinin görünümünü kişiselleştirin."
                           FontSize="12" Opacity="0.66" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnSpacing="12" RowSpacing="9">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Text="Saat biçimi" FontSize="12" />
                  <ComboBox ItemsSource="{Binding ClockHourFormats}"
                            DisplayMemberPath="Label"
                            SelectedIndex="{Binding ClockHourFormatIndex, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Saat biçimi" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Saniyeler" FontSize="12" />
                  <ToggleSwitch IsOn="{Binding ShowClockSeconds, Mode=TwoWay}"
                                OnContent="Göster"
                                OffContent="Gizle"
                                AutomationProperties.Name="Saniyeleri göster" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Tarih" FontSize="12" />
                  <ToggleSwitch IsOn="{Binding ShowClockDate, Mode=TwoWay}"
                                OnContent="Göster"
                                OffContent="Gizle"
                                AutomationProperties.Name="Tarihi göster" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="4">
                  <TextBlock Text="Tarih biçimi" FontSize="12" />
                  <ComboBox ItemsSource="{Binding ClockDateFormats}"
                            DisplayMemberPath="Label"
                            SelectedIndex="{Binding ClockDateFormatIndex, Mode=TwoWay}"
                            IsEnabled="{Binding ShowClockDate}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Tarih biçimi" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                  <TextBlock Text="Haftanın günü" FontSize="12" />
                  <ToggleSwitch IsOn="{Binding ShowClockWeekday, Mode=TwoWay}"
                                IsEnabled="{Binding ShowClockDate}"
                                OnContent="Göster"
                                OffContent="Gizle"
                                AutomationProperties.Name="Haftanın gününü göster" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="UpdateSettingsCard"
                Grid.Row="6"
                Style="{StaticResource SettingsCardBorderStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsIconTileBorderStyle}">
              <FontIcon Glyph="&#xE895;"
                        Foreground="{ThemeResource SettingsNotificationIconBrush}" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Otomatik güncelleme denetimi" FontWeight="SemiBold" />
              <TextBlock Text="MiaDock, Microsoft Store'daki yeni sürümleri dört saatte bir denetler."
                         FontSize="12" Opacity="0.66" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2"
                          IsOn="{Binding AutomaticUpdateChecksEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="Otomatik güncelleme denetimi" />
          </Grid>
        </Border>

        <Border x:Name="BatteryCard"
                Grid.Row="7"
                Style="{StaticResource SettingsCardBorderStyle}">
          <controls:BatteryThresholdSettingsCard />
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
