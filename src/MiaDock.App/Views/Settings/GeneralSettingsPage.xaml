<UserControl x:Class="MiaDock.App.Views.Settings.GeneralSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MiaDock.App.Controls">
  <ScrollViewer Padding="28,20,28,40"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="14">
      <StackPanel Spacing="4" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="MiaDock Ayarları" FontSize="25" FontWeight="SemiBold" />
          <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,4" Opacity="0.55"><Run Text="v" /><Run Text="{Binding VersionText}" /></TextBlock>
        </StackPanel>
        <TextBlock Text="Ana Sayfa" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Text="Adanın temel davranışlarını hızlıca yapılandırın." Opacity="0.68" />
      </StackPanel>

      <Grid ColumnSpacing="10" RowSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Görünürlük" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding VisibilityModes}" DisplayMemberPath="Label" SelectedIndex="{Binding VisibilityModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Görünürlük" /></StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1" Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE765;" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Etkileşim" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding InteractionModes}" DisplayMemberPath="Label" SelectedIndex="{Binding InteractionModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Etkileşim" /></StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE707;" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Ada konumu" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Positions}" DisplayMemberPath="Label" SelectedIndex="{Binding PositionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Ada konumu" /></StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE850;" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"><TextBlock Text="Sistem modülleri" FontWeight="SemiBold" /><TextBlock Text="Pil, ağ, Bluetooth ve zaman araçları etkin" FontSize="12" Opacity="0.66" TextWrapping="Wrap" /></StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"><TextBlock Text="Dil" FontWeight="SemiBold" /><TextBlock Text="Arayüz dilini seçin" FontSize="12" Opacity="0.66" /></StackPanel>
            <ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" DisplayMemberPath="Label"
                      SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Dil" />
          </Grid>
        </Border>
        <Border Grid.Row="3" Grid.ColumnSpan="2" Padding="16" CornerRadius="10" Background="#272C40" BorderBrush="#32384D" BorderThickness="1">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE121;" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="Pasif modülden dönüş" FontWeight="SemiBold" />
              <TextBlock Text="Etkin işi olmayan modülün ana dock'a dönme süresi" FontSize="12" Opacity="0.66" TextWrapping="Wrap" />
            </StackPanel>
            <NumberBox Grid.Column="2"
                       Minimum="3"
                       Maximum="30"
                       Value="{Binding PassiveModuleReturnSeconds, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact"
                       AutomationProperties.Name="Pasif modülden dönüş süresi" />
          </Grid>
        </Border>
      </Grid>

      <TextBlock Text="Pil uyarıları" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <controls:BatteryThresholdSettingsCard />
    </StackPanel>
  </ScrollViewer>
</UserControl>
