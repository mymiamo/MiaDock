<UserControl x:Class="MiaDock.App.Views.Settings.FullscreenSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32,24,32,40">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="18">
      <TextBlock Text="Tam ekran" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock Text="Tam ekran uygulamalarda gösterilecek geçici modül bildirimlerini yapılandırın." TextWrapping="Wrap" Opacity="0.68" />
      <ToggleSwitch Header="Tam ekran bildirimleri" IsOn="{Binding FullscreenEnabled, Mode=TwoWay}" />
      <TextBlock Text="Bildirim görünümü" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <ComboBox ItemsSource="{Binding FullscreenStyles}" DisplayMemberPath="Label"
                SelectedIndex="{Binding FullscreenStyleIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Bildirim görünümü" />
      <TextBlock Text="Görünme süresi (saniye)" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <NumberBox Minimum="1" Maximum="30" Value="{Binding FullscreenNotificationSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                 AutomationProperties.Name="Görünme süresi" />
      <InfoBar IsOpen="True" Severity="Informational" Title="Tam ekran davranışı"
               Message="Normal dock gizlenir; kritik zamanlayıcı, pil ve izin verdiğiniz diğer modül olayları geçici olarak gösterilir. Şarkı değişimi dock'u kendiliğinden genişletmez." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
