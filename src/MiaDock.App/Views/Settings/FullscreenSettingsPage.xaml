<UserControl
    x:Class="MiaDock.App.Views.Settings.FullscreenSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="28,24,28,48"
                HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Spacing="5" Margin="0,0,0,8">
        <TextBlock Text="Tam ekran"
                   Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Tam ekran uygulamalarda gösterilecek geçici modül bildirimlerini yapılandırın."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE740;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <TextBlock Grid.Column="1"
                     Text="Tam ekran bildirimleri"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <ToggleSwitch Grid.Column="2"
                        IsOn="{Binding FullscreenEnabled, Mode=TwoWay}"
                        AutomationProperties.Name="Tam ekran bildirimleri" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE8A7;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <TextBlock Grid.Column="1"
                     Text="Bildirim görünümü"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <ComboBox Grid.Column="2"
                    ItemsSource="{Binding FullscreenStyles}"
                    DisplayMemberPath="Label"
                    SelectedIndex="{Binding FullscreenStyleIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Bildirim görünümü" />
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE823;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <TextBlock Grid.Column="1"
                     Text="Görünme süresi (saniye)"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <NumberBox Grid.Column="2"
                     Minimum="1"
                     Maximum="30"
                     Value="{Binding FullscreenNotificationSeconds, Mode=TwoWay}"
                     SpinButtonPlacementMode="Compact"
                     AutomationProperties.Name="Görünme süresi" />
        </Grid>
      </Border>

      <InfoBar IsOpen="True"
               Severity="Informational"
               Title="Tam ekran davranışı"
               Message="Normal dock gizlenir; kritik zamanlayıcı, pil ve izin verdiğiniz diğer modül olayları geçici olarak gösterilir. Şarkı değişimi dock'u kendiliğinden genişletmez." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
