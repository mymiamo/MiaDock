<UserControl
    x:Class="MiaDock.App.Views.Settings.FullscreenSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                HorizontalContentAlignment="Stretch">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
      <StackPanel Style="{StaticResource SettingsPageHeaderStackPanelStyle}">
        <TextBlock Text="Tam ekran"
                   Style="{StaticResource SettingsPageTitleTextBlockStyle}" />
        <TextBlock Text="Tam ekran uygulamalarda, film ve video oynatıcılarda dock görünürlüğünü ve geçici bildirimleri yapılandırın."
                   Style="{StaticResource SettingsPageDescriptionTextBlockStyle}" />
      </StackPanel>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE740;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="Tam ekran sırasında dock" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding FullscreenBehaviors}"
                      DisplayMemberPath="Label"
                      SelectedIndex="{Binding FullscreenBehaviorIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MaxWidth="440"
                      AutomationProperties.Name="Tam ekran dock davranışı"
                      AutomationProperties.HelpText="Dock'un tam ekran uygulama ile aynı monitörde nasıl davranacağını seçer." />
            <TextBlock Text="{Binding FullscreenEdgeRevealDescription}"
                       TextWrapping="Wrap"
                       Style="{StaticResource SettingsCardDescriptionTextBlockStyle}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE8A7;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Bildirim görünümü" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <ComboBox ItemsSource="{Binding FullscreenStyles}"
                      IsEnabled="{Binding FullscreenNotificationsAvailable}"
                      DisplayMemberPath="Label"
                      SelectedIndex="{Binding FullscreenStyleIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MaxWidth="360"
                      AutomationProperties.Name="Bildirim görünümü" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconTileBorderStyle}">
            <FontIcon Glyph="&#xE823;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Görünme süresi (saniye)" Style="{StaticResource SettingsCardTitleTextBlockStyle}" />
            <NumberBox Minimum="1"
                       Maximum="30"
                       IsEnabled="{Binding FullscreenNotificationsAvailable}"
                       Value="{Binding FullscreenNotificationSeconds, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact"
                       MaxWidth="220"
                       HorizontalAlignment="Stretch"
                       AutomationProperties.Name="Görünme süresi" />
          </StackPanel>
        </Grid>
      </Border>

      <InfoBar IsOpen="True"
               Severity="Informational"
               Title="Tam ekran davranışı"
               Message="{Binding FullscreenEdgeRevealInfo}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
