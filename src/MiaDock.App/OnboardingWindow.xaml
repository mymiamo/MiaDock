<Window
    x:Class="MiaDock.App.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MiaDock İlk Kurulum">
  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.RowSpan="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <StackPanel Padding="24,32" Spacing="20">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image Width="36" Height="36" Source="ms-appx:///Assets/AppLogo.png"
                 Stretch="Uniform" AutomationProperties.Name="MiaDock logosu" />
          <TextBlock Text="MiaDock" FontSize="28" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="İlk kurulum" Opacity="0.68" />
        <ListView x:Name="StepList" ItemsSource="{Binding Steps}" DisplayMemberPath="Title"
                  SelectedIndex="{Binding CurrentStepIndex, Mode=OneWay}"
                  IsHitTestVisible="False" IsTabStop="False"
                  AutomationProperties.Name="Kurulum adımları" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="42,36,42,28">
      <ContentControl x:Name="StepHost" />
    </ScrollViewer>

    <Border Grid.Row="1" Grid.Column="1" Padding="32,18"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding StepPositionText}" Opacity="0.68" />
          <TextBlock Text="{Binding ValidationMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button x:Name="BackButton" Grid.Column="1" Content="Geri" Click="OnBackClick"
                AutomationProperties.Name="Önceki kurulum adımı" />
        <Button x:Name="NextButton" Grid.Column="2" Content="İleri" Click="OnNextClick"
                Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Sonraki kurulum adımı" />
      </Grid>
    </Border>
  </Grid>
</Window>
