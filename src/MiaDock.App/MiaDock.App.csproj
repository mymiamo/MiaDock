<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.4.0.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType Condition="'$(BuildMsix)' != 'true'">None</WindowsPackageType>
    <EnableMsixTooling Condition="'$(BuildMsix)' == 'true'">true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild Condition="'$(BuildMsix)' == 'true'">true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled Condition="'$(BuildMsix)' == 'true'">false</AppxPackageSigningEnabled>
    <AppxBundle Condition="'$(BuildMsix)' == 'true'">Never</AppxBundle>
    <AppxSymbolPackageEnabled Condition="'$(BuildMsix)' == 'true'">false</AppxSymbolPackageEnabled>
    <UapAppxPackageBuildMode Condition="'$(BuildMsix)' == 'true'">StoreUpload</UapAppxPackageBuildMode>
    <AppxPackageDir Condition="'$(BuildMsix)' == 'true'">$(MSBuildProjectDirectory)\AppPackages\</AppxPackageDir>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>..\..\logo.ico</ApplicationIcon>
    <!-- The Strings\*.resw tables are read by LocalizedStringTables, not MRT.
         MakePri would treat dotted names such as Onboarding.Button.Finish as
         nested scopes and reject the hierarchy, so both default globs are off. -->
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
    <EnableDefaultPRIResourceItems>false</EnableDefaultPRIResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiaDock.Core\MiaDock.Core.csproj" />
    <ProjectReference Include="..\MiaDock.Modules.Media\MiaDock.Modules.Media.csproj" />
    <ProjectReference Include="..\MiaDock.Modules.SystemStatus\MiaDock.Modules.SystemStatus.csproj" />
    <ProjectReference Include="..\MiaDock.Modules.DeviceStatus\MiaDock.Modules.DeviceStatus.csproj" />
    <ProjectReference Include="..\MiaDock.Modules.Time\MiaDock.Modules.Time.csproj" />
    <ProjectReference Include="..\MiaDock.Modules.Notifications\MiaDock.Modules.Notifications.csproj" />
    <ProjectReference Include="..\MiaDock.Modules.Transfers\MiaDock.Modules.Transfers.csproj" />
    <ProjectReference Include="..\MiaDock.Platform.Windows\MiaDock.Platform.Windows.csproj" />
    <ProjectReference Include="..\MiaDock.UI\MiaDock.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dropping a Strings\<culture>\*.resw folder is all a new language needs;
         LocalizedStringTables discovers cultures from these resource names. -->
    <EmbeddedResource Include="Strings\**\*.resw" LogicalName="MiaDock.App.Strings/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\logo.ico" Link="Assets\logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" />
    <Content Include="Assets\miadock-ringtone.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\YENILIKLER.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\MiaDock.UI\Assets\Mock\*.svg" Link="Assets\Mock\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Page Include="..\MiaDock.UI\Themes\*.xaml" Link="Themes\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
