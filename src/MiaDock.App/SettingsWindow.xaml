<Window
    x:Class="MiaDock.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MiaDock Ayarları">

  <Grid x:Name="Root"
        Background="{ThemeResource SettingsWindowBackgroundBrush}"
        SizeChanged="OnRootSizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar"
          Padding="16,0,150,0"
          Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="140" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"
                  Spacing="9"
                  VerticalAlignment="Center">
        <Image Width="22"
               Height="22"
               Source="ms-appx:///Assets/AppLogo.png"
               Stretch="Uniform"
               AutomationProperties.Name="MiaDock logosu" />
        <TextBlock x:Name="TitleBarAppName"
                   Text="MiaDock"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>
      <AutoSuggestBox x:Name="SettingsSearch"
                      Grid.Column="1"
                      MinWidth="240"
                      MaxWidth="440"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      PlaceholderText="Ayarlarda ara"
                      TextMemberPath="Title"
                      QueryIcon="Find"
                      AutomationProperties.Name="Ayarlarda ara"
                      TextChanged="OnSearchTextChanged"
                      SuggestionChosen="OnSearchSuggestionChosen"
                      QuerySubmitted="OnSearchQuerySubmitted" />
    </Grid>

    <NavigationView x:Name="Navigation"
                    Grid.Row="1"
                    PaneDisplayMode="Left"
                    CompactPaneLength="60"
                    OpenPaneLength="240"
                    IsPaneOpen="True"
                    IsPaneToggleButtonVisible="True"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    Background="Transparent"
                    SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Ana sayfa"
                            Tag="home"
                            ToolTipService.ToolTip="Ana sayfa">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE80F;"
                      Foreground="{ThemeResource SettingsGeneralIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Genel"
                            Tag="general"
                            ToolTipService.ToolTip="Genel">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;"
                      Foreground="{ThemeResource SettingsGeneralIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Modüller"
                            Tag="modules"
                            ToolTipService.ToolTip="Modüller">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE74C;"
                      Foreground="{ThemeResource SettingsModulesIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Görünüm"
                            Tag="appearance"
                            ToolTipService.ToolTip="Görünüm">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE771;"
                      Foreground="{ThemeResource SettingsAppearanceIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Medya"
                            Tag="media"
                            ToolTipService.ToolTip="Medya">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8D6;"
                      Foreground="{ThemeResource SettingsMediaIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Bildirimler"
                            Tag="notifications"
                            ToolTipService.ToolTip="Bildirimler">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xEA8F;"
                      Foreground="{ThemeResource SettingsNotificationIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Zaman ve kısayollar"
                            Tag="time"
                            ToolTipService.ToolTip="Zaman ve kısayollar">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE823;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Tam ekran"
                            Tag="fullscreen"
                            ToolTipService.ToolTip="Tam ekran">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE740;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Monitör"
                            Tag="monitor"
                            ToolTipService.ToolTip="Monitör">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7F4;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Sistem tepsisi"
                            Tag="tray"
                            ToolTipService.ToolTip="Sistem tepsisi">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE712;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Başlangıç ve kapanış"
                            Tag="startup"
                            ToolTipService.ToolTip="Başlangıç ve kapanış">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7E8;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Tanılama"
                            Tag="diagnostics"
                            ToolTipService.ToolTip="Tanılama">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9D9;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Hakkında"
                            Tag="about"
                            ToolTipService.ToolTip="Hakkında">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE946;"
                      Foreground="{ThemeResource SettingsSystemIconBrush}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid Background="Transparent">
        <ContentControl x:Name="PageHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
