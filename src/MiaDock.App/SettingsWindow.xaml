<Window
    x:Class="MiaDock.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MiaDock Ayarları">

  <Grid x:Name="Root"
        Background="{ThemeResource SettingsWindowBackgroundBrush}"
        KeyboardAcceleratorPlacementMode="Hidden"
        SizeChanged="OnRootSizeChanged">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F"
                           Modifiers="Control"
                           Invoked="OnSearchKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Left"
                           Modifiers="Menu"
                           Invoked="OnBackKeyboardAcceleratorInvoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar"
          Padding="16,0,150,0"
          Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TitleBrandColumn" Width="214" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"
                  Spacing="9"
                  VerticalAlignment="Center">
        <Image Width="22"
               Height="22"
               Source="ms-appx:///Assets/AppLogo.png"
               Stretch="Uniform"
               AutomationProperties.Name="MiaDock logosu" />
        <TextBlock x:Name="TitleBarAppName"
                   Text="MiaDock"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>
      <AutoSuggestBox x:Name="SettingsSearch"
                      Grid.Column="1"
                      MinWidth="0"
                      MaxWidth="440"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      PlaceholderText="Ayarlarda ara"
                      TextMemberPath="Title"
                      QueryIcon="Find"
                      AutomationProperties.Name="Ayarlarda ara"
                      TextChanged="OnSearchTextChanged"
                      SuggestionChosen="OnSearchSuggestionChosen"
                      QuerySubmitted="OnSearchQuerySubmitted">
        <AutoSuggestBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Padding="2,5" Spacing="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PathText}"
                         FontSize="11"
                         Opacity="0.72"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Description}"
                         FontSize="11"
                         Opacity="0.62"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </AutoSuggestBox.ItemTemplate>
      </AutoSuggestBox>
    </Grid>

    <NavigationView x:Name="Navigation"
                    Grid.Row="1"
                    PaneDisplayMode="Left"
                    CompactPaneLength="60"
                    OpenPaneLength="264"
                    IsPaneOpen="True"
                    IsPaneToggleButtonVisible="True"
                    IsBackButtonVisible="Auto"
                    IsBackEnabled="False"
                    IsSettingsVisible="False"
                    Background="Transparent"
                    AutomationProperties.Name="Ayarlar gezinmesi"
                    BackRequested="OnNavigationBackRequested"
                    SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Genel Bakış" Tag="home" ToolTipService.ToolTip="Genel Bakış">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" Foreground="{ThemeResource SettingsCategoryHomeBrush}" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Kişiselleştir" Tag="personalization" ToolTipService.ToolTip="Kişiselleştir">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" Foreground="{ThemeResource SettingsCategoryPersonalizationBrush}" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Odak" Tag="focus" ToolTipService.ToolTip="Odak">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" Foreground="{ThemeResource SettingsCategoryFocusBrush}" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Modüller" Tag="modules" ToolTipService.ToolTip="Modüller">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE74C;" Foreground="{ThemeResource SettingsCategoryModulesBrush}" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Kısayollar" Tag="shortcuts" ToolTipService.ToolTip="Kısayollar">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" Foreground="{ThemeResource SettingsCategoryShortcutsBrush}" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Sistem" Tag="system" ToolTipService.ToolTip="Sistem">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" Foreground="{ThemeResource SettingsCategorySystemBrush}" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Destek" Tag="support" ToolTipService.ToolTip="Destek">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" Foreground="{ThemeResource SettingsCategorySupportBrush}" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="Yenilikler" Tag="whats-new" ToolTipService.ToolTip="Yenilikler">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" Foreground="{ThemeResource SettingsCategoryWhatsNewBrush}" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Grid Background="Transparent">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="SubpageNavigation"
              Padding="28,18,28,4"
              Visibility="Collapsed">
          <Grid x:Name="SubpageTabs"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Alt ayar sayfaları">
            <StackPanel x:Name="SubpageTabPanel" Orientation="Horizontal" />
          </Grid>

          <ComboBox x:Name="SubpagePicker"
                    ItemsSource="{x:Bind CurrentSubpages, Mode=OneTime}"
                    DisplayMemberPath="Title"
                    SelectedIndex="0"
                    MinHeight="44"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed"
                    SelectionChanged="OnSubpagePickerSelectionChanged"
                    AutomationProperties.Name="Alt ayar sayfası" />
        </Grid>

        <ContentControl x:Name="PageHost"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <TextBlock x:Name="NavigationAnnouncement"
                   Grid.RowSpan="2"
                   Width="1"
                   Height="1"
                   Opacity="0"
                   IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Assertive" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
