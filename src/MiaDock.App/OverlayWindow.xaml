<Window
    x:Class="MiaDock.App.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:MiaDock.App.Controls"
    Title="MiaDock">

  <Grid x:Name="Root" Background="Transparent">
    <ui:IslandShell x:Name="Island"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ModuleDisplay="{Binding Island.ActiveModuleDisplay}"
                    AvailableModules="{Binding Island.AvailableModules}"
                    Theme="{Binding ThemeName}"
                    PointerEntered="OnIslandPointerEntered"
                    PointerExited="OnIslandPointerExited"
                    PointerMoved="OnIslandPointerMoved"
                    PointerPressed="OnIslandPointerPressed"
                    PointerReleased="OnIslandPointerReleased"
                    PointerCanceled="OnIslandPointerCanceled"
                    PointerCaptureLost="OnIslandPointerCaptureLost"
                    PointerWheelChanged="OnIslandPointerWheelChanged"
                    RightTapped="OnIslandRightTapped"
                    Tapped="OnIslandTapped"
                    KeyDown="OnIslandKeyDown"
                    PreviousModuleRequested="OnPreviousModuleRequested"
                    NextModuleRequested="OnNextModuleRequested"
                    DefaultModuleRequested="OnDefaultModuleRequested"
                    ModuleSelected="OnModuleSelected"
                    ModuleViewLoadFailed="OnModuleViewLoadFailed" />
  </Grid>
</Window>
