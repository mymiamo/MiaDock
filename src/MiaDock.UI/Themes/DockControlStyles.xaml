<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="DockSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource IslandStyleSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DockSurfaceStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="23" />
  </Style>

  <Style x:Key="DockSectionStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource DockSectionBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DockSurfaceStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style x:Key="DockModuleHeaderStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="DockStatusBadgeStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Background" Value="{ThemeResource DockStatusNeutralFillBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="DockDividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource DockDividerBrush}" />
  </Style>

  <Style x:Key="DockIconButtonStyle"
         TargetType="Button"
         BasedOn="{StaticResource IslandIconButtonStyle}">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="{ThemeResource IslandIconButtonCornerRadius}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <Style x:Key="DockInlineButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <Style x:Key="DockSegmentToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <Style x:Key="DockCompactModuleLayoutStyle" TargetType="Grid">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="ColumnSpacing" Value="10" />
  </Style>

  <Style x:Key="DockExpandedModuleLayoutStyle" TargetType="Grid">
    <Setter Property="Padding" Value="16,6,16,8" />
    <Setter Property="RowSpacing" Value="8" />
  </Style>

  <Style x:Key="DockNotificationLayoutStyle" TargetType="Grid">
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="ColumnSpacing" Value="12" />
  </Style>

  <Style x:Key="DockModuleIconStyle" TargetType="FontIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{ThemeResource IslandStyleAccentBrush}" />
  </Style>

  <Style x:Key="DockModuleIconContainerStyle" TargetType="Border">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{ThemeResource DockStatusNeutralFillBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="DockNotificationIconContainerStyle"
         TargetType="Border"
         BasedOn="{StaticResource DockModuleIconContainerStyle}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style x:Key="DockProgressBarStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{ThemeResource IslandStyleAccentBrush}" />
  </Style>

  <Style x:Key="DockDisplayTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource IslandTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DockMetricTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource IslandTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DockTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource IslandTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DockBodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource IslandTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DockCaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Small" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource IslandTextSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="DockModuleHeaderTextStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource DockTitleTextStyle}">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="DockStatusTextStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource DockCaptionTextStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</ResourceDictionary>
