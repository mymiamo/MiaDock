<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="SettingsWindowBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="SettingsGeneralIconBrush" Color="#FF78B9FF" />
      <SolidColorBrush x:Key="SettingsFocusIconBrush" Color="#FF67D7C4" />
      <SolidColorBrush x:Key="SettingsModulesIconBrush" Color="#FFB69CFF" />
      <SolidColorBrush x:Key="SettingsAppearanceIconBrush" Color="#FFFF9CB5" />
      <SolidColorBrush x:Key="SettingsMediaIconBrush" Color="#FF77D9AD" />
      <SolidColorBrush x:Key="SettingsNotificationIconBrush" Color="#FFFFC46B" />
      <SolidColorBrush x:Key="SettingsSystemIconBrush" Color="#FF8FA8FF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SettingsWindowBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="SettingsGeneralIconBrush" Color="#FF0067C0" />
      <SolidColorBrush x:Key="SettingsFocusIconBrush" Color="#FF007D6C" />
      <SolidColorBrush x:Key="SettingsModulesIconBrush" Color="#FF744DA9" />
      <SolidColorBrush x:Key="SettingsAppearanceIconBrush" Color="#FFC42B5A" />
      <SolidColorBrush x:Key="SettingsMediaIconBrush" Color="#FF087A4E" />
      <SolidColorBrush x:Key="SettingsNotificationIconBrush" Color="#FF9A5D00" />
      <SolidColorBrush x:Key="SettingsSystemIconBrush" Color="#FF4059B5" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="SettingsWindowBackgroundBrush"
                       Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SettingsGeneralIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsFocusIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsModulesIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsAppearanceIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsMediaIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsNotificationIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsSystemIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background"
            Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush"
            Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="SettingsIconTileBorderStyle" TargetType="Border">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background"
            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="SettingsPageRootStackPanelStyle" TargetType="StackPanel">
    <Setter Property="MaxWidth" Value="920" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Spacing" Value="16" />
  </Style>

  <Style x:Key="SettingsPageTitleTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SettingsPageDescriptionTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SettingsSectionTitleTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SubtitleTextBlockStyle}">
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</ResourceDictionary>
