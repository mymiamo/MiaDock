<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="SettingsWindowBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="SettingsWindowFallbackBackgroundBrush" Color="#FF202020" />
      <SolidColorBrush x:Key="SettingsGeneralIconBrush" Color="#FF78B9FF" />
      <SolidColorBrush x:Key="SettingsFocusIconBrush" Color="#FF67D7C4" />
      <SolidColorBrush x:Key="SettingsModulesIconBrush" Color="#FFB69CFF" />
      <SolidColorBrush x:Key="SettingsAppearanceIconBrush" Color="#FFFF9CB5" />
      <SolidColorBrush x:Key="SettingsMediaIconBrush" Color="#FF77D9AD" />
      <SolidColorBrush x:Key="SettingsNotificationIconBrush" Color="#FFFFC46B" />
      <SolidColorBrush x:Key="SettingsSystemIconBrush" Color="#FF8FA8FF" />
      <SolidColorBrush x:Key="SettingsCategoryHomeBrush" Color="#FF68A9FF" />
      <SolidColorBrush x:Key="SettingsCategoryPersonalizationBrush" Color="#FFFF8EB1" />
      <SolidColorBrush x:Key="SettingsCategoryFocusBrush" Color="#FF59D3BE" />
      <SolidColorBrush x:Key="SettingsCategoryModulesBrush" Color="#FFFFBE55" />
      <SolidColorBrush x:Key="SettingsCategoryShortcutsBrush" Color="#FF7ED0FF" />
      <SolidColorBrush x:Key="SettingsCategorySystemBrush" Color="#FF9A9CFF" />
      <SolidColorBrush x:Key="SettingsCategorySupportBrush" Color="#FF9EABB8" />
      <SolidColorBrush x:Key="SettingsCategoryWhatsNewBrush" Color="#FFB69CFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SettingsWindowBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="SettingsWindowFallbackBackgroundBrush" Color="#FFF3F3F3" />
      <SolidColorBrush x:Key="SettingsGeneralIconBrush" Color="#FF0067C0" />
      <SolidColorBrush x:Key="SettingsFocusIconBrush" Color="#FF007D6C" />
      <SolidColorBrush x:Key="SettingsModulesIconBrush" Color="#FF744DA9" />
      <SolidColorBrush x:Key="SettingsAppearanceIconBrush" Color="#FFC42B5A" />
      <SolidColorBrush x:Key="SettingsMediaIconBrush" Color="#FF087A4E" />
      <SolidColorBrush x:Key="SettingsNotificationIconBrush" Color="#FF9A5D00" />
      <SolidColorBrush x:Key="SettingsSystemIconBrush" Color="#FF4059B5" />
      <SolidColorBrush x:Key="SettingsCategoryHomeBrush" Color="#FF0067C0" />
      <SolidColorBrush x:Key="SettingsCategoryPersonalizationBrush" Color="#FFB51D59" />
      <SolidColorBrush x:Key="SettingsCategoryFocusBrush" Color="#FF007D6C" />
      <SolidColorBrush x:Key="SettingsCategoryModulesBrush" Color="#FF9A5D00" />
      <SolidColorBrush x:Key="SettingsCategoryShortcutsBrush" Color="#FF0067C0" />
      <SolidColorBrush x:Key="SettingsCategorySystemBrush" Color="#FF4F4CB8" />
      <SolidColorBrush x:Key="SettingsCategorySupportBrush" Color="#FF53606D" />
      <SolidColorBrush x:Key="SettingsCategoryWhatsNewBrush" Color="#FF744DA9" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="SettingsWindowBackgroundBrush"
                       Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SettingsWindowFallbackBackgroundBrush"
                       Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SettingsGeneralIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsFocusIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsModulesIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsAppearanceIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsMediaIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsNotificationIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsSystemIconBrush"
                       Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsCategoryHomeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsCategoryPersonalizationBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsCategoryFocusBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsCategoryModulesBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsCategoryShortcutsBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsCategorySystemBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsCategorySupportBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SettingsCategoryWhatsNewBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="SettingsOledWindowBackgroundBrush" Color="#FF000000" />

  <Thickness x:Key="SettingsPagePadding">28,20,28,48</Thickness>
  <Thickness x:Key="SettingsPagePaddingNarrow">16,16,16,32</Thickness>
  <Thickness x:Key="SettingsSectionTopMargin">0,8,0,0</Thickness>
  <CornerRadius x:Key="SettingsCardCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="SettingsIconTileCornerRadius">8</CornerRadius>
  <Style x:Key="SettingsPageScrollViewerStyle" TargetType="ScrollViewer">
    <Setter Property="Padding" Value="{StaticResource SettingsPagePadding}" />
    <Setter Property="HorizontalScrollMode" Value="Disabled" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
    <Setter Property="Padding" Value="18" />
    <Setter Property="CornerRadius" Value="{StaticResource SettingsCardCornerRadius}" />
    <Setter Property="Background"
            Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush"
            Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="SettingsIconTileBorderStyle" TargetType="Border">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="{StaticResource SettingsIconTileCornerRadius}" />
    <Setter Property="Background"
            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="SettingsRowBorderStyle" TargetType="Border">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style x:Key="SettingsControlMinTouchStyle" TargetType="Control">
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <Style x:Key="SettingsSubpageTabToggleStyle" TargetType="ToggleButton">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <Style x:Key="SettingsLinkCardButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="16" />
    <Setter Property="MinHeight" Value="76" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource SettingsCardCornerRadius}" />
    <Setter Property="Background"
            Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush"
            Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
  </Style>

  <Style x:Key="SettingsPageRootStackPanelStyle" TargetType="StackPanel">
    <Setter Property="MaxWidth" Value="980" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Spacing" Value="16" />
  </Style>

  <Style x:Key="SettingsPageTitleTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
  </Style>

  <Style x:Key="SettingsPageDescriptionTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SettingsSectionTitleTextBlockStyle"
         TargetType="TextBlock"
         BasedOn="{StaticResource SubtitleTextBlockStyle}">
    <Setter Property="Margin" Value="{StaticResource SettingsSectionTopMargin}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
  </Style>

  <Style x:Key="SettingsPageHeaderStackPanelStyle" TargetType="StackPanel">
    <Setter Property="Spacing" Value="5" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="SettingsCardTitleTextBlockStyle" TargetType="TextBlock"
         BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SettingsCardDescriptionTextBlockStyle" TargetType="TextBlock"
         BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Opacity" Value="0.68" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SettingsStatusBadgeBorderStyle" TargetType="Border">
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="SettingsStatusBadgeTextStyle" TargetType="TextBlock"
         BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MaxLines" Value="1" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
</ResourceDictionary>
